		<Field Name="F0529">
			<Title>ALGORITHM CODE LIST IDENTIFIER</Title>
			<Description>Specification of the code list used to identify the algorithm.</Description>
			<Values>
				<Value Code="1">
					<Title>UN/CEFACT</Title>
					<Description>United Nations Centre for Trade Facilitation and Electronic Business (UN/CEFACT).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0531">
			<Title>ALGORITHM PARAMETER QUALIFIER</Title>
			<Description>Specification of the type of parameter value.</Description>
			<Values>
				<Value Code="1">
					<Title>Initialisation value, clear text</Title>
					<Description>Identifies the algorithm parameter value as an unencrypted initialisation value.</Description>
				</Value>
				<Value Code="2">
					<Title>Initialisation value, encrypted under a symmetric key</Title>
					<Description>Identifies the algorithm parameter value as an initialisation value which is encrypted under the symmetric data key.</Description>
				</Value>
				<Value Code="3">
					<Title>Initialisation value, encrypted under a public key</Title>
					<Description>Identifies the algorithm parameter value as an initialisation value encrypted under the public key of the� receiving party.</Description>
				</Value>
				<Value Code="4">
					<Title>Initialisation value, format mutually agreed</Title>
					<Description>Identifies the algorithm parameter value as an initialisation value in a format agreed between the two parties.</Description>
				</Value>
				<Value Code="5">
					<Title>Symmetric key, encrypted under a symmetric key</Title>
					<Description>Identifies the algorithm parameter value as a symmetric key which is encrypted with a previously agreed algorithm under a previously exchanged symmetric key.</Description>
				</Value>
				<Value Code="6">
					<Title>Symmetric key, encrypted under a public key</Title>
					<Description>Identifies the algorithm parameter value as a symmetric key encrypted under the public key of the� receiving party.</Description>
				</Value>
				<Value Code="7">
					<Title>Symmetric key, signed and encrypted</Title>
					<Description>Identifies the algorithm parameter value as a symmetric key signed under the sender's secret key, then encrypted under the receiver's public key.</Description>
				</Value>
				<Value Code="8">
					<Title>Symmetric key encrypted under an asymmetric key common to the sender and the receiver</Title>
					<Description>Identifies the algorithm parameter value as a symmetric key encrypted under an asymmetric key common to the sender and the receiver (use of Diffie and Hellman scheme, for instance).</Description>
				</Value>
				<Value Code="9">
					<Title>Symmetric key name</Title>
					<Description>Identifies the algorithm parameter value as the name of a symmetric key. This may be used in the case where a key relationship has already been established between the sender and receiver.</Description>
				</Value>
				<Value Code="10">
					<Title>Key encrypting key name</Title>
					<Description>Identifies the parameter value as the name of a key encrypting key.</Description>
				</Value>
				<Value Code="11">
					<Title>Symmetric key, format mutually agreed</Title>
					<Description>Identifies the algorithm parameter value as a symmetric key in a format agreed between the two parties.</Description>
				</Value>
				<Value Code="12">
					<Title>Modulus</Title>
					<Description>Identifies the algorithm parameter value as the modulus of a public key which is to be used according to the function defined by the use of algorithm.</Description>
				</Value>
				<Value Code="13">
					<Title>Exponent</Title>
					<Description>Identifies the algorithm parameter value as the exponent of a public key which is to be used according to the function defined by the use of algorithm.</Description>
				</Value>
				<Value Code="14">
					<Title>Modulus length</Title>
					<Description>Identifies the algorithm parameter value as the length of the modulus (in bits) of the public key used in the algorithm. The length is independent of whatever filtering function may be in use.</Description>
				</Value>
				<Value Code="15">
					<Title>Generic parameter 1</Title>
					<Description>Identifies the algorithm parameter value as the first generic parameter.</Description>
				</Value>
				<Value Code="16">
					<Title>Generic parameter 2</Title>
					<Description>Identifies the algorithm parameter value as the second generic parameter.</Description>
				</Value>
				<Value Code="17">
					<Title>Generic parameter 3</Title>
					<Description>Identifies the algorithm parameter value as the third generic parameter.</Description>
				</Value>
				<Value Code="18">
					<Title>Generic parameter 4</Title>
					<Description>Identifies the algorithm parameter value as the fourth generic parameter.</Description>
				</Value>
				<Value Code="19">
					<Title>Generic parameter 5</Title>
					<Description>Identifies the algorithm parameter value as the fifth generic parameter.</Description>
				</Value>
				<Value Code="20">
					<Title>Generic parameter 6</Title>
					<Description>Identifies the algorithm parameter value as the sixth generic parameter.</Description>
				</Value>
				<Value Code="21">
					<Title>Generic parameter 7</Title>
					<Description>Identifies the algorithm parameter value as the seventh generic parameter.</Description>
				</Value>
				<Value Code="22">
					<Title>Generic parameter 8</Title>
					<Description>Identifies the algorithm parameter value as the eighth generic parameter.</Description>
				</Value>
				<Value Code="23">
					<Title>Generic parameter 9</Title>
					<Description>Identifies the algorithm parameter value as the ninth generic parameter.</Description>
				</Value>
				<Value Code="24">
					<Title>Generic parameter 10</Title>
					<Description>Identifies the algorithm parameter value as the tenth generic parameter.</Description>
				</Value>
				<Value Code="25">
					<Title>DSA parameter P</Title>
					<Description>Identifies the algorithm parameter value as the parameter P of DSA algorithm.</Description>
				</Value>
				<Value Code="26">
					<Title>DSA parameter Q</Title>
					<Description>Identifies the algorithm parameter value as the parameter Q of DSA algorithm.</Description>
				</Value>
				<Value Code="27">
					<Title>DSA parameter G</Title>
					<Description>Identifies the algorithm parameter value as the parameter G of DSA algorithm.</Description>
				</Value>
				<Value Code="28">
					<Title>DSA parameter Y</Title>
					<Description>Identifies the algorithm parameter value as the parameter Y of DSA algorithm.</Description>
				</Value>
				<Value Code="29">
					<Title>Initial value for CRC calculation</Title>
					<Description>Identifies the algorithm parameter value as the initial value for the CRC calculation.</Description>
				</Value>
				<Value Code="30">
					<Title>Initial directory tree</Title>
					<Description>Identifies the algorithm parameter value as the initial directory tree for the data compression algorithm specified.</Description>
				</Value>
				<Value Code="31">
					<Title>Integrity value offset</Title>
					<Description>Identifies the algorithm parameter value as the offset within the compressed text where the integrity value is located.</Description>
				</Value>
				<Value Code="33">
					<Title>Generator</Title>
					<Description>Identifies the algorithm parameter value as the generator for a secret key agreement mechanism.</Description>
				</Value>
				<Value Code="34">
					<Title>Symmetric key activation date/time</Title>
					<Description>Identifies the activation date/time of a symmetric key. The date/time format shall be CCYYMMDDHHMMSS.</Description>
				</Value>
				<Value Code="35">
					<Title>PKCS#1-EME-OAEP HF</Title>
					<Description>Identifies the algorithm parameter value as the code of the hash function used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="36">
					<Title>PKCS#1-EME-OAEP MGF</Title>
					<Description>Identifies the algorithm parameter value as the code of the mask generation function used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="37">
					<Title>PKCS#1-EME-OAEP P Init</Title>
					<Description>Identifies the algorithm parameter value as the initial octets of the encoding parameter octet string (P) used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="38">
					<Title>PKCS#1-EME-OAEP P Cont</Title>
					<Description>Identifies the algorithm parameter value as the additional octets of the encoding parameter octet string (P) following the initial octets, used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="39">
					<Title>PKCS#1-EME-OAEP P Final</Title>
					<Description>Identifies the algorithm parameter value as the final octets of the encoding parameter octet string (P) following the initial or additional octets, used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="40">
					<Title>PKCS#1-EME-OAEP HF/MGF</Title>
					<Description>Identifies the algorithm parameter value as the code of the hash function used by the mask generation function used by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="41">
					<Title>PKCS#1-EME-OAEP LENGTH</Title>
					<Description>Identifies the algorithm parameter value as the intended length of the result produced by EME-OAEP padding mechanism as defined in PKCS#1, Version 2.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0533">
			<Title>MODE OF OPERATION CODE LIST IDENTIFIER</Title>
			<Description>Specification of the code list used to identify the cryptographic mode of operation.</Description>
			<Values>
				<Value Code="1">
					<Title>UN/CEFACT</Title>
					<Description>United Nations Centre for Trade Facilitation and Electronic Business (UN/CEFACT).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0541">
			<Title>SCOPE OF SECURITY APPLICATION, CODED</Title>
			<Description>Specification of the scope of application of the security service defined in the security header.</Description>
			<Values>
				<Value Code="1">
					<Title>Security header and message body</Title>
					<Description>The current security header segment group and the object body itself, only. In this case no other security header or security trailer segment group shall be encompassed within this scope.</Description>
				</Value>
				<Value Code="2">
					<Title>From security header to security trailer</Title>
					<Description>From the current security header segment group, to the associated security trailer segment group. In this case the current security header segment group, the object body and all the other embedded security header and trailer segment groups shall be encompassed within this scope.</Description>
				</Value>
				<Value Code="3">
					<Title>Whole related message, package, group or interchange</Title>
					<Description>From the first character of the message, group, or interchange to the last character of the message, group or interchange.</Description>
				</Value>
				<Value Code="4">
					<Title>Interactive security information, security header and message body</Title>
					<Description>Related security information, related interactive security header and interactive message body.</Description>
				</Value>
				<Value Code="5">
					<Title>Interactive security information plus security header to security trailer</Title>
					<Description>Related security information, security header, all other embedded interactive security headers, interactive message body and all other embedded interactive security trailers.</Description>
				</Value>
				<Value Code="6">
					<Title>Entire batch message</Title>
					<Description>From and including, the first character ("U") of the message header segment (UNH) through to and including, the last character (segment� terminator) of the corresponding message trailer segment (UNT).</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>The scope of security application is defined in an agreement between sender and receiver.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0543">
			<Title>CERTIFICATE ORIGINAL CHARACTER SET REPERTOIRE, CODED</Title>
			<Description>Identification of the character set repertoire used to create the certificate it was signed.</Description>
			<Values>
				<Value Code="1">
					<Title>UN/ECE level A</Title>
					<Description>As defined in the basic code table of ISO/IEC 646 with the exceptions of lower case letters, alternative graphic character allocations and national or application-oriented graphic character allocations.</Description>
				</Value>
				<Value Code="2">
					<Title>UN/ECE level B</Title>
					<Description>As defined in the basic code table of ISO/IEC 646 with the exceptions of alternative graphic character allocations and national or application-oriented graphic character allocations.</Description>
				</Value>
				<Value Code="3">
					<Title>UN/ECE level C</Title>
					<Description>As defined in ISO/IEC 8859-1 (Latin alphabet No. 1)</Description>
				</Value>
				<Value Code="4">
					<Title>UN/ECE level D</Title>
					<Description>As defined in ISO/IEC 8859-2 (Latin alphabet No. 2)</Description>
				</Value>
				<Value Code="5">
					<Title>UN/ECE level E</Title>
					<Description>As defined in ISO/IEC 8859-5 (Latin/Cyrillic alphabet)</Description>
				</Value>
				<Value Code="6">
					<Title>UN/ECE level F</Title>
					<Description>As defined in ISO/IEC 8859-7 (Latin/Greek alphabet)</Description>
				</Value>
				<Value Code="7">
					<Title>UN/ECE level G</Title>
					<Description>As defined in ISO/IEC 8859-3 (Latin alphabet No. 3)</Description>
				</Value>
				<Value Code="8">
					<Title>UN/ECE level H</Title>
					<Description>As defined in ISO/IEC 8859-4 (Latin alphabet No. 4)</Description>
				</Value>
				<Value Code="9">
					<Title>UN/ECE level I</Title>
					<Description>As defined in ISO/IEC 8859-6 (Latin/Arabic alphabet)</Description>
				</Value>
				<Value Code="10">
					<Title>UN/ECE level J</Title>
					<Description>As defined in ISO/IEC 8859-8 (Latin/Hebrew alphabet)</Description>
				</Value>
				<Value Code="11">
					<Title>UN/ECE level K</Title>
					<Description>As defined in ISO/IEC 8859-9 (Latin alphabet No. 5)</Description>
				</Value>
				<Value Code="12">
					<Title>UN/ECE level X</Title>
					<Description>Code extension technique as defined by ISO/IEC 2022 utilizing the escape techniques in accordance with ISO/IEC 2375.</Description>
				</Value>
				<Value Code="13">
					<Title>UN/ECE level Y</Title>
					<Description>ISO/IEC 10646 octet without code extension technique.</Description>
				</Value>
				<Value Code="14">
					<Title>UN/ECE level W</Title>
					<Description>ISO/IEC 10646 octet with code extension technique to support UTF-8 (UCS Transformation Format, 8 bit) encoding.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0545">
			<Title>CERTIFICATE SYNTAX AND VERSION, CODED</Title>
			<Description>Coded identification of the syntax and version used to create the certificate.</Description>
			<Values>
				<Value Code="1">
					<Title>EDIFACT version 4</Title>
					<Description>ISO 9735 version 4.</Description>
				</Value>
				<Value Code="2">
					<Title>EDIFACT version 3</Title>
					<Description>ISO 9735 version 3.</Description>
				</Value>
				<Value Code="3">
					<Title>X.509</Title>
					<Description>ISO/IEC 9594-8, ITU X.509 key/certificate reference.</Description>
				</Value>
				<Value Code="4">
					<Title>PGP</Title>
					<Description>PGP (Pretty Good Privacy) based format key/certificate reference.</Description>
				</Value>
				<Value Code="5">
					<Title>EDI 5 v1.4</Title>
					<Description>Version 1.4 of the EDI 5 certificate (French national standard).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0551">
			<Title>SERVICE CHARACTER FOR SIGNATURE QUALIFIER</Title>
			<Description>Identification of the type of service character used when the signature was computed.</Description>
			<Values>
				<Value Code="1">
					<Title>Segment terminator</Title>
					<Description>Specifies that this is the separator at the end of segments.</Description>
				</Value>
				<Value Code="2">
					<Title>Component data element separator</Title>
					<Description>Specifies that this is the separator between component data elements.</Description>
				</Value>
				<Value Code="3">
					<Title>Data element separator</Title>
					<Description>Specifies that this is the separator between data elements.</Description>
				</Value>
				<Value Code="4">
					<Title>Release character</Title>
					<Description>Specifies that this is the release character.</Description>
				</Value>
				<Value Code="5">
					<Title>Repetition separator</Title>
					<Description>Specifies that this is the separator between repeating data elements.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0563">
			<Title>VALIDATION VALUE, QUALIFIER</Title>
			<Description>Identification of the type of validation value.</Description>
			<Values>
				<Value Code="1">
					<Title>Unique validation value</Title>
					<Description>Specifies that this is the unique validation value. This code shall be used when the algorithm involved produces a single parameter result (one MAC with DES algorithm, or one digital signature with RSA algorithm, for instance).</Description>
				</Value>
				<Value Code="2">
					<Title>DSA algorithm r parameter</Title>
					<Description>Specifies that this is the r parameter, resulting of the use of DSA algorithm.</Description>
				</Value>
				<Value Code="3">
					<Title>DSA algorithm s parameter</Title>
					<Description>Specifies that this is the s parameter, resulting of the use of DSA algorithm.</Description>
				</Value>
				<Value Code="4">
					<Title>Random number for party A</Title>
					<Description>A random number generated by party A in a key agreement or entity authentication protocol.</Description>
				</Value>
				<Value Code="5">
					<Title>Random number for party B</Title>
					<Description>A random number generated by party B in a key agreement or entity authentication protocol.</Description>
				</Value>
				<Value Code="6">
					<Title>Enciphered block under a symmetric algorithm</Title>
					<Description>The result of the encipherment of data under a symmetric algorithm in an entity authentication protocol.</Description>
				</Value>
				<Value Code="7">
					<Title>Enciphered block under an asymmetric algorithm</Title>
					<Description>The result of the encipherment of data under an asymmetric algorithm in an entity authentication protocol.</Description>
				</Value>
				<Value Code="8">
					<Title>Key agreement value</Title>
					<Description>The value calculated in a key agreement protocol.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0565">
			<Title>MESSAGE RELATION, CODED</Title>
			<Description>Relationship with another message, past or future.</Description>
			<Values>
				<Value Code="1">
					<Title>No relation</Title>
					<Description>The message is initial.</Description>
				</Value>
				<Value Code="2">
					<Title>Response</Title>
					<Description>The message is a response message.</Description>
				</Value>
				<Value Code="3">
					<Title>Response requested</Title>
					<Description>The message requests an answer.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0567">
			<Title>SECURITY STATUS, CODED</Title>
			<Description>Identification of the security element (key or certificate, for instance) status.</Description>
			<Values>
				<Value Code="1">
					<Title>Valid</Title>
					<Description>The security element is valid.</Description>
				</Value>
				<Value Code="2">
					<Title>Revoked</Title>
					<Description>The security element has been revoked.</Description>
				</Value>
				<Value Code="3">
					<Title>Unknown</Title>
					<Description>The status of the security element is unknown.</Description>
				</Value>
				<Value Code="4">
					<Title>Discontinued</Title>
					<Description>The security element should not be used for ?????</Description>
				</Value>
				<Value Code="5">
					<Title>Alert</Title>
					<Description>The security element has been put on alert, but is not revoked yet.</Description>
				</Value>
				<Value Code="6">
					<Title>Expired</Title>
					<Description>The validity period of the security element is expired.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0569">
			<Title>REVOCATION REASON, CODED</Title>
			<Description>Identification of the reason why the certificate has been revoked.</Description>
			<Values>
				<Value Code="1">
					<Title>Owner key compromised</Title>
					<Description>The owner key linked to this certificate has been compromised.</Description>
				</Value>
				<Value Code="2">
					<Title>Issuer key compromised</Title>
					<Description>The issuer key used to generate this certificate has been compromised.</Description>
				</Value>
				<Value Code="3">
					<Title>Owner changed affiliation</Title>
					<Description>The identification details of the certificate are no longer valid.</Description>
				</Value>
				<Value Code="4">
					<Title>Certificate superseded</Title>
					<Description>This certificate has been renewed and is superseded by another certificate.</Description>
				</Value>
				<Value Code="5">
					<Title>Certificate terminated</Title>
					<Description>This certificate has reached the end of its validity period and has not been renewed.</Description>
				</Value>
				<Value Code="6">
					<Title>No information available</Title>
					<Description>This certificate is revoked but the reason is not explicit stated.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0571">
			<Title>SECURITY ERROR, CODED</Title>
			<Description>Identifies the security error causing the rejection of the EDIFACT structure.</Description>
			<Values>
				<Value Code="1">
					<Title>Wrong authenticator</Title>
					<Description>The validation is wrong.</Description>
				</Value>
				<Value Code="2">
					<Title>Wrong certificate</Title>
					<Description>The certificate is wrong.</Description>
				</Value>
				<Value Code="3">
					<Title>Certification path</Title>
					<Description>The certification path is incomplete. Cannot verify.</Description>
				</Value>
				<Value Code="4">
					<Title>Algorithm not supported</Title>
					<Description>The algorithm is not supported.</Description>
				</Value>
				<Value Code="5">
					<Title>Hashing method not supported</Title>
					<Description>The hashing method is not supported.</Description>
				</Value>
				<Value Code="6">
					<Title>Protocol error</Title>
					<Description>The stated protocol has not been followed.</Description>
				</Value>
				<Value Code="7">
					<Title>Security expected but not present</Title>
					<Description>It was expected the user message would be secured (e.g. using integrated message security or the AUTACK message in authentication mode), but this was not present or received in the expected time period.</Description>
				</Value>
				<Value Code="8">
					<Title>Security parameters do not match those expected</Title>
					<Description>The parameters specifying the applied security do not match those expected (e.g. from an interchange agreement).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0575">
			<Title>LIST PARAMETER QUALIFIER</Title>
			<Description>Specification of the type of list parameter.</Description>
			<Values>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Mutually defined between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0577">
			<Title>SECURITY PARTY QUALIFIER</Title>
			<Description>Identification of the role of the security party.</Description>
			<Values>
				<Value Code="1">
					<Title>Message sender</Title>
					<Description>Identifies the party which generates the security parameters of the message (i.e. security originator).</Description>
				</Value>
				<Value Code="2">
					<Title>Message receiver</Title>
					<Description>Identifies the party which verifies the security parameters of the message (i.e. security recipient).</Description>
				</Value>
				<Value Code="3">
					<Title>Certificate owner</Title>
					<Description>Identifies the party which owns the certificate.</Description>
				</Value>
				<Value Code="4">
					<Title>Authenticating party</Title>
					<Description>Party which certifies that the document (i.e. the certificate) is authentic.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0579">
			<Title>KEY MANAGEMENT FUNCTION QUALIFIER</Title>
			<Description>Specification of the type of key management function.</Description>
			<Values>
				<Value Code="101">
					<Title>Registration submission</Title>
					<Description>Submission of information for registration.</Description>
				</Value>
				<Value Code="102">
					<Title>Asymmetric key pair request</Title>
					<Description>Request a trusted party to generate an asymmetric key pair.</Description>
				</Value>
				<Value Code="110">
					<Title>Certification request</Title>
					<Description>Request certification of credentials and public key.</Description>
				</Value>
				<Value Code="111">
					<Title>Certificate renewal request</Title>
					<Description>Request to extend the validity period of the current valid key, whose certificate is about to expire.</Description>
				</Value>
				<Value Code="112">
					<Title>Certificate replacement request</Title>
					<Description>Request to replace the current certificate by a new one with a different public key (and possibly other information).</Description>
				</Value>
				<Value Code="121">
					<Title>Certificate (path) retrieval request</Title>
					<Description>Request the delivery of an existing (valid or revoked) certificate, with path details where appropriate.</Description>
				</Value>
				<Value Code="123">
					<Title>Certificate list retrieval request</Title>
					<Description>Request full or partial list of certificate.</Description>
				</Value>
				<Value Code="124">
					<Title>Certificate status request</Title>
					<Description>Request current status of a given certificate.</Description>
				</Value>
				<Value Code="125">
					<Title>Certificate validation request</Title>
					<Description>Request the CA to validate an existing certificate.</Description>
				</Value>
				<Value Code="126">
					<Title>Certificate delivery request</Title>
					<Description>Request the CA to deliver a (valid or revoked) certificate to a list of recipients known to the CA or specified elsewhere.</Description>
				</Value>
				<Value Code="130">
					<Title>Revocation request</Title>
					<Description>Request revocation of a party's certificate.</Description>
				</Value>
				<Value Code="131">
					<Title>Alert request</Title>
					<Description>Request to put a party's certificate on alert.</Description>
				</Value>
				<Value Code="140">
					<Title>Revocation list request</Title>
					<Description>Request full or partial list of revoked certificates.</Description>
				</Value>
				<Value Code="150">
					<Title>Symmetric key request</Title>
					<Description>Request the delivery of symmetric keys.</Description>
				</Value>
				<Value Code="151">
					<Title>Symmetric key discontinuation request</Title>
					<Description>Request discontinuation of symmetric key.</Description>
				</Value>
				<Value Code="152">
					<Title>Asymmetric key discontinuation request</Title>
					<Description>Request discontinuation of asymmetric key.</Description>
				</Value>
				<Value Code="221">
					<Title>Certificate delivery</Title>
					<Description>Delivery of an existing (valid or revoked) certificate.</Description>
				</Value>
				<Value Code="222">
					<Title>Certificate path delivery</Title>
					<Description>Delivery of a path.</Description>
				</Value>
				<Value Code="224">
					<Title>Certificate status notice</Title>
					<Description>Notice of current status of a given certificate.</Description>
				</Value>
				<Value Code="225">
					<Title>Certificate validation notice</Title>
					<Description>Notice of validation of an existing certificate.</Description>
				</Value>
				<Value Code="231">
					<Title>Revocation confirmation</Title>
					<Description>Confirmation of revocation of a party's certificate.</Description>
				</Value>
				<Value Code="251">
					<Title>Symmetric key delivery</Title>
					<Description>Delivery of symmetric keys.</Description>
				</Value>
				<Value Code="252">
					<Title>Discontinuation acknowledgement</Title>
					<Description>Acknowledgement of the requested discontinuation.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0591">
			<Title>PADDING MECHANISM, CODED</Title>
			<Description>Padding mechanism or padding scheme applied.</Description>
			<Values>
				<Value Code="1">
					<Title>Zero padding</Title>
					<Description>Message padding used for block cipher algorithms. Binary zeros are appended to the end of the message in order to make the message length an exact integer multiple of the block length. The block length is implicitly specified through the algorithm and mode of operation.</Description>
				</Value>
				<Value Code="2">
					<Title>PKCS #1 padding</Title>
					<Description>Message padding used for block cipher algorithms according to PKCS #1 (published by RSA Inc., 1993).</Description>
				</Value>
				<Value Code="3">
					<Title>ISO 10126 padding</Title>
					<Description>Message padding used for block cipher algorithms according to ISO-10126 specification.</Description>
				</Value>
				<Value Code="4">
					<Title>TBSS padding</Title>
					<Description>Message padding used for block cipher algorithms according to TBSS (Swiss standard, published by Telekurs AG, 1996).</Description>
				</Value>
				<Value Code="5">
					<Title>FF padding</Title>
					<Description>Message padding used for block cipher algorithms. Binary 255 are padded to fill a message up to a block length. The block length is implicit specified through the algorithm and mode of operation.</Description>
				</Value>
				<Value Code="6">
					<Title>ISO/IEC 9796-1 padding</Title>
					<Description>Message padding for digital signature schemes according to ISO/IEC 9796-1.</Description>
				</Value>
				<Value Code="7">
					<Title>ISO/IEC 9796-2 padding</Title>
					<Description>Message padding for digital signature schemes according to ISO/IEC 9796-2.</Description>
				</Value>
				<Value Code="8">
					<Title>ISO/IEC 9796-3 padding</Title>
					<Description>Message padding for digital signature schemes according to ISO/IEC 9796-3.</Description>
				</Value>
				<Value Code="9">
					<Title>TBSS envelope padding</Title>
					<Description>Message padding for digital envelopes according to TBSS (Swiss standard, published by Telekurs AG, 1996)</Description>
				</Value>
				<Value Code="10">
					<Title>PKCS #1 envelope padding</Title>
					<Description>Message padding for digital envelopes according to PKCS #1 (published by RSA Inc, 1993).</Description>
				</Value>
				<Value Code="11">
					<Title>PKCS #1 signature padding</Title>
					<Description>Message padding for digital signature schemes according to PKCS #1 (published by RSA Inc, 1993).</Description>
				</Value>
				<Value Code="12">
					<Title>BCS signature padding</Title>
					<Description>Message padding for digital signature schemes according to ZKA (German standard published by ZKA 1995).</Description>
				</Value>
				<Value Code="13">
					<Title>OAEP</Title>
					<Description>Optimal Asymmetric Encryption Padding (published in IEEE P1363).</Description>
				</Value>
				<Value Code="14">
					<Title>RSAES-OAEP</Title>
					<Description>Padding mechanism specified in PKCS#1, version2, for encryption with a RSA public key.</Description>
				</Value>
				<Value Code="15">
					<Title>RSAES-PKCS#1-v1_5</Title>
					<Description>Padding mechanism specified in PKCS#1, version2, for encryption with a RSA public key.</Description>
				</Value>
				<Value Code="16">
					<Title>RSASA-PKCS-v1_5</Title>
					<Description>Padding mechanism specified in PKCS#1, version2, for digital signatures.</Description>
				</Value>
				<Value Code="17">
					<Title>Encryption Block Formatting</Title>
					<Description>Padding mechanism specified in PKCS#1, version 1.5.</Description>
				</Value>
				<Value Code="18">
					<Title>PKCS#5</Title>
					<Description>Padding mechanism specified in PKCS#5 for symmetric encryption.</Description>
				</Value>
				<Value Code="19">
					<Title>ANSI X9.23</Title>
					<Description>Padding mechanism specified in ANSI X9.23 for symmetric encryption.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0601">
			<Title>PADDING MECHANISM CODE LIST IDENTIFIER</Title>
			<Description>Specification of the code list used to identify the padding mechanism or padding scheme.</Description>
			<Values>
				<Value Code="1">
					<Title>UN/CEFACT</Title>
					<Description>United Nations Centre for Trade Facilitation and Electronic Business (UN/CEFACT).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0805">
			<Title>OBJECT TYPE QUALIFIER</Title>
			<Description>Qualifier referring to the type of object.</Description>
			<Values>
				<Value Code="1">
					<Title>Computer environment type</Title>
					<Description>Specification of the type of computer environment for which the object is intended.</Description>
				</Value>
				<Value Code="2">
					<Title>Computer environment version</Title>
					<Description>Specification of the version of the computer environment for which the object is intended.</Description>
				</Value>
				<Value Code="3">
					<Title>Computer environment release</Title>
					<Description>Specification of the release of the computer environment for which the object is intended.</Description>
				</Value>
				<Value Code="5">
					<Title>Computer environment name</Title>
					<Description>Specification of the name of the computer environment for which the object is intended.</Description>
				</Value>
				<Value Code="6">
					<Title>Non-EDIFACT security level code</Title>
					<Description>Specification of the level such as interchange, group or message at which non-EDIFACT security is applied to the data constituting the object.</Description>
				</Value>
				<Value Code="7">
					<Title>Non-EDIFACT security version</Title>
					<Description>Specification of the version of the non-EDIFACT security technique applied to the data constituting the object.</Description>
				</Value>
				<Value Code="8">
					<Title>Non-EDIFACT security release</Title>
					<Description>Specification of the release of the non-EDIFACT security technique applied to the data constituting the object.</Description>
				</Value>
				<Value Code="9">
					<Title>Non-EDIFACT security technique</Title>
					<Description>Specification of the non-EDIFACT security technique applied to the data constituting the object.</Description>
				</Value>
				<Value Code="10">
					<Title>Non-EDIFACT security free text information</Title>
					<Description>Free form description of the non-EDIFACT security technique applied to the data constituting the object.</Description>
				</Value>
				<Value Code="11">
					<Title>File identification by number</Title>
					<Description>Identification number assigned to the file constituting the object.</Description>
				</Value>
				<Value Code="12">
					<Title>File identification by name</Title>
					<Description>Name assigned to the file constituting the object.</Description>
				</Value>
				<Value Code="13">
					<Title>File format</Title>
					<Description>Specification of the format of the file constituting the object.</Description>
				</Value>
				<Value Code="14">
					<Title>File version</Title>
					<Description>Specification of the version of the file constituting the object.</Description>
				</Value>
				<Value Code="15">
					<Title>File release</Title>
					<Description>Specification of the release of the file constituting the object.</Description>
				</Value>
				<Value Code="16">
					<Title>File status</Title>
					<Description>Specification of the status of the file constituting the object.</Description>
				</Value>
				<Value Code="17">
					<Title>File size</Title>
					<Description>Specification of the size of the file constituting the object in bytes.</Description>
				</Value>
				<Value Code="18">
					<Title>File description</Title>
					<Description>Free form description of the file constituting the object.</Description>
				</Value>
				<Value Code="19">
					<Title>File block type</Title>
					<Description>Specification of the type of blocking used to partition the file constituting the object.</Description>
				</Value>
				<Value Code="20">
					<Title>File block length</Title>
					<Description>Specification of the length of the blocks used to partition the file constituting the object.</Description>
				</Value>
				<Value Code="21">
					<Title>File record length</Title>
					<Description>Specification of the length of the records contained in the file constituting the object expressed as the number of character positions.</Description>
				</Value>
				<Value Code="22">
					<Title>Program identification by number</Title>
					<Description>Identification number assigned to the program constituting the object.</Description>
				</Value>
				<Value Code="23">
					<Title>Program identification by name</Title>
					<Description>Name assigned to the program constituting the object.</Description>
				</Value>
				<Value Code="24">
					<Title>Program type</Title>
					<Description>Specification of the type of program constituting the object.</Description>
				</Value>
				<Value Code="25">
					<Title>Program version</Title>
					<Description>Specification of the version of the program constituting the object.</Description>
				</Value>
				<Value Code="26">
					<Title>Program release</Title>
					<Description>Specification of the release of the program constituting the object.</Description>
				</Value>
				<Value Code="27">
					<Title>Program status</Title>
					<Description>Specification of the status of the program constituting the object.</Description>
				</Value>
				<Value Code="28">
					<Title>Program description</Title>
					<Description>Free form description of the program constituting the object.</Description>
				</Value>
				<Value Code="29">
					<Title>Program size</Title>
					<Description>Specification of the size of the program constituting the object in bytes.</Description>
				</Value>
				<Value Code="30">
					<Title>Interchange format</Title>
					<Description>Specification of the format of the interchange constituting the object.</Description>
				</Value>
				<Value Code="31">
					<Title>Interchange version</Title>
					<Description>Specification of the version of the interchange constituting the object.</Description>
				</Value>
				<Value Code="32">
					<Title>Interchange release</Title>
					<Description>Specification of the release of the interchange constituting the object.</Description>
				</Value>
				<Value Code="33">
					<Title>Interchange status</Title>
					<Description>Specification of the status of the interchange constituting the object.</Description>
				</Value>
				<Value Code="34">
					<Title>Interchange identification</Title>
