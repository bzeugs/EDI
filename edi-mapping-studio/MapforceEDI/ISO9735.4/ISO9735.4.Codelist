		<Field Name="F0501">
			<Title>SECURITY SERVICE, CODED</Title>
			<Description>Specification of the security service applied.</Description>
			<Values>
				<Value Code="1">
					<Title>Non-repudiation of origin</Title>
					<Description>The message includes a digital signature protecting the receiver of the message from the sender's denial of having sent the message.</Description>
				</Value>
				<Value Code="2">
					<Title>Message origin authentication</Title>
					<Description>The actual sender of the message cannot claim to be some other (authorized) entity.</Description>
				</Value>
				<Value Code="3">
					<Title>Integrity</Title>
					<Description>The message content is protected against the modification of data.</Description>
				</Value>
				<Value Code="4">
					<Title>Confidentiality</Title>
					<Description>The message content is protected against the unauthorised reading, copying or disclosure of its content.</Description>
				</Value>
				<Value Code="5">
					<Title>Non-repudiation of receipt</Title>
					<Description>Non-repudiation of receipt protects the sender of an object message from the receiver's denial of having received the message.</Description>
				</Value>
				<Value Code="6">
					<Title>Receipt authentication</Title>
					<Description>Receipt authentication ensures the sender that the message has been received by the authenticated recipient.</Description>
				</Value>
				<Value Code="7">
					<Title>Referenced EDIFACT structure non-repudiation of origin</Title>
					<Description>The referenced EDIFACT structure is secured by a digital signature protecting the receiver of the message from the sender's denial of� having sent the message.</Description>
				</Value>
				<Value Code="8">
					<Title>Referenced EDIFACT structure origin authentication</Title>
					<Description>The actual sender of the referenced EDIFACT structure cannot claim to be some other (authorized) party.</Description>
				</Value>
				<Value Code="9">
					<Title>Referenced EDIFACT structure integrity</Title>
					<Description>The referenced EDIFACT structure content is protected against the modification of data.</Description>
				</Value>
				<Value Code="10">
					<Title>Time stamping request</Title>
					<Description>Ask for the EDIFACT structure to be time stamped.</Description>
				</Value>
				<Value Code="11">
					<Title>Entity authentication</Title>
					<Description>The initiator and/or responder cannot claim to be another party.</Description>
				</Value>
				<Value Code="12">
					<Title>Entity authentication with key establishment</Title>
					<Description>The initiator and/or responder cannot claim to be another party, and security keys are established.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0503">
			<Title>RESPONSE TYPE, CODED</Title>
			<Description>Specification of the type of response expected from the recipient.</Description>
			<Values>
				<Value Code="1">
					<Title>No acknowledgement required</Title>
					<Description>No AUTACK acknowledgement message expected.</Description>
				</Value>
				<Value Code="2">
					<Title>Acknowledgement required</Title>
					<Description>AUTACK acknowledgement message expected.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0505">
			<Title>FILTER FUNCTION, CODED</Title>
			<Description>Identification of the filtering function used to reversibly map any bit pattern on to a restricted character set.</Description>
			<Values>
				<Value Code="1">
					<Title>No filter</Title>
					<Description>No filter function is used.</Description>
				</Value>
				<Value Code="2">
					<Title>Hexadecimal filter</Title>
					<Description>Hexadecimal filter.</Description>
				</Value>
				<Value Code="3">
					<Title>ISO/IEC 646 filter</Title>
					<Description>ASCII filter as described in ISO 10126-1.</Description>
				</Value>
				<Value Code="4">
					<Title>ISO/IEC 646 Baudot filter</Title>
					<Description>Baudot filter as described in ISO 10126-1.</Description>
				</Value>
				<Value Code="5">
					<Title>UN/EDIFACT EDA filter</Title>
					<Description>Filter function for UN/EDIFACT character set repertoire A as described in ISO 9735-5.</Description>
				</Value>
				<Value Code="6">
					<Title>UN/EDIFACT EDC filter</Title>
					<Description>Filter function for UN/EDIFACT character set repertoire A as described in ISO 9735-5.</Description>
				</Value>
				<Value Code="7">
					<Title>Base 64 filter</Title>
					<Description>Base 64 filter function as described in RFC 1521.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0507">
			<Title>ORIGINAL CHARACTER SET ENCODING, CODED</Title>
			<Description>Identification of the character set in which the secured EDIFACT structure was encoded when security mechanisms were applied.</Description>
			<Values>
				<Value Code="1">
					<Title>ASCII 7 bit</Title>
					<Description>ASCII 7 bit code.</Description>
				</Value>
				<Value Code="2">
					<Title>ASCII 8 bit</Title>
					<Description>ASCII 8 bit code.</Description>
				</Value>
				<Value Code="3">
					<Title>Code page 850 (IBM PC Multinational)</Title>
					<Description>Encoding schema for the repertoire as defined by the code page.</Description>
				</Value>
				<Value Code="4">
					<Title>Code page 500 (EBCDIC Multinational No. 5)</Title>
					<Description>Encoding schema for the repertoire as defined by the code page.</Description>
				</Value>
				<Value Code="5">
					<Title>UCS-2</Title>
					<Description>Universal Multiple-Octet Coded Character Set (UCS) two-octet per character encoding schema as defined in ISO/IEC 10646.</Description>
				</Value>
				<Value Code="6">
					<Title>UCS-4</Title>
					<Description>Universal Multiple-Octet Coded Character Set (UCS) four-octet per character encoding schema as defined in ISO/IEC 10646.</Description>
				</Value>
				<Value Code="7">
					<Title>UTF-8</Title>
					<Description>UCS Transformation Format 8 (UTF-8) multi-octet (of length one to six octets) per character encoding schema as defined in ISO/IEC 10646, Annex R.</Description>
				</Value>
				<Value Code="8">
					<Title>UTF-16</Title>
					<Description>UCS Transformation Format 16 (UTF-16) two-octet per character encoding schema as defined in ISO/IEC 10646, Annex Q.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0509">
			<Title>ROLE OF SECURITY PROVIDER, CODED</Title>
			<Description>Identification of the role of the security provider in relation to the secured item.</Description>
			<Values>
				<Value Code="1">
					<Title>Issuer</Title>
					<Description>The security provider is the rightful issuer of the signed document.</Description>
				</Value>
				<Value Code="2">
					<Title>Notary</Title>
					<Description>The security provider acts as a notary in relation to the signed document.</Description>
				</Value>
				<Value Code="3">
					<Title>Contracting party</Title>
					<Description>The security provider endorses the content of the signed document.</Description>
				</Value>
				<Value Code="4">
					<Title>Witness</Title>
					<Description>The security provider is a witness, but is not responsible for� the content of the signed document.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0513">
			<Title>SECURITY PARTY CODE LIST QUALIFIER</Title>
			<Description>Identification of the type of identification used to register the security parties.</Description>
			<Values>
				<Value Code="1">
					<Title>ACH</Title>
					<Description>Automated clearing house identification.</Description>
				</Value>
				<Value Code="2">
					<Title>GS1</Title>
					<Description>GS1, an international organization of GS1 Member Organizations that manages the GS1 System.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually agreed</Title>
					<Description>Mutually agreed between trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0515">
			<Title>SECURITY PARTY CODE LIST RESPONSIBLE AGENCY, CODED</Title>
			<Description>Identification of the agency in charge of registration of the security parties.</Description>
			<Values>
				<Value Code="1">
					<Title>UN/CEFACT</Title>
					<Description>United Nations Centre for Trade Facilitation and Electronic Business (UN/CEFACT).</Description>
				</Value>
				<Value Code="2">
					<Title>ISO</Title>
					<Description>International Organization for Standardization.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0517">
			<Title>DATE AND TIME QUALIFIER</Title>
			<Description>Specification of the type of date and time.</Description>
			<Values>
				<Value Code="1">
					<Title>Security Timestamp</Title>
					<Description>Security timestamp of the secured message.</Description>
				</Value>
				<Value Code="2">
					<Title>Certificate generation date and time</Title>
					<Description>Identifies the date and time of generation of the certificate by the Certification Authority.</Description>
				</Value>
				<Value Code="3">
					<Title>Certificate start of validity period</Title>
					<Description>Identifies the date and time from which the certificate must be considered valid.</Description>
				</Value>
				<Value Code="4">
					<Title>Certificate end of validity period</Title>
					<Description>Identifies the date and time until which the certificate must be considered valid.</Description>
				</Value>
				<Value Code="5">
					<Title>EDIFACT structure generation date and time</Title>
					<Description>Date and time of generation of the secured EDIFACT structure.</Description>
				</Value>
				<Value Code="6">
					<Title>Certificate revocation date and time</Title>
					<Description>Identifies the date and time of revocation of the certificate by the Certification Authority.</Description>
				</Value>
				<Value Code="7">
					<Title>Key generation date and time</Title>
					<Description>Identifies the date and time of generation of the key(s).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0523">
			<Title>USE OF ALGORITHM, CODED</Title>
			<Description>Specification of the usage made of the algorithm.</Description>
			<Values>
				<Value Code="1">
					<Title>Owner hashing</Title>
					<Description>Specifies that the algorithm is used by the message sender to compute the hash function on the message (as in the case of Integrity or Non-repudiation of Origin identified in the security function qualifier of USH).</Description>
				</Value>
				<Value Code="2">
					<Title>Owner symmetric</Title>
					<Description>Specifies that the algorithm is used by the message sender either for integrity, confidentiality, or message origin authentication (specified by security service, coded in USH).</Description>
				</Value>
				<Value Code="3">
					<Title>Issuer signing</Title>
					<Description>Specifies that the algorithm is used by the Certificate Issuer (CA) to sign the hash result computed on the certificate.</Description>
				</Value>
				<Value Code="4">
					<Title>Issuer hashing</Title>
					<Description>Specifies that the algorithm is used by the Certificate Issuer (CA) to compute the hash result on the certificate.</Description>
				</Value>
				<Value Code="5">
					<Title>Owner enciphering</Title>
					<Description>Specifies that the algorithm is used by the message sender to encrypt a symmetric key.</Description>
				</Value>
				<Value Code="6">
					<Title>Owner signing</Title>
					<Description>Specifies that the algorithm is used by the message sender to sign either the hash result computed on the message or the symmetric keys.</Description>
				</Value>
				<Value Code="7">
					<Title>Owner enciphering or signing</Title>
					<Description>Specifies that the algorithm may be used by the message sender either to encrypt a symmetric key or sign the hash result computed on the� message. This value may only be used in a USA segment within a USC segment group. When encrypting a symmetric key a receiver certificate shall be used. When signing a hash result a sender certificate shall be used.</Description>
				</Value>
				<Value Code="8">
					<Title>Owner compressing</Title>
					<Description>Specifies that the algorithm is used by the message sender to compress the data before (encryption and) submission.</Description>
				</Value>
				<Value Code="9">
					<Title>Owner compression integrity</Title>
					<Description>Specifies that the algorithm is used by the message sender on the compressed data before (encryption and) submission. The integrity value is used to verify the contents of the compressed text before expansion.</Description>
				</Value>
				<Value Code="10">
					<Title>Key agreement</Title>
					<Description>Specifies that the algorithm is used by the initiator and responder to agree a secret key.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0525">
			<Title>CRYPTOGRAPHIC MODE OF OPERATION, CODED</Title>
			<Description>Specification of the mode of operation used for the algorithm.</Description>
			<Values>
				<Value Code="1">
					<Title>ECB</Title>
					<Description>DES modes of operation, Electronic Code Book; FIPS Pub 81 (1981); ANSI X3.106; ISO 8372 (64 bits); ISO/IEC 10116 (n-bits).</Description>
				</Value>
				<Value Code="2">
					<Title>CBC</Title>
					<Description>DES modes of operation, Cipher Block Chaining; FIPS Pub 81 (1981); ANSI X3.106; ISO 8372 (64 bits); ISO/IEC 10116 (n-bits).</Description>
				</Value>
				<Value Code="3">
					<Title>CFB1</Title>
					<Description>DES modes of operation, Cipher feedback; FIPS Pub 81 (1981); ANSI X3.106; ISO 8372 (64 bits); ISO/IEC 10116 (n-bits).</Description>
				</Value>
				<Value Code="4">
					<Title>CFB8</Title>
					<Description>DES modes of operation, Cipher feedback; FIPS Pub 81 (1981); ANSI X3.106; ISO 8372 (64 bits); ISO/IEC 10116 (n-bits).</Description>
				</Value>
				<Value Code="5">
					<Title>OFB</Title>
					<Description>DES modes of operation; FIPS Pub 81 (1981); ISO 8372 (64 bits); ISO/IEC 10116 (n-bits).</Description>
				</Value>
				<Value Code="16">
					<Title>DSMR</Title>
					<Description>Digital Signature scheme giving Message Recovery. ISO/IEC 9796.</Description>
				</Value>
				<Value Code="17">
					<Title>CFB64</Title>
