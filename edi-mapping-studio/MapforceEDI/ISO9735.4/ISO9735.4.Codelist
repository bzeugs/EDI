		<Field Name="F0052">
			<Title>MESSAGE VERSION NUMBER</Title>
			<Description>Version number of a message type.</Description>
			<Values>
				<Value Code="1">
					<Title>Status 1 version</Title>
					<Description>Message approved and issued as a status 1 (trial) message. (Valid for directories published after March 1990 and prior to March 1993).</Description>
				</Value>
				<Value Code="2">
					<Title>Status 2 version</Title>
					<Description>Message approved and issued as a status 2 (formal recommendation) message. (Valid for directories published after March 1990 and prior to March 1993).</Description>
				</Value>
				<Value Code="4">
					<Title>Service message, version 4</Title>
					<Description>Service messages approved and issued as a part of ISO 9735/Version 4, for use with that version of the syntax.</Description>
				</Value>
				<Value Code="88">
					<Title>1988 version</Title>
