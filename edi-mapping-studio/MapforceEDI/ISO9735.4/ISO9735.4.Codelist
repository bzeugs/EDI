		<Field Name="F0025">
			<Title>RECIPIENT REFERENCE/PASSWORD QUALIFIER</Title>
			<Description>Qualifier for the recipient's reference or password.</Description>
			<Values>
				<Value Code="AA">
					<Title>Reference</Title>
					<Description>Recipient's reference/password is a reference.</Description>
				</Value>
				<Value Code="BB">
					<Title>Password</Title>
					<Description>Recipient's reference/password is a password.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0029">
			<Title>PROCESSING PRIORITY CODE</Title>
			<Description>Code determined by the sender requesting processing priority for the interchange.</Description>
			<Values>
				<Value Code="A">
					<Title>Highest priority</Title>
					<Description>Requested processing priority is the highest.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0031">
			<Title>ACKNOWLEDGEMENT REQUEST</Title>
			<Description>Code requesting acknowledgement for the interchange.</Description>
			<Values>
				<Value Code="1">
					<Title>Acknowledgement requested</Title>
					<Description>Acknowledgement is requested.</Description>
				</Value>
				<Value Code="2">
					<Title>Indication of receipt</Title>
					<Description>Confirmation of receipt only.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F0035">
			<Title>TEST INDICATOR</Title>
			<Description>Indication that the structural level containing the test indicator is a test.</Description>
			<Values>
				<Value Code="1">
					<Title>Interchange is a test</Title>
					<Description>Indicates that the interchange is a test.</Description>
				</Value>
				<Value Code="2">
					<Title>Syntax only test</Title>
					<Description>Test only syntax of structure.</Description>
				</Value>
				<Value Code="3">
					<Title>Echo request</Title>
					<Description>To be returned without change, except for this data element to have the value 4.</Description>
				</Value>
				<Value Code="4">
					<Title>Echo response</Title>
					<Description>Returned without change except for this data element changing from 3 to 4.</Description>
				</Value>
				<Value Code="5">
					<Title>Interchange is a service provider test</Title>
					<Description>Indicates that this interchange is a test with a service provider.</Description>
				</Value>
			</Values>
		</Field>
