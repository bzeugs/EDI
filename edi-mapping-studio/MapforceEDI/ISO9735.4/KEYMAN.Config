<?xml version="1.0" encoding="UTF-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../EDIConfig.xsd" Version="3">
	<Meta>
		<Version>4</Version>
		<Release>1</Release>
		<Agency>UN</Agency>
	</Meta>
	<Format standard="EDIFACT"/>
	<Include href="Admin.Segment"/>
	<Include href="ISO9735.4.Codelist"/>
	<Message>
		<MessageType>KEYMAN</MessageType>
		<Description>Security key and certificate management message</Description>
		<Revision>1</Revision>
		<Date>2002-07-01</Date>
   		<Group name="Message_KEYMAN" maxOccurs="unbounded" info="UNH - Message header">
   			<Segment ref="UNH" minOccurs="1" maxOccurs="1"/>
   			<Group name="SG1" minOccurs="0" maxOccurs="999" info="USE - Security message relation">
   				<Segment ref="USE" minOccurs="1" maxOccurs="1"/>
   				<Segment ref="USX" minOccurs="0" maxOccurs="1"/>
   				<Group name="SG2" minOccurs="1" maxOccurs="9" info="USF - Key management function">
   					<Segment ref="USF" minOccurs="1" maxOccurs="1"/>
   					<Segment ref="USA" minOccurs="0" maxOccurs="1"/>
   					<Group name="SG3" minOccurs="0" maxOccurs="1" info="USC - Certificate">
   						<Segment ref="USC" minOccurs="1" maxOccurs="1"/>
   						<Segment ref="USA" minOccurs="0" maxOccurs="3"/>
   						<Segment ref="USR" minOccurs="0" maxOccurs="1"/>
   					</Group>
   				</Group>
   			</Group>
   			<Group name="SG4" minOccurs="0" maxOccurs="99" info="USL - Security list status">
   				<Segment ref="USL" minOccurs="1" maxOccurs="1"/>
   				<Group name="SG5" minOccurs="1" maxOccurs="9999" info="USC - Certificate">
   					<Segment ref="USC" minOccurs="1" maxOccurs="1"/>
   					<Segment ref="USA" minOccurs="0" maxOccurs="3"/>
   					<Segment ref="USR" minOccurs="0" maxOccurs="1"/>
   				</Group>
   			</Group>
   			<Segment ref="UNT" minOccurs="1" maxOccurs="1"/>
   		</Group>
	</Message>
</Config>