<?xml version="1.0" encoding="UTF-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../EDIConfig.xsd" Version="3">
	<Meta>
		<Version>4</Version>
		<Release>1</Release>
		<Agency>UN</Agency>
	</Meta>
	<Format standard="EDIFACT"/>
	<Include href="Admin.Segment"/>
	<Include href="ISO9735.4.Codelist"/>
	<Message>
		<MessageType>AUTACK</MessageType>
		<Description>Acknowledgement message</Description>
		<Revision>1</Revision>
		<Date>2002-07-01</Date>
   		<Group name="Message_AUTACK" maxOccurs="unbounded" info="UNH - Message header">
   			<Segment ref="UNH" minOccurs="1" maxOccurs="1"/>
   			<Group name="SG1" minOccurs="1" maxOccurs="99" info="USH - SECURITY HEADER">
   				<Segment ref="USH" minOccurs="1" maxOccurs="1"/>
   				<Segment ref="USA" minOccurs="0" maxOccurs="3"/>
   				<Group name="SG2" minOccurs="0" maxOccurs="2" info="USC - CERTIFICATE">
   					<Segment ref="USC" minOccurs="1" maxOccurs="1"/>
   					<Segment ref="USA" minOccurs="0" maxOccurs="3"/>
   					<Segment ref="USR" minOccurs="0" maxOccurs="1"/>
   				</Group>
   			</Group>
   			<Segment ref="USB" minOccurs="1" maxOccurs="1"/>
   			<Group name="SG3" minOccurs="1" maxOccurs="9999" info="USX - SECURITY REFERENCES">
   				<Segment ref="USX" minOccurs="1" maxOccurs="1"/>
   				<Segment ref="USY" minOccurs="1" maxOccurs="9"/>
   			</Group>
   			<Group name="SG4" minOccurs="1" maxOccurs="99" info="UST - SECURITY TRAILER">
   					<Segment ref="UST" minOccurs="1" maxOccurs="1"/>
   					<Segment ref="USR" minOccurs="0" maxOccurs="1"/>
   			</Group>
   			<Segment ref="UNT" minOccurs="1" maxOccurs="1"/>
   		</Group>
	</Message>
</Config>