<?xml version="1.0" encoding="UTF-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../EDIConfig.xsd" Version="3">
	<Meta>
		<Version>4</Version>
		<Release>1</Release>
		<Agency>UN</Agency>
	</Meta>
	<Format standard="EDIFACT"/>
	<Include href="Admin.Segment"/>
	<Include href="ISO9735.4.Codelist"/>
	<Include collection="EDI.Collection"/>
   	<Group name="Envelope">
   		<Group name="Interchange" maxOccurs="unbounded">
   			<Segment ref="UNA" minOccurs="0"/>
   			<Segment ref="UNB" minOccurs="0"/>
   			<Group name="Group" maxOccurs="unbounded">
   				<Segment ref="UNG" minOccurs="0"/>
				<Select name="Select" type="Group" field="UNH/S009/F0065" prefix="Message_" maxOccurs="unbounded">
					<Segment ref="UNH"/>
				</Select>
				<Segment ref="UNE" minOccurs="0"/>
   			</Group>
   			<Segment ref="UNZ" minOccurs="0"/>
   		</Group>
   	</Group>
</Config>
