<?xml version="1.0" encoding="UTF-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="EDIConfig.xsd" Version="3">
	<Meta>
		<Release/>
		<Agency>Altova</Agency>
	</Meta>
	<Format standard="Fixed"/>
	<Elements>
		<Segment name="SEGHEADER">
			<Data name="SEGNAM" type="string" minOccurs="0" maxLength="30" minLength="0"/>
			<Data name="MANDT" type="string" minOccurs="0" maxLength="3" minLength="0" info="Mandant"/>
			<Data name="DOCNUM" type="string" minOccurs="0" maxLength="16" minLength="0" info="IDoc number"/>
			<Data name="SEGNUM" type="string" minOccurs="0" maxLength="6" minLength="0" info="Number of SAP segment (character field)"/>
			<Data name="PSGNUM" type="string" minOccurs="0" maxLength="6" minLength="0" info="Number of the hierarchically higher SAP segment"/>
			<Data name="HLEVEL" type="string" minOccurs="0" maxLength="2" minLength="0" info="Hierarchy level of SAP segment"/>
		</Segment>
		<Segment name="EDI_DC40_U" nodeName="EDI_DC40_U" info="Control Record">
			<Data name="MANDT" type="string" minOccurs="0" maxLength="3" minLength="0" info="Mandant"/>
			<Data name="DOCNUM" type="string" minOccurs="0" maxLength="16" minLength="0" info="IDoc number"/>
			<Data name="DOCREL" type="string" minOccurs="0" maxLength="4" minLength="0" info="SAP Release of IDoc"/>
			<Data name="STATUS" type="string" minOccurs="0" maxLength="2" minLength="0" info="Status of IDoc"/>
			<Data name="DIRECT" type="string" minOccurs="0" maxLength="1" minLength="0" info="Direction"/>
			<Data name="OUTMOD" type="string" minOccurs="0" maxLength="1" minLength="0" info="Output mode"/>
			<Data name="EXPRSS" type="string" minOccurs="0" maxLength="1" minLength="0" info="Overriding in inbound processing"/>
			<Data name="TEST" type="string" minOccurs="0" maxLength="1" minLength="0" info="Test flag"/>
			<Data name="IDOCTYP" type="string" minOccurs="0" maxLength="30" minLength="0" info="Name of basic IDoc type"/>
			<Data name="CIMTYP" type="string" minOccurs="0" maxLength="30" minLength="0" info="Name of extension type"/>
			<Data name="MESTYP" type="string" minOccurs="0" maxLength="30" minLength="0" info="Logical message type"/>
			<Data name="MESCOD" type="string" minOccurs="0" maxLength="3" minLength="0" info="Logical message code"/>
			<Data name="MESFCT" type="string" minOccurs="0" maxLength="3" minLength="0" info="Logical message function"/>
			<Data name="STD" type="string" minOccurs="0" maxLength="1" minLength="0" info="EDI standard"/>
			<Data name="STDVRS" type="string" minOccurs="0" maxLength="6" minLength="0" info="Version of EDI standard"/>
			<Data name="STDMES" type="string" minOccurs="0" maxLength="6" minLength="0" info="EDI message type"/>
			<Data name="SNDPOR" type="string" minOccurs="0" maxLength="10" minLength="0" info="Sender port (SAP System, EDI subsystem)"/>
			<Data name="SNDPRT" type="string" minOccurs="0" maxLength="2" minLength="0" info="Partner type of sender"/>
			<Data name="SNDPFC" type="string" minOccurs="0" maxLength="2" minLength="0" info="Partner function of sender"/>
			<Data name="SNDPRN" type="string" minOccurs="0" maxLength="10" minLength="0" info="Partner number of sender"/>
			<Data name="SNDSAD" type="string" minOccurs="0" maxLength="21" minLength="0" info="Sender address (SADR)"/>
			<Data name="SNDLAD" type="string" minOccurs="0" maxLength="70" minLength="0" info="Logical address of sender"/>
			<Data name="RCVPOR" type="string" minOccurs="0" maxLength="10" minLength="0" info="Receiver port (SAP System, EDI subsystem)"/>
			<Data name="RCVPRT" type="string" minOccurs="0" maxLength="2" minLength="0" info="Partner type of receiver"/>
			<Data name="RCVPFC" type="string" minOccurs="0" maxLength="2" minLength="0" info="Partner function of receiver"/>
			<Data name="RCVPRN" type="string" minOccurs="0" maxLength="10" minLength="0" info="Partner number of receiver"/>
			<Data name="RCVSAD" type="string" minOccurs="0" maxLength="21" minLength="0" info="Receiver address (SADR)"/>
			<Data name="RCVLAD" type="string" minOccurs="0" maxLength="70" minLength="0" info="Logical address of receiver"/>
			<Data name="CREDAT" type="string" minOccurs="0" maxLength="8" minLength="0" info="Date status record was created"/>
			<Data name="CRETIM" type="string" minOccurs="0" maxLength="6" minLength="0" info="Time status record was created"/>
			<Data name="REFINT" type="string" minOccurs="0" maxLength="14" minLength="0" info="Reference to interchange file"/>
			<Data name="REFGRP" type="string" minOccurs="0" maxLength="14" minLength="0" info="Reference to message group"/>
			<Data name="REFMES" type="string" minOccurs="0" maxLength="14" minLength="0" info="Reference to message"/>
			<Data name="ARCKEY" type="string" minOccurs="0" maxLength="70" minLength="0" info="EDI archive key"/>
			<Data name="SERIAL" type="string" minOccurs="0" maxLength="20" minLength="0" info="EDI/ALE: Serialization field"/>
		</Segment>
		<Segment name="EDIDS     " nodeName="EDIDS" info="Status Record" minOccurs="0" maxOccurs="unbounded">
			<Data name="MANDT" type="string" maxLength="3" minLength="0" minOccurs="0" info="SAP client no"/>
			<Data name="DOCNUM" type="string" maxLength="16" minLength="0" minOccurs="0" info="IDoc number"/>
			<Data name="LOGDAT" type="string" maxLength="8" minLength="0" minOccurs="0" info="Date of status information"/>
			<Data name="LOGTIM" type="string" maxLength="6" minLength="0" minOccurs="0" info="Time of status information"/>
			<Data name="STATUS" type="string" maxLength="2" minLength="0" minOccurs="0" info="Status of IDoc"/>
			<Data name="STAMQU" type="string" maxLength="3" minLength="0" minOccurs="0" info="System generating message"/>
			<Data name="STAMID" type="string" maxLength="20" minLength="0" minOccurs="0" info="SAP message class"/>
			<Data name="STAMNO" type="string" maxLength="3" minLength="0" minOccurs="0" info="SAP message no"/>
			<Data name="STATYP" type="string" maxLength="1" minLength="0" minOccurs="0" info="EDI: Type of system error message (A, W, E, S, I)"/>
			<Data name="STAPA1" type="string" maxLength="50" minLength="0" minOccurs="0" info="Parameter 1"/>
			<Data name="STAPA2" type="string" maxLength="50" minLength="0" minOccurs="0" info="Parameter 1"/>
			<Data name="STAPA3" type="string" maxLength="50" minLength="0" minOccurs="0" info="Parameter 1"/>
			<Data name="STAPA4" type="string" maxLength="50" minLength="0" minOccurs="0" info="Parameter 1"/>
			<Data name="STATXT" type="string" maxLength="70" minLength="0" minOccurs="0" info="Text for status code"/>
			<Data name="UNAME" type="string" maxLength="12" minLength="0" minOccurs="0" info="User name"/>
			<Data name="REPID" type="string" maxLength="30" minLength="0" minOccurs="0" info="Program name"/>
			<Data name="ROUTID" type="string" maxLength="30" minLength="0" minOccurs="0" info="Name of subroutine (routine, function module)"/>
			<Data name="SEGNUM" type="string" maxLength="6" minLength="0" minOccurs="0" info="Number of SAP segment (character field)"/>
			<Data name="SEGFLD" type="string" maxLength="30" minLength="0" minOccurs="0" info="Field name in SAP segment"/>
			<Data name="REFINT" type="string" maxLength="14" minLength="0" minOccurs="0" info="Reference to interchange file"/>
			<Data name="REFGRP" type="string" maxLength="14" minLength="0" minOccurs="0" info="Reference to message group"/>
			<Data name="REFMES" type="string" maxLength="14" minLength="0" minOccurs="0" info="Reference to message"/>
			<Data name="ARCKEY" type="string" maxLength="70" minLength="0" minOccurs="0" info="EDI archive key"/>
		</Segment>
	</Elements>
</Config>
