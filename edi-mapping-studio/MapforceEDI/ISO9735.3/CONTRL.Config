<?xml version="1.0" encoding="UTF-8"?>
<Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../EDIConfig.xsd" Version="3">
	<Meta>
		<Version>D</Version>
		<Release>3</Release>
		<Agency>UN</Agency>
	</Meta>
	<Format standard="EDIFACT"/>
	<Include href="Admin.Segment"/>
	<Include href="ISO9735.3.Codelist"/>
	<Message>
		<MessageType>CONTRL</MessageType>
		<Description>Control message</Description>
		<Revision>1</Revision>
		<Date>1997-03-17</Date>
   		<Group name="Message_CONTRL" maxOccurs="unbounded" info="UNH - Message header">
   			<Segment ref="UNH" minOccurs="1" maxOccurs="1"/>
   			<Segment ref="UCI" minOccurs="1" maxOccurs="1"/>
   			<Group name="SG1" minOccurs="0" maxOccurs="999999" info="UCM - MESSAGE/PACKAGE RESPONSE">
   				<Segment ref="UCM" minOccurs="1" maxOccurs="1"/>
   				<Group name="SG2" minOccurs="0" maxOccurs="999" info="UCS - SEGMENT ERROR INDICATION">
   					<Segment ref="UCS" minOccurs="1" maxOccurs="1"/>
   					<Segment ref="UCD" minOccurs="0" maxOccurs="99"/>
   				</Group>
   			</Group>
   			<Group name="SG3" minOccurs="0" maxOccurs="999999" info="UCF - GROUP RESPONSE">
   				<Segment ref="UCF" minOccurs="1" maxOccurs="1"/>
   				<Group name="SG4" minOccurs="0" maxOccurs="999999" info="UCM - MESSAGE/PACKAGE RESPONSE">
   					<Segment ref="UCM" minOccurs="1" maxOccurs="1"/>
   					<Group name="SG5" minOccurs="0" maxOccurs="999" info="UCS - SEGMENT ERROR INDICATION">
   						<Segment ref="UCS" minOccurs="1" maxOccurs="1"/>
   						<Segment ref="UCD" minOccurs="0" maxOccurs="99"/>
   					</Group>
   				</Group>
   			</Group>
   			<Segment ref="UNT" minOccurs="1" maxOccurs="1"/>
   		</Group>
	</Message>
</Config>