				<Value Code="P85">
					<Title>torr per metre</Title>
					<Description>CGS (Centimetre-Gram-Second system) unit of the pressure divided by the SI base unit metre.</Description>
				</Value>
				<Value Code="P86">
					<Title>psi per inch</Title>
					<Description>Compound unit for pressure (pound-force according to the Anglo-American unit system divided by the power of the unit inch according to the Anglo-American and Imperial system of units with the exponent 2) divided by the unit inch according to the Anglo-American and Imperial system of units .</Description>
				</Value>
