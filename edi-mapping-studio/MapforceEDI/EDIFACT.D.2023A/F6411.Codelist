					<Title>poise per pascal</Title>
					<Description>CGS (Centimetre-Gram-Second system) unit poise divided by the derived SI unit pascal.</Description>
				</Value>
				<Value Code="N36">
					<Title>newton second per square metre</Title>
					<Description>Unit of the dynamic viscosity as a product of unit of the pressure (newton by square metre) multiplied with the SI base unit second.</Description>
				</Value>
				<Value Code="N37">
					<Title>kilogram per metre second</Title>
					<Description>Unit of the dynamic viscosity as a quotient SI base unit kilogram divided by the SI base unit metre and by the SI base unit second.</Description>
				</Value>
				<Value Code="N38">
