					<Description>Unit of the work (force-path).</Description>
				</Value>
				<Value Code="N47">
					<Title>inch poundal</Title>
					<Description>Unit of work (force multiplied by path) according to the Imperial system of units as a product unit inch multiplied by poundal.</Description>
				</Value>
				<Value Code="N48">
					<Title>watt per square centimetre </Title>
					<Description>Derived SI unit watt divided by the power of the 0,01-fold the SI base unit metre by exponent 2.</Description>
				</Value>
				<Value Code="N49">
