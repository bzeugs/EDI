					<Title>hartley</Title>
					<Description>Logarithmic unit for information equal to the content of decision of a sentence of ten mutually exclusive events, expressed as a logarithm to base 10.</Description>
				</Value>
				<Value Code="Q16">
					<Title>natural unit of information</Title>
