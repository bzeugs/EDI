<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2025 rel. 2 (x64) (https://www.altova.com) by Altova -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<!--Schema for MapForce EDI configuration files v8 (starting with V2024r2) -->
	<xs:element name="Config">
		<xs:annotation>
			<xs:documentation>EDI configuration root element</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Meta" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Reference to specification</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Version" type="xs:string" minOccurs="0"/>
							<xs:element name="Release" type="xs:string"/>
							<xs:element name="Agency" type="xs:string">
								<xs:annotation>
									<xs:documentation>e.g. "UN", "X12", "HL7", "G1S" or "NCPDP" - used for grouping in the GUI.</xs:documentation>
								</xs:annotation>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Format" minOccurs="0">
					<xs:complexType>
						<xs:attribute name="standard" use="required">
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:enumeration value="Fixed"/>
									<xs:enumeration value="EDIFACT"/>
									<xs:enumeration value="SCRIPT"/>
									<xs:enumeration value="TRADACOMS"/>
									<xs:enumeration value="X12"/>
									<xs:enumeration value="HL7"/>
									<xs:enumeration value="SWIFTMT"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:attribute>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Charset" minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Named character set for content parsing and validation with generic items</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Elements" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Definition of common elements used in EDI messages</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice maxOccurs="unbounded">
							<xs:element ref="Group"/>
							<xs:element ref="Segment"/>
							<xs:element ref="Composite"/>
							<xs:element ref="SubComposite"/>
							<xs:element ref="Data"/>
							<xs:element ref="ErrorList"/>
						</xs:choice>
					</xs:complexType>
				</xs:element>
				<xs:element name="GenericItems" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Definition of common generic elements (note: generic items cannot be mixed with traditional Elements)</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:choice maxOccurs="unbounded">
							<xs:element ref="Sequence" maxOccurs="unbounded"/>
							<xs:element ref="Choice"/>
							<xs:element ref="Data"/>
							<xs:element ref="SwiftField"/>
							<xs:element ref="SwiftFormat"/>
						</xs:choice>
					</xs:complexType>
				</xs:element>
				<xs:element name="Include" minOccurs="0" maxOccurs="unbounded">
					<xs:complexType>
						<xs:attribute name="collection" type="xs:string" use="optional"/>
						<xs:attribute name="href" type="xs:string" use="optional"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="Message" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Definition of a message type</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element name="MessageType" type="xs:string">
								<xs:annotation>
									<xs:documentation>e.g. "BALANC" or "850"</xs:documentation>
								</xs:annotation>
							</xs:element>
							<xs:element name="Completion" minOccurs="0">
								<xs:complexType>
									<xs:attribute name="singleConditions" type="xs:boolean" default="false"/>
									<xs:attribute name="singleValues" type="xs:boolean" default="false"/>
									<xs:attribute name="HL" type="xs:boolean" default="false"/>
								</xs:complexType>
							</xs:element>
							<xs:element name="Description" type="xs:string" minOccurs="0"/>
							<xs:element name="Revision" type="xs:nonNegativeInteger" minOccurs="0"/>
							<xs:element name="Date" type="xs:date" minOccurs="0"/>
							<xs:group ref="RootGroup"/>
						</xs:sequence>
						<xs:attribute name="root" type="xs:string"/>
					</xs:complexType>
				</xs:element>
				<xs:element name="Codelist" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Field" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Title" type="xs:string"/>
										<xs:element name="Description" type="xs:string"/>
										<xs:element name="Note" minOccurs="0" maxOccurs="unbounded"/>
										<xs:element name="Values">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="Value" maxOccurs="unbounded">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="Title" type="xs:string" minOccurs="0"/>
																<xs:element name="Description" type="xs:string" minOccurs="0"/>
															</xs:sequence>
															<xs:attribute name="Code" type="xs:string" use="required"/>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									<xs:attribute name="Name" type="xs:string" use="required"/>
									<xs:attribute name="Length" type="xs:nonNegativeInteger"/>
									<xs:attribute name="Offset" type="xs:nonNegativeInteger" default="0"/>
									<xs:attribute name="Incomplete" type="xs:boolean" default="0"/>
									<xs:attribute name="ListName" type="xs:string"/>
									<xs:attribute name="Type" type="xs:string"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="Rules" minOccurs="0">
					<xs:complexType>
						<xs:sequence maxOccurs="unbounded">
							<xs:element name="Rule">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Reference">
											<xs:complexType>
												<xs:attributeGroup ref="ReferenceAttributes"/>
											</xs:complexType>
										</xs:element>
										<xs:element name="Expression" type="ExpressionType"/>
									</xs:sequence>
									<xs:attribute name="validate" type="xs:boolean" default="true"/>
									<xs:attribute name="complete" type="xs:boolean" default="true"/>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:group ref="RootGroup"/>
			</xs:sequence>
			<xs:attribute name="Version" type="xs:positiveInteger" use="required" fixed="8"/>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="allNNI">
		<xs:annotation>
			<xs:documentation>for maxOccurs</xs:documentation>
		</xs:annotation>
		<xs:union memberTypes="xs:nonNegativeInteger">
			<xs:simpleType>
				<xs:restriction base="xs:NMTOKEN">
					<xs:enumeration value="unbounded"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:union>
	</xs:simpleType>
	<xs:attributeGroup name="occurs">
		<xs:annotation>
			<xs:documentation>for all particles</xs:documentation>
		</xs:annotation>
		<xs:attribute name="minOccurs" type="xs:nonNegativeInteger" use="optional" default="1"/>
		<xs:attribute name="maxOccurs" type="allNNI" use="optional" default="1"/>
		<xs:attribute name="nodeName" type="xs:string"/>
		<xs:attribute name="mergedEntries" type="xs:positiveInteger" default="1">
			<xs:annotation>
				<xs:documentation>This element stands for the specified number of consecutive identical entries.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:attributeGroup>
	<xs:attributeGroup name="StructAttributes">
		<xs:annotation>
			<xs:documentation>Common attributes for all structure elements</xs:documentation>
		</xs:annotation>
		<xs:attribute name="id" type="xs:string" use="optional"/>
		<xs:attribute name="name" type="xs:string"/>
		<xs:attribute name="ref" type="xs:string"/>
		<xs:attribute name="info" type="xs:string"/>
	</xs:attributeGroup>
	<xs:element name="Group" type="GroupType">
		<xs:annotation>
			<xs:documentation>Segment group or logical group</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="ErrorList" type="ErrorListType">
		<xs:annotation>
			<xs:documentation>Structure for reporting parser errors</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Select" type="SelectType">
		<xs:annotation>
			<xs:documentation>Select data element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Segment" type="SegmentType">
		<xs:annotation>
			<xs:documentation>Segment</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Composite" type="CompositeType">
		<xs:annotation>
			<xs:documentation>Composite data element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="SubComposite" type="SubCompositeType">
		<xs:annotation>
			<xs:documentation>SubComposite data element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Data" type="DataElementType">
		<xs:annotation>
			<xs:documentation>Simple or component data element</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Sequence" type="GenericContainerType">
		<xs:annotation>
			<xs:documentation>Generic sequence structure item</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Choice" type="GenericContainerType">
		<xs:annotation>
			<xs:documentation>Generic choice structure item</xs:documentation>
		</xs:annotation>
	</xs:element>
	<xs:element name="Constant">
		<xs:annotation>
			<xs:documentation>Generic constant</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attribute name="value" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:minLength value="1"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="Charset">
		<xs:annotation>
			<xs:documentation>Character set</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="Chars">
					<xs:complexType>
						<xs:attribute name="chars" type="xs:string"/>
						<xs:attribute name="from" type="xs:string"/>
						<xs:attribute name="to" type="xs:string"/>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Charset"/>
			</xs:choice>
			<xs:attributeGroup ref="StructAttributes"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="SwiftField">
		<xs:annotation>
			<xs:documentation>SWIFT field</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:complexContent>
				<xs:extension base="GenericContainerType">
					<xs:attribute name="tag" type="xs:string"/>
					<xs:attribute name="format" type="xs:string"/>
					<xs:attribute name="fixed" type="xs:string"/>
				</xs:extension>
			</xs:complexContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="SwiftFormat">
		<xs:annotation>
			<xs:documentation>SWIFT subfield</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:attributeGroup ref="StructAttributes"/>
			<xs:attributeGroup ref="occurs"/>
			<xs:attribute name="format" type="xs:string"/>
			<xs:attribute name="repetition-separator" type="xs:string"/>
			<xs:attribute name="fixed" type="xs:string"/>
			<xs:attribute name="type" type="xs:string"/>
		</xs:complexType>
	</xs:element>
	<!--Data Types-->
	<xs:complexType name="GroupType">
		<xs:annotation>
			<xs:documentation>Segment group or logical group</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="Condition" minOccurs="0"/>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element ref="Group"/>
				<xs:element ref="Segment"/>
				<xs:element ref="Select"/>
			</xs:choice>
		</xs:sequence>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
	</xs:complexType>
	<xs:complexType name="ErrorListType">
		<xs:annotation>
			<xs:documentation>ErrorList</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element ref="Group"/>
			<xs:element ref="Segment"/>
			<xs:element ref="Select"/>
		</xs:choice>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
	</xs:complexType>
	<xs:complexType name="SelectType">
		<xs:annotation>
			<xs:documentation>Select data element</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="Segment" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="type">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="Segment"/>
					<xs:enumeration value="Group"/>
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
		<xs:attribute name="field" type="xs:string" use="required"/>
		<xs:attribute name="prefix" type="xs:string"/>
	</xs:complexType>
	<xs:complexType name="SegmentType">
		<xs:annotation>
			<xs:documentation>Segment</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element ref="Condition" minOccurs="0"/>
			<xs:choice minOccurs="0" maxOccurs="unbounded">
				<xs:element name="Data">
					<xs:annotation>
						<xs:documentation>Simple or component data element</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:complexContent>
							<xs:extension base="DataElementType">
								<xs:attributeGroup ref="occurs"/>
							</xs:extension>
						</xs:complexContent>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Composite"/>
			</xs:choice>
		</xs:sequence>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
	</xs:complexType>
	<xs:complexType name="CompositeType">
		<xs:annotation>
			<xs:documentation>Composite data element</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element name="Data">
				<xs:annotation>
					<xs:documentation>Simple or component data element</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="DataElementType">
							<xs:attributeGroup ref="occurs"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element ref="SubComposite"/>
		</xs:choice>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
	</xs:complexType>
	<xs:complexType name="SubCompositeType">
		<xs:annotation>
			<xs:documentation>SubComposite data element</xs:documentation>
		</xs:annotation>
		<xs:sequence minOccurs="0" maxOccurs="unbounded">
			<xs:element name="Data">
				<xs:annotation>
					<xs:documentation>Simple or component data element</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="DataElementType">
							<xs:attributeGroup ref="occurs"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
	</xs:complexType>
	<xs:complexType name="DataElementType">
		<xs:annotation>
			<xs:documentation>Simple or component data element</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Values" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Value" maxOccurs="unbounded">
							<xs:complexType>
								<xs:sequence>
									<xs:element name="Title" type="xs:string" minOccurs="0"/>
									<xs:element name="Description" type="xs:string" minOccurs="0"/>
								</xs:sequence>
								<xs:attribute name="Code" type="xs:string" use="required"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Variable" minOccurs="0">
				<xs:complexType>
					<xs:attribute name="var" type="xs:string" use="required"/>
					<xs:attribute name="condition" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Rule" minOccurs="0">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Expression" type="ExpressionType"/>
					</xs:sequence>
					<xs:attribute name="validate" type="xs:boolean" default="true"/>
					<xs:attribute name="complete" type="xs:boolean" default="true"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attribute name="type" type="xs:string"/>
		<xs:attribute name="minLength" type="xs:nonNegativeInteger"/>
		<xs:attribute name="maxLength" type="xs:nonNegativeInteger"/>
		<xs:attribute name="implicitDecimals" type="xs:nonNegativeInteger"/>
		<xs:attribute name="charset" type="xs:string"/>
	</xs:complexType>
	<xs:element name="Condition">
		<xs:complexType>
			<xs:attribute name="path" type="xs:string" use="required"/>
			<xs:attribute name="value" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:complexType name="GenericContainerType">
		<xs:annotation>
			<xs:documentation>Generic container</xs:documentation>
		</xs:annotation>
		<xs:choice minOccurs="0" maxOccurs="unbounded">
			<xs:element ref="Sequence"/>
			<xs:element ref="Choice"/>
			<xs:element name="Data">
				<xs:annotation>
					<xs:documentation>Simple or component data element</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:complexContent>
						<xs:extension base="DataElementType">
							<xs:attributeGroup ref="occurs"/>
						</xs:extension>
					</xs:complexContent>
				</xs:complexType>
			</xs:element>
			<xs:element ref="Constant"/>
			<xs:element ref="SwiftField"/>
			<xs:element ref="SwiftFormat"/>
			<xs:element ref="Select"/>
		</xs:choice>
		<xs:attributeGroup ref="StructAttributes"/>
		<xs:attributeGroup ref="occurs"/>
		<xs:attribute name="repetition-separator" type="xs:string"/>
		<xs:attribute name="item-separator" type="xs:string"/>
		<xs:attribute name="type" type="xs:string"/>
	</xs:complexType>
	<xs:group name="RootGroup">
		<xs:annotation>
			<xs:documentation>Root of envelope or message</xs:documentation>
		</xs:annotation>
		<xs:choice>
			<xs:element ref="Group" minOccurs="0"/>
			<xs:element name="GenericRoot">
				<xs:annotation>
					<xs:documentation>Defines the root item if generic items are used</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:attribute name="ref" type="xs:string" use="required"/>
					<xs:attribute name="nodeName" type="xs:string"/>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:group>
	<xs:complexType name="ExpressionType">
		<xs:choice minOccurs="0">
			<xs:element ref="Constant"/>
			<xs:element name="Reference">
				<xs:complexType>
					<xs:attributeGroup ref="ReferenceAttributes"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Count">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Reference">
							<xs:complexType>
								<xs:attributeGroup ref="ReferenceAttributes"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:complexType>
	<xs:attributeGroup name="ReferenceAttributes">
		<xs:attribute name="name" type="xs:string" use="optional"/>
		<xs:attribute name="nameStarts" type="xs:string" use="optional"/>
		<xs:attribute name="nameEnds" type="xs:string" use="optional"/>
		<xs:attribute name="nameMatch" type="xs:string" use="optional"/>
		<xs:attribute name="node" type="xs:string" use="optional"/>
		<xs:attribute name="nodeStarts" type="xs:string" use="optional"/>
		<xs:attribute name="nodeEnds" type="xs:string" use="optional"/>
		<xs:attribute name="nodeMatch" type="xs:string" use="optional"/>
		<xs:attribute name="path" type="xs:string" use="optional"/>
		<xs:attribute name="pathStarts" type="xs:string" use="optional"/>
		<xs:attribute name="pathEnds" type="xs:string" use="optional"/>
	</xs:attributeGroup>
	<xs:group name="ExpressionGroup">
		<xs:choice>
			<xs:element ref="Constant"/>
			<xs:element name="Global">
				<xs:complexType>
					<xs:attribute name="name" type="xs:string"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Reference">
				<xs:complexType>
					<xs:attributeGroup ref="ReferenceAttributes"/>
				</xs:complexType>
			</xs:element>
			<xs:element name="Count">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Reference">
							<xs:complexType>
								<xs:attributeGroup ref="ReferenceAttributes"/>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
			<xs:element name="Call">
				<xs:complexType>
					<xs:sequence>
						<xs:element name="Parameters" minOccurs="0">
							<xs:complexType>
								<xs:sequence maxOccurs="unbounded">
									<xs:element name="Parameter" type="ExpressionType"/>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
					</xs:sequence>
				</xs:complexType>
			</xs:element>
		</xs:choice>
	</xs:group>
</xs:schema>