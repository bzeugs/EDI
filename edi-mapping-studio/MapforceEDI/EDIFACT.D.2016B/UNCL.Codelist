					<Description>The committed purchase quantity has not been ordered.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4343" Length="3" Type="Alphanumeric">
			<Title>Response type code</Title>
			<Description>Code specifying the type of acknowledgment required or transmitted.</Description>
			<Values>
				<Value Code="AA">
					<Title>Debit advice</Title>
					<Description>Receiver of the payment message needs to return a debit advice in response to the payment message.</Description>
				</Value>
				<Value Code="AB">
					<Title>Message acknowledgement</Title>
					<Description>Indicates that an acknowledgement relating to receipt of message is required.</Description>
				</Value>
				<Value Code="AC">
					<Title>Acknowledge - with detail and change</Title>
					<Description>Acknowledge complete including changes.</Description>
				</Value>
				<Value Code="AD">
					<Title>Acknowledge - with detail, no change</Title>
					<Description>Acknowledge complete without changes.</Description>
				</Value>
				<Value Code="AE">
					<Title>Debit advice for each transaction</Title>
					<Description>A debit advice is requested for each transaction in the message.</Description>
				</Value>
				<Value Code="AF">
					<Title>Debit advice/message acknowledgement</Title>
					<Description>The sender wishes to receive both a Debit Advice and an acknowledgement of receipt for a payment message.</Description>
				</Value>
				<Value Code="AG">
					<Title>Authentication</Title>
					<Description>Authentication, by a party, of a document established for him by another party.</Description>
				</Value>
				<Value Code="AH">
					<Title>Debit advice/message acknowledgement for each transaction</Title>
					<Description>A debit advice and message acknowledgement are requested for each transaction in the message.</Description>
				</Value>
				<Value Code="AI">
					<Title>Acknowledge only changes</Title>
					<Description>Acknowledgement of changes only is required.</Description>
				</Value>
				<Value Code="AJ">
					<Title>Pending</Title>
					<Description>Indication that the referenced offer or transaction (e.g. cargo booking or quotation request) is being dealt with.</Description>
				</Value>
				<Value Code="AK">
					<Title>Return only TIR transport information</Title>
					<Description>The sender of the message expects only TIR (Transports Internationaux Routiers) transport information in return.</Description>
				</Value>
				<Value Code="AL">
					<Title>Return only declaration information</Title>
					<Description>Desc The sender of the message expects only declaration information in return.</Description>
				</Value>
				<Value Code="AM">
					<Title>Return only guarantee information</Title>
					<Description>The sender of the message expects only guarantee information in return.</Description>
				</Value>
				<Value Code="AN">
					<Title>Return all information regarding guarantee</Title>
					<Description>The sender of the message expects all information regarding the guarantee in return.</Description>
				</Value>
				<Value Code="AP">
					<Title>Accepted</Title>
					<Description>Indication that the referenced offer or transaction (e.g., cargo booking or quotation request) has been accepted.</Description>
				</Value>
				<Value Code="AQ">
					<Title>Response expected</Title>
					<Description>The sender of the message expects a response.</Description>
				</Value>
				<Value Code="AR">
					<Title>Direct documentary credit collection</Title>
					<Description>Documentary credit collection forwarded directly.</Description>
				</Value>
				<Value Code="AS">
					<Title>Credit advice and message acknowledgement</Title>
					<Description>The receiver of the message is to acknowledge receipt of the message and sent a credit advice for each credit.</Description>
				</Value>
				<Value Code="CA">
					<Title>Conditionally accepted</Title>
					<Description>Indication that the referenced offer or transaction (e.g., cargo booking or quotation request) has been accepted under conditions indicated in this message.</Description>
				</Value>
				<Value Code="CO">
					<Title>Confirmation of measurements</Title>
					<Description>Indication that the message contains the physical measurements on which the charges will be based.</Description>
				</Value>
				<Value Code="NA">
					<Title>No acknowledgement needed</Title>
					<Description>Specifies that no acknowledgement is needed in response to this message.</Description>
				</Value>
				<Value Code="RE">
					<Title>Rejected</Title>
					<Description>Indication that the referenced offer or transaction (e.g., cargo booking or quotation request) is not accepted.</Description>
				</Value>
				<Value Code="UR">
					<Title>Credit advice</Title>
					<Description>The message recipient is to send a credit advice in response to the message.</Description>
				</Value>
				<Value Code="US">
					<Title>Acknowledgement when error</Title>
					<Description>An acknowledgement is requested when an error occurred.</Description>
				</Value>
				<Value Code="UT">
					<Title>Acknowledgment due to error</Title>
					<Description>An acknowledgment is sent because an error was identified in the received message.</Description>
				</Value>
				<Value Code="UU">
					<Title>Alternate date</Title>
					<Description>The solution proposed in the response applies to another date than the one requested.</Description>
				</Value>
				<Value Code="UV">
					<Title>Alternate service</Title>
					<Description>The solution proposed in the response applies to another service than the one requested.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4347" Length="3" Type="Alphanumeric">
			<Title>Product identifier code qualifier</Title>
			<Description>Code qualifying the product identifier.</Description>
			<Values>
				<Value Code="1">
					<Title>Additional identification</Title>
					<Description>Information which specifies and qualifies product identifications.</Description>
				</Value>
				<Value Code="2">
					<Title>Identification for potential substitution</Title>
					<Description>The item number describes the potential substitute product.</Description>
				</Value>
				<Value Code="3">
					<Title>Substituted by</Title>
					<Description>The given item number is the number of the product that substitutes another one.</Description>
				</Value>
				<Value Code="4">
					<Title>Substituted for</Title>
					<Description>The given item number is the number of the original product substituted by another.</Description>
				</Value>
				<Value Code="5">
					<Title>Product identification</Title>
					<Description>The item number is for product identification.</Description>
				</Value>
				<Value Code="6">
					<Title>Successor product id</Title>
					<Description>Product id of the product that will follow the one currently in production/trade.</Description>
				</Value>
				<Value Code="7">
					<Title>Predecessor product id</Title>
					<Description>Product id of the predecessor of the product currently in production/trade.</Description>
				</Value>
				<Value Code="8">
					<Title>Expired/out of production</Title>
					<Description>The given item number is the expired item number of the product. It has been replaced.</Description>
				</Value>
				<Value Code="9">
					<Title>Deletion of secondary identification</Title>
					<Description>Code indicating the deletion of a secondary identification.</Description>
				</Value>
				<Value Code="10">
					<Title>Defective part's identification</Title>
					<Description>Identification of a defective part.</Description>
				</Value>
				<Value Code="11">
					<Title>Repaired part's identification</Title>
					<Description>Identification of a repaired part.</Description>
				</Value>
				<Value Code="12">
					<Title>Alternate product identification</Title>
					<Description>Alternate number to identify the product.</Description>
				</Value>
				<Value Code="13">
					<Title>Non-promotional item</Title>
					<Description>Used to indicate which trade item the promotional trade item replaces or coexists alongside. To enable the identification of the two trade items to be linked providing access to their information.</Description>
				</Value>
				<Value Code="14">
					<Title>Must buy product in multi-buy promotion</Title>
					<Description>A code identifying a product which must be bought in order to qualify for a multi-buy promotion.</Description>
				</Value>
				<Value Code="15">
					<Title>Discount product in a multi-buy promotion</Title>
					<Description>A code identifying a product for which a discount is being offered in a multi-buy promotion.</Description>
				</Value>
				<Value Code="16">
					<Title>Deletion of additional identification or identification for</Title>
					<Description>substitution Code indicating the deletion of an additional or substitute product identification.</Description>
				</Value>
			</Values>
		</Field>
