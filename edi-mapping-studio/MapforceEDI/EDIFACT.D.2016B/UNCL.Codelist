		<Field Name="F4471" Length="3" Type="Alphanumeric">
			<Title>Settlement means code</Title>
			<Description>Code specifying the means of settlement.</Description>
			<Values>
				<Value Code="1">
					<Title>Bill back</Title>
					<Description>Refers to a charge or allowance for the buyer and the buyer will bill back the seller.</Description>
				</Value>
				<Value Code="2">
					<Title>Off invoice</Title>
					<Description>The allowance or charge is being deducted from the invoice.</Description>
				</Value>
				<Value Code="3">
					<Title>Vendor check to customer</Title>
					<Description>An allowance will be given to a customer from the supplier in the form of a check.</Description>
				</Value>
				<Value Code="4">
					<Title>Credit customer account</Title>
					<Description>An allowance will be processed for the customer by giving a credit to their account.</Description>
				</Value>
				<Value Code="5">
					<Title>Charge to be paid by vendor</Title>
					<Description>A charge whose payment will be made by the vendor.</Description>
				</Value>
				<Value Code="6">
					<Title>Charge to be paid by customer</Title>
					<Description>A charge whose payment will be made by the customer.</Description>
				</Value>
				<Value Code="7">
					<Title>Optional</Title>
					<Description>The settlement of charges is not obligatory.</Description>
				</Value>
				<Value Code="8">
					<Title>Off gross quantity invoiced</Title>
					<Description>Allowance as relates to the gross quantity invoiced.</Description>
				</Value>
				<Value Code="9">
					<Title>Electric cost recovery factor</Title>
					<Description>An allowance as it relates to the electric cost recovery factor.</Description>
				</Value>
				<Value Code="10">
					<Title>Gas cost recovery factor</Title>
					<Description>An allowance as it relates to the gas cost recovery factor.</Description>
				</Value>
				<Value Code="11">
					<Title>Prior credit balance</Title>
					<Description>A settlement was made using a previous credit balance.</Description>
				</Value>
				<Value Code="12">
					<Title>Non-dutiable</Title>
					<Description>Reference to an allowance or charge as being free for Customs duty computation purposes.</Description>
				</Value>
				<Value Code="13">
					<Title>All charges borne by payee</Title>
					<Description>All charges are to be borne by the funds receiver.</Description>
				</Value>
				<Value Code="14">
					<Title>Each pay own cost</Title>
					<Description>Each party are to be responsible for its own charges.</Description>
				</Value>
				<Value Code="15">
					<Title>All charges borne by payer</Title>
					<Description>All charges are to be borne by the funds sender.</Description>
				</Value>
				<Value Code="16">
					<Title>All bank charges to be borne by applicant</Title>
					<Description>All bank charges associated with a documentary credit are to be borne by the applicant.</Description>
				</Value>
				<Value Code="17">
					<Title>All bank charges except confirmation commission to be borne</Title>
					<Description>by applicant All bank charges associated with a documentary credit except confirmation commission are to borne by the applicant.</Description>
				</Value>
				<Value Code="18">
					<Title>All bank charges to be borne by beneficiary</Title>
					<Description>All bank charges associated with a documentary credit are to be borne by the beneficiary.</Description>
				</Value>
				<Value Code="19">
					<Title>Total payment borne by project</Title>
					<Description>The total payment is borne by the project.</Description>
				</Value>
				<Value Code="20">
					<Title>Amendment charges to be borne by applicant</Title>
					<Description>Documentary credit amendment charges are to be borne by the applicant.</Description>
				</Value>
				<Value Code="21">
					<Title>Amendment charges to be borne by beneficiary</Title>
					<Description>Documentary credit amendment charges are to be borne by the beneficiary.</Description>
				</Value>
				<Value Code="22">
					<Title>Discount charges to be borne by applicant</Title>
					<Description>Documentary credit discount charges are to be borne by the applicant.</Description>
				</Value>
				<Value Code="23">
					<Title>Discount charges to be borne by beneficiary</Title>
					<Description>Documentary credit discount charges are to be borne by the beneficiary.</Description>
				</Value>
				<Value Code="24">
					<Title>All bank charges other than those of the issuing bank to be</Title>
					<Description>borne by beneficiary All bank charges associated with a documentary credit other than those of the issuing bank are to be borne by the beneficiary.</Description>
				</Value>
				<Value Code="25">
					<Title>Amendment charges other than those of the issuing bank to</Title>
					<Description>be borne by beneficiary All charges associated with the amendment other than those of the issuing bank are to be borne by the beneficiary.</Description>
				</Value>
				<Value Code="26">
					<Title>All charges to be paid by the principal of the collection</Title>
					<Description>All charges are to be paid by the principal of the collection.</Description>
				</Value>
				<Value Code="27">
					<Title>All charges to be paid by the drawee of the collection</Title>
					<Description>All charges are to be paid by the drawee of the collection.</Description>
				</Value>
				<Value Code="28">
					<Title>All charges to be borne by the drawee except those levied</Title>
					<Description>by the remitting bank, to be paid by principal All charges are to be borne by the drawee except those levied by the remitting bank, which are to be paid by the principal.</Description>
				</Value>
				<Value Code="29">
					<Title>All bank charges are to be paid by the principal of the</Title>
					<Description>documentary credit collection All bank charges are to be paid by the principal of the documentary credit collection.</Description>
				</Value>
				<Value Code="30">
					<Title>All bank charges to be borne by receiving bank</Title>
					<Description>All bank charges are to be borne by the receiving bank.</Description>
				</Value>
				<Value Code="31">
					<Title>All bank charges to be borne by sending bank</Title>
					<Description>All bank charges are to be borne by the sending bank.</Description>
				</Value>
				<Value Code="32">
					<Title>Charges levied by a third bank</Title>
					<Description>Charges levied by a third bank.</Description>
				</Value>
				<Value Code="33">
					<Title>Information charges levied by a third bank</Title>
					<Description>Charges levied by a third bank for providing information.</Description>
				</Value>
				<Value Code="34">
					<Title>Total payment borne by patient</Title>
					<Description>The total payment is borne by the patient.</Description>
				</Value>
				<Value Code="35">
					<Title>Part payment borne by patient</Title>
					<Description>The part payment is borne by the patient.</Description>
				</Value>
				<Value Code="36">
					<Title>No charge to patient</Title>
					<Description>No charges to be paid by the patient.</Description>
				</Value>
				<Value Code="37">
					<Title>Divided according to national health service rules</Title>
					<Description>Charge is divided between parties according to national health service rules.</Description>
				</Value>
				<Value Code="38">
					<Title>Item accruals</Title>
					<Description>Expenses related to an item for which invoices have not been received yet at the end of the current acounting period.</Description>
				</Value>
				<Value Code="39">
					<Title>Vendor accruals</Title>
					<Description>Expenses related to a vendor for which invoices have not been received yet at the end of the current accounting period.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code reserved for special trading partner requirements when pre-defined codes do not exist.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4475" Length="17" Type="Alphanumeric">
			<Title>Accounting entry type name code</Title>
