			<Values>
				<Value Code="1">
					<Title>Purchase</Title>
					<Description>The type of accounting entry is purchase.</Description>
				</Value>
				<Value Code="2">
					<Title>Sale</Title>
					<Description>The type of accounting entry is sale.</Description>
				</Value>
				<Value Code="3">
					<Title>Cash</Title>
					<Description>The type of accounting entry is cash.</Description>
				</Value>
				<Value Code="4">
					<Title>Opening balance</Title>
					<Description>The type of accounting entry is opening balance.</Description>
				</Value>
				<Value Code="5">
					<Title>Miscellaneous</Title>
					<Description>The type is a miscellaneous accounting entry.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4487" Length="3" Type="Alphanumeric">
			<Title>Financial transaction type code</Title>
			<Description>Code specifying a type of financial transaction.</Description>
			<Values>
				<Value Code="1">
					<Title>Clean payment</Title>
					<Description>Payment under open account terms.</Description>
				</Value>
				<Value Code="2">
					<Title>Pre-authorised direct debit or direct debit request</Title>
					<Description>The transaction is a pre-authorised direct debit or direct debit request, i.e. a direct debit for which there is an agreed mandate that allows the creditor to draw funds from the debtor.</Description>
				</Value>
				<Value Code="3">
					<Title>Non pre-authorised direct debit or direct debit request</Title>
					<Description>The transaction is a non pre-authorised direct debit or direct debit request, i.e. a direct debit for which there is no prior agreed mandate allowing the creditor to draw funds from the debtor.</Description>
				</Value>
				<Value Code="4">
					<Title>Documentary payment</Title>
					<Description>Payment relating to a documentary settlement.</Description>
				</Value>
				<Value Code="5">
					<Title>Irrevocable documentary credit</Title>
					<Description>The documentary credit is irrevocable.</Description>
				</Value>
				<Value Code="6">
					<Title>Revocable documentary credit</Title>
					<Description>The documentary credit is revocable.</Description>
				</Value>
				<Value Code="7">
					<Title>Irrevocable and transferable documentary credit</Title>
					<Description>The documentary credit is irrevocable and may be transferred to a second beneficiary.</Description>
				</Value>
				<Value Code="8">
					<Title>Revocable and transferable documentary credit</Title>
					<Description>The documentary credit is revocable and may be transferred to a second beneficiary.</Description>
				</Value>
				<Value Code="9">
					<Title>Revocable and transferable standby letter of credit</Title>
					<Description>Revocable and transferable standby letter of credit.</Description>
				</Value>
				<Value Code="10">
					<Title>Irrevocable and transferable standby letter of credit</Title>
					<Description>Irrevocable and transferable standby letter of credit.</Description>
				</Value>
				<Value Code="11">
					<Title>Revocable standby letter of credit</Title>
					<Description>Revocable standby letter of credit.</Description>
				</Value>
				<Value Code="12">
					<Title>Irrevocable standby letter of credit</Title>
					<Description>Irrevocable standby letter of credit.</Description>
				</Value>
				<Value Code="13">
					<Title>Pre-advised direct debit</Title>
					<Description>The transaction is a direct debit about which the debtor has advised his bank prior to the creditor raising the direct debit, giving his bank permission to debit his account.</Description>
				</Value>
				<Value Code="14">
					<Title>Non pre-advised direct debit</Title>
					<Description>The transaction is a direct debit about which the debtor has not advised his bank prior to the creditor raising the direct debit.</Description>
				</Value>
				<Value Code="15">
					<Title>Irrevocable reimbursement of cash withdrawal</Title>
					<Description>The transaction is an irrevocable direct debit, from bank A to bank B, which reimburses bank A that has by agreement provided cash to a customer of bank B.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4493" Length="3" Type="Alphanumeric">
			<Title>Delivery instruction code</Title>
			<Description>Code specifying a delivery instruction.</Description>
			<Values>
				<Value Code="AA">
					<Title>Ship on authorization</Title>
					<Description>A delivery requirement indicating the items should not be shipped without specific authorization.</Description>
				</Value>
				<Value Code="BK">
					<Title>Ship partial - balance back order</Title>
					<Description>Partial shipping is allowed. The rest of the order should be delivered as soon as possible.</Description>
				</Value>
				<Value Code="CD">
					<Title>Cancel if not delivered by date</Title>
					<Description>An order or the rest of an order should be cancelled if not delivered at specified date.</Description>
				</Value>
				<Value Code="DA">
					<Title>Do not deliver after</Title>
					<Description>A requirement that an order should not be delivered after a specified date/time.</Description>
				</Value>
				<Value Code="DB">
					<Title>Do not deliver before</Title>
					<Description>A requirement that an order should not be delivered before a specified date/time.</Description>
				</Value>
				<Value Code="DD">
					<Title>Deliver on date</Title>
					<Description>An order should be delivered exactly on specified date.</Description>
				</Value>
				<Value Code="IS">
					<Title>Substitute item</Title>
					<Description>A substitute item may be delivered, if the ordered item is not available.</Description>
				</Value>
				<Value Code="P1">
					<Title>No schedule established</Title>
					<Description>No specified date/time for delivery.</Description>
				</Value>
				<Value Code="P2">
					<Title>Ship as soon as possible</Title>
					<Description>The order should be delivered as soon as possible.</Description>
				</Value>
				<Value Code="SC">
					<Title>Ship complete order</Title>
					<Description>The order should be delivered only complete, not partial.</Description>
				</Value>
				<Value Code="SF">
					<Title>Ship partial, if no freight rate increase</Title>
					<Description>Partial shipping of an order is allowed, if the total freight rate do not increase.</Description>
				</Value>
				<Value Code="SP">
					<Title>Ship partial - balance cancel</Title>
					<Description>Partial shipping is allowed. The rest of the order should be cancelled.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4499" Length="3" Type="Alphanumeric">
			<Title>Inventory movement reason code</Title>
			<Description>Code specifying the reason for an inventory movement.</Description>
			<Values>
				<Value Code="1">
					<Title>Reception</Title>
					<Description>Goods received at warehouse from another party or warehouse.</Description>
				</Value>
				<Value Code="2">
					<Title>Delivery</Title>
					<Description>Goods which have been delivered from the inventory to another party or warehouse.</Description>
				</Value>
				<Value Code="3">
					<Title>Scrapped parts</Title>
					<Description>Adjustment due to scrapped parts.</Description>
				</Value>
				<Value Code="4">
					<Title>Difference</Title>
					<Description>The difference between the inventory, as physically counted, and the inventory recorded by the system.</Description>
				</Value>
				<Value Code="5">
					<Title>Property transfer within warehouse</Title>
					<Description>An inventory movement issued when goods are moved (physically or logically) from one owner to another, whenever inventories are held in account of several owners of the same product within the same warehouse.</Description>
				</Value>
				<Value Code="6">
					<Title>Inventory recycling</Title>
					<Description>This inventory movement is due to recycling of goods. For instance, defective goods have been repaired and are put back to the available inventory.</Description>
				</Value>
				<Value Code="7">
					<Title>Reversal of previous movement</Title>
					<Description>This inventory movement is issued to cancel a previously processed movement.</Description>
				</Value>
				<Value Code="8">
					<Title>Defects (technical)</Title>
					<Description>This inventory movement corresponds to parts with technical defect.</Description>
				</Value>
				<Value Code="9">
					<Title>Commercial</Title>
					<Description>The inventory movement has been issued for commercial reasons.</Description>
				</Value>
				<Value Code="10">
					<Title>Conversion</Title>
					<Description>The inventory movement is due to conversion of goods.</Description>
				</Value>
				<Value Code="11">
					<Title>Consumption</Title>
					<Description>The inventory movement corresponds to goods taken out of consigned inventory for consumption.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4501" Length="3" Type="Alphanumeric">
			<Title>Inventory movement direction code</Title>
			<Description>Code specifying the direction of an inventory movement.</Description>
			<Values>
				<Value Code="1">
					<Title>Movement out of inventory</Title>
					<Description>Outgoing goods.</Description>
				</Value>
				<Value Code="2">
					<Title>Movement into inventory</Title>
					<Description>Incoming goods.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4503" Length="3" Type="Alphanumeric">
			<Title>Inventory balance method code</Title>
			<Description>Code specifying the method used to establish an inventory balance.</Description>
			<Values>
				<Value Code="1">
					<Title>Book-keeping inventory balance</Title>
					<Description>An inventory balance resulting from the book-keeping.</Description>
				</Value>
				<Value Code="2">
					<Title>Formal inventory balance</Title>
					<Description>An inventory balance in accordance with the formal inventory procedure.</Description>
				</Value>
				<Value Code="3">
					<Title>Interim inventory balance</Title>
					<Description>An inventory balance resulting from an interim counting.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4505" Length="3" Type="Alphanumeric">
