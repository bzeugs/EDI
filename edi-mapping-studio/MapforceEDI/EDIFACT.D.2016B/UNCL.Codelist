					<Description>Issue a cheque not endorsable in payment of the funds.</Description>
				</Value>
				<Value Code="93">
					<Title>Reference giro</Title>
					<Description>Ordering customer tells the bank to use the payment system 'Reference giro'. Used in the Finnish national banking system.</Description>
				</Value>
				<Value Code="94">
					<Title>Urgent giro</Title>
					<Description>Ordering customer tells the bank to use the bank service 'Urgent Giro' when transferring the payment. Used in Finnish national banking system.</Description>
				</Value>
				<Value Code="95">
					<Title>Free format giro</Title>
