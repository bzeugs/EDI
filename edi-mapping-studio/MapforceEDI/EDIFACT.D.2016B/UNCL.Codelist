					<Title>Radio modulation type</Title>
					<Description>The type of modulation used for radio communication equipment.</Description>
				</Value>
				<Value Code="233">
					<Title>Radio frequency output power</Title>
					<Description>The actual amount of power of radio frequency energy that a transmitter produces at its output.</Description>
				</Value>
				<Value Code="234">
					<Title>Radiated Spurious Emission (RSE)</Title>
					<Description>Measure of the transmitted signal which is unwanted.</Description>
				</Value>
				<Value Code="235">
					<Title>Frequency stability</Title>
					<Description>The ability of an oscillator to maintain a desired frequency; usually expressed as percent deviation from the assigned frequency value.</Description>
				</Value>
				<Value Code="236">
					<Title>Frequency deviation limiting ability</Title>
					<Description>The ability of the equipment preventing it from deviating from its frequency.</Description>
				</Value>
