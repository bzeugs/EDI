			<Values>
				<Value Code="1">
					<Title>Heat sensitive</Title>
					<Description>The object is heat sensitive.</Description>
				</Value>
				<Value Code="2">
					<Title>Store in dry environment</Title>
					<Description>The object must be stored in dry environment.</Description>
				</Value>
				<Value Code="3">
					<Title>Stacked</Title>
					<Description>The identified item is, or can be stacked.</Description>
				</Value>
				<Value Code="4">
					<Title>Mooring to be arranged</Title>
					<Description>Request to arrange boatmen to (de)moor the vessel at the berth.</Description>
				</Value>
				<Value Code="5">
					<Title>Mooring arranged</Title>
					<Description>Information that the boatmen to (de)moor the vessel at the berth are already arranged.</Description>
				</Value>
				<Value Code="6">
					<Title>Pilotage to be arranged</Title>
					<Description>Request to arrange the pilotage for the vessel.</Description>
				</Value>
				<Value Code="7">
					<Title>Pilotage arranged</Title>
					<Description>Information that pilotage for the vessel is already arranged.</Description>
				</Value>
				<Value Code="8">
					<Title>Berth towage to be arranged</Title>
