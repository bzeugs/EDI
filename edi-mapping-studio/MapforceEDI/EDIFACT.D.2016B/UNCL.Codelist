		<Field Name="F3279" Length="3" Type="Alphanumeric">
			<Title>Geographic area code</Title>
			<Description>Code specifying a geographical area.</Description>
			<Values>
				<Value Code="DO">
					<Title>Domestic</Title>
					<Description>Domestic message as defined by relevant central bank.</Description>
				</Value>
				<Value Code="DR">
					<Title>Domestic with regulatory information required</Title>
					<Description>Domestic message with requirement to regulatory information to central bank.</Description>
				</Value>
				<Value Code="EA">
					<Title>Economic area</Title>
					<Description>Message crossing at least one national boundary but confined within a specific economic area (e.g. EC, EFTA ...).</Description>
				</Value>
				<Value Code="IN">
					<Title>International</Title>
					<Description>International message as defined by relevant central bank.</Description>
				</Value>
				<Value Code="IR">
					<Title>International with regulatory information required</Title>
					<Description>International message with requirement to regulatory information to central bank.</Description>
				</Value>
				<Value Code="IS">
					<Title>European Union</Title>
					<Description>To identify the message as originating from and destined to a member state of the European Union.</Description>
				</Value>
				<Value Code="SPA">
					<Title>SEPA (Single Euro Payments Area) ID A</Title>
					<Description>SEPA message following EBA (EURO Banking Association) scheme 1, i.e. used for SEPA Credit Transfers / SEPA Direct Debits.</Description>
				</Value>
				<Value Code="SPB">
					<Title>SEPA (Single Euro Payments Area) ID B</Title>
					<Description>SEPA message following scheme 2 as defined by EBA (EURO Banking Association).</Description>
				</Value>
				<Value Code="SPC">
					<Title>SEPA (Single Euro Payments Area) ID C</Title>
					<Description>SEPA message following scheme 3 as defined by EBA (EURO Banking 	Association).</Description>
				</Value>
				<Value Code="SPD">
					<Title>SEPA (Single Euro Payments Area) ID D</Title>
					<Description>SEPA message following scheme 4 as defined by EBA (EURO Banking 	Association).</Description>
				</Value>
			</Values>
		</Field>
