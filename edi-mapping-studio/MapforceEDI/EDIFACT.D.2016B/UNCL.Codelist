		<Field Name="F4463" Length="3" Type="Alphanumeric">
			<Title>Intra-company payment indicator code</Title>
			<Description>Code indicating an intra-company payment.</Description>
			<Values>
				<Value Code="1">
					<Title>Intra-company payment</Title>
					<Description>Moving funds between accounts, where the account owner is one company or belonging to a group of companies.</Description>
