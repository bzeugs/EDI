				<Value Code="PB">
					<Title>Postbox number</Title>
					<Description>The communication number identifies a postbox.</Description>
				</Value>
				<Value Code="PS">
					<Title>Packet switching</Title>
					<Description>The process of routing and transferring data by means of addressed packets so that a channel is occupied only during the transmission; upon completion of the transmission the channel is made available for the transfer of other packets (ISO).</Description>
				</Value>
				<Value Code="SW">
					<Title>S.W.I.F.T.</Title>
					<Description>Communications address assigned by Society for Worldwide Interbank Financial Telecommunications s.c.</Description>
