					<Title>Penalty payment</Title>
					<Description>The formula for the calculation of a penalty payment.</Description>
				</Value>
				<Value Code="3">
					<Title>Coefficient</Title>
					<Description>The formula for a coefficient calculation.</Description>
				</Value>
				<Value Code="4">
					<Title>Catalogue adjustment</Title>
					<Description>The formula to adjust a catalogue.</Description>
				</Value>
				<Value Code="5">
					<Title>Ceiling amount</Title>
					<Description>The formula for the calculation of a ceiling amount.</Description>
