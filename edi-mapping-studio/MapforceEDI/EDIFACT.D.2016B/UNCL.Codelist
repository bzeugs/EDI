					<Description>Loaded with empty 4-block for blocking purposes.</Description>
				</Value>
				<Value Code="2">
					<Title>Empty container with dunnage</Title>
					<Description>The container is, has been, or will be returned with dunnage only.</Description>
				</Value>
				<Value Code="3">
					<Title>Empty container</Title>
					<Description>The container is, has been, or will be returned empty.</Description>
				</Value>
				<Value Code="4">
					<Title>Loaded with production material</Title>
					<Description>The package is, has been, or will be returned loaded with production material.</Description>
				</Value>
				<Value Code="6">
					<Title>Obsolete material</Title>
					<Description>The package is, has been, or will be returned loaded with obsolete material.</Description>
				</Value>
				<Value Code="7">
					<Title>Loaded with excess returned production material</Title>
					<Description>The package is, has been, or will be returned loaded with excess production material.</Description>
				</Value>
				<Value Code="8">
					<Title>Loaded with rejected material</Title>
					<Description>The package is, has been, or will be returned loaded with rejected material.</Description>
				</Value>
				<Value Code="10">
					<Title>Loaded with returned processed material</Title>
					<Description>The package is, has been, or will be returned loaded with processed material.</Description>
