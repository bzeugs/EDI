					<Description>The payment terms are based on a contract with a vendor.</Description>
				</Value>
				<Value Code="46">
					<Title>Credit controlled</Title>
					<Description>The payment terms involve the monitoring of credit by the grantor.</Description>
				</Value>
				<Value Code="47">
