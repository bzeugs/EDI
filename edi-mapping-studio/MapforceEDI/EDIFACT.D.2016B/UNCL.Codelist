					<Description>Assigned priority in reporting an event.</Description>
				</Value>
				<Value Code="6">
					<Title>Delivery priority</Title>
					<Description>The delivery priority of an object.</Description>
				</Value>
				<Value Code="7">
					<Title>Requested priority</Title>
					<Description>The priority that is requested.</Description>
				</Value>
				<Value Code="8">
					<Title>Allocated priority</Title>
					<Description>The priority that is allocated.</Description>
				</Value>
				<Value Code="9">
					<Title>Prescription dispensing priority</Title>
					<Description>Assigned priority in dispensing a prescription.</Description>
				</Value>
				<Value Code="10">
					<Title>Disconnectability</Title>
					<Description>Priority for when an installation can be disconnected.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4037" Length="3" Type="Alphanumeric">
			<Title>Priority description code</Title>
			<Description>Code specifying a priority.</Description>
			<Values>
				<Value Code="1">
					<Title>Immediate</Title>
					<Description>To be done immediately.</Description>
				</Value>
				<Value Code="2">
					<Title>Urgent</Title>
					<Description>To be performed before any non-urgent task.</Description>
				</Value>
				<Value Code="3">
					<Title>Normal</Title>
					<Description>To be done as routine work.</Description>
				</Value>
				<Value Code="4">
					<Title>Scheduled</Title>
					<Description>To be done as part of a scheduled plan.</Description>
				</Value>
				<Value Code="5">
					<Title>Category A</Title>
					<Description>Priority is category A.</Description>
				</Value>
				<Value Code="6">
					<Title>Category B</Title>
					<Description>Priority is category B.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4043" Length="3" Type="Alphanumeric">
			<Title>Trade class code</Title>
			<Description>Code identifying the class of trade.</Description>
			<Values>
				<Value Code="AA">
					<Title>Financial service provider</Title>
					<Description>A manager of money or other assets.</Description>
				</Value>
				<Value Code="AB">
					<Title>Importer</Title>
					<Description>A person or group that imports goods or services.</Description>
				</Value>
				<Value Code="AC">
					<Title>Vendor</Title>
					<Description>A person or group selling goods or services.</Description>
				</Value>
				<Value Code="AD">
					<Title>Exporter</Title>
					<Description>A person or group who sends goods or services to a foreign country.</Description>
				</Value>
				<Value Code="AE">
					<Title>Contractor</Title>
					<Description>A person or group acting as a contractor.</Description>
				</Value>
				<Value Code="AG">
					<Title>Agency</Title>
					<Description>A party or group that acts as an agent on behalf of another party.</Description>
				</Value>
				<Value Code="BG">
					<Title>Buying group</Title>
					<Description>A temporary group of buyers formed for purchasing purposes.</Description>
				</Value>
				<Value Code="BR">
					<Title>Broker</Title>
					<Description>A person or group acting as an agent for others, accepting responsibility in return for a fee.</Description>
				</Value>
				<Value Code="CN">
					<Title>Consolidator (master distributor)</Title>
					<Description>A person or group acting as a clearing house for goods or services.</Description>
				</Value>
				<Value Code="DE">
					<Title>Dealer</Title>
					<Description>A person or group buying directly from a manufacturer for resale.</Description>
				</Value>
				<Value Code="DI">
					<Title>Distributor</Title>
					<Description>A person or group acting explicitly as distributor of merchandise or goods.</Description>
				</Value>
				<Value Code="JB">
					<Title>Jobber</Title>
					<Description>A person or group buying merchandise to resell it to a retailer.</Description>
				</Value>
				<Value Code="MF">
					<Title>Manufacturer</Title>
					<Description>A company that produces goods from raw materials.</Description>
				</Value>
				<Value Code="OE">
					<Title>OEM (Original equipment manufacturer)</Title>
					<Description>A manufacturer selling its goods to a company reselling them using own labels.</Description>
				</Value>
				<Value Code="RS">
					<Title>Resale</Title>
					<Description>A class of trade where goods and/or services are purchased for resale.</Description>
				</Value>
				<Value Code="RT">
					<Title>Retailer</Title>
					<Description>A person selling goods or services in small quantities or by the piece.</Description>
				</Value>
				<Value Code="ST">
					<Title>Stationer</Title>
					<Description>The trade has a classification of stationer.</Description>
				</Value>
				<Value Code="WH">
					<Title>Wholesaler</Title>
					<Description>A person or group buying goods in large quantities for resale by a retailer.</Description>
				</Value>
				<Value Code="WS">
					<Title>User</Title>
					<Description>Identifies the end-user of goods or services.</Description>
				</Value>
				<Value Code="WT">
					<Title>Out patient</Title>
					<Description>A patient not under the full time care of a hospital but visits from time to time for treatment.</Description>
				</Value>
				<Value Code="WU">
					<Title>In patient</Title>
					<Description>A patient under the full time care of a hospital.</Description>
				</Value>
				<Value Code="WV">
					<Title>Electricity exchange</Title>
					<Description>Identifies the exchange where the intermediaries sell and buy electricity.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4049" Length="3" Type="Alphanumeric">
			<Title>Certainty description code</Title>
			<Description>Code specifying a certainty.</Description>
			<Values>
				<Value Code="1">
					<Title>Connection guaranteed</Title>
					<Description>The connection is guaranteed under any circumstances.</Description>
				</Value>
				<Value Code="2">
					<Title>Connection normally guaranteed</Title>
					<Description>The connection is normally guaranteed, although the connection time available is shorter than the location connection time.</Description>
				</Value>
				<Value Code="3">
					<Title>Connection not guaranteed</Title>
					<Description>The connetion is not guaranteed, although the connection time available is longer than the location connection time.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4051" Length="3" Type="Alphanumeric">
			<Title>Characteristic relevance code</Title>
			<Description>Code specifying the relevance of a characteristic.</Description>
			<Values>
				<Value Code="1">
					<Title>Information only</Title>
					<Description>This product characteristic provides additional information for customer.</Description>
				</Value>
				<Value Code="2">
					<Title>Required within orders</Title>
					<Description>This product characteristic has to be provided within orders.</Description>
				</Value>
				<Value Code="3">
					<Title>Requirement for subsequent business transactions</Title>
					<Description>This product characteristic has to be provided within the subsequent business transactions.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4053" Length="3" Type="Alphanumeric" Incomplete="1">
			<Title>Delivery or transport terms description code</Title>
			<Description>Code specifying the delivery or transport terms.</Description>
			<Note>1 Recommend use UN/ECE Recommendation No. 5. Use
appropriate code set in combination with 1131/3055.
</Note>
			<Values>
				<Value Code="1">
					<Title>Delivery arranged by the supplier</Title>
					<Description>Indicates that the supplier will arrange delivery of the goods.</Description>
				</Value>
				<Value Code="2">
					<Title>Delivery arranged by logistic service provider</Title>
					<Description>Code indicating that the logistic service provider has arranged the delivery of goods.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4055" Length="3" Type="Alphanumeric">
			<Title>Delivery or transport terms function code</Title>
			<Description>Code specifying the function of delivery or transport terms.</Description>
			<Values>
				<Value Code="1">
					<Title>Price condition</Title>
					<Description>Specifies a condition related to the price which a seller must fulfil before the buyer will complete a purchase.</Description>
				</Value>
				<Value Code="2">
					<Title>Despatch condition</Title>
					<Description>Condition requested by the customer under which the supplier shall deliver: Extent of freight costs, means of transport.</Description>
				</Value>
				<Value Code="3">
					<Title>Price and despatch condition</Title>
					<Description>Condition related to price and despatch that the seller must complete before the customer will agree payment.</Description>
				</Value>
				<Value Code="4">
					<Title>Collected by customer</Title>
					<Description>Indicates that the customer will pick up the goods at the supplier. He will take care of the means of transport.</Description>
				</Value>
				<Value Code="5">
					<Title>Transport condition</Title>
					<Description>Specifies the conditions under which the transport takes place under the responsibility of the carrier.</Description>
				</Value>
				<Value Code="6">
					<Title>Delivery condition</Title>
					<Description>Specifies the conditions under which the goods must be delivered to the consignee.</Description>
				</Value>
				<Value Code="7">
					<Title>Delivered by supplier</Title>
					<Description>Indicates that the supplier will arrange the delivery of goods. He will take care of the means of transport.</Description>
				</Value>
				<Value Code="8">
					<Title>Delivery arranged by logistic service provider</Title>
					<Description>Code indicating that the logistic service provider will arrange the delivery of goods.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4059" Length="3" Type="Alphanumeric">
			<Title>Clause code qualifier</Title>
			<Description>Code qualifying the nature of the clause.</Description>
			<Values>
				<Value Code="1">
					<Title>Insurance policy</Title>
					<Description>Clause relating to an insurance policy.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4065" Length="3" Type="Alphanumeric">
			<Title>Contract and carriage condition code</Title>
			<Description>Code to identify the conditions of contract and carriage.</Description>
			<Values>
				<Value Code="1">
					<Title>AVC conditions</Title>
					<Description>General conditions of transport 1983, latest revision laid down by the Stichting Vervoeradres The Hague.</Description>
				</Value>
				<Value Code="2">
					<Title>Special agreement for parcels transport</Title>
					<Description>Appliance of a non published special agreement signed between a customer and the carrier (mandatory requested by the consignor) for parcels transport.</Description>
				</Value>
				<Value Code="3">
					<Title>Special agreement for full loading transport</Title>
					<Description>Appliance of a non published special agreement signed between a customer and the carrier (mandatory requested by the consignor) for full load transport.</Description>
				</Value>
				<Value Code="4">
					<Title>Combined transport</Title>
					<Description>A transport which involves more than one mode of transportation.</Description>
				</Value>
				<Value Code="5">
					<Title>FIATA combined transport bill of lading</Title>
					<Description>Standard conditions of a combined transport bill of lading issued by FIATA.</Description>
				</Value>
				<Value Code="6">
					<Title>Freight forwarders national conditions</Title>
					<Description>The contract and carriage conditions as established by freight forwarders on a national basis.</Description>
				</Value>
				<Value Code="7">
					<Title>Normal tariff, parcels transport</Title>
					<Description>Appliance of the published legal tariff in case of parcels transport (required or not by the consignor.</Description>
				</Value>
				<Value Code="8">
					<Title>Normal tariff, full loading transport</Title>
					<Description>Appliance of the published legal tariff in case of full load transport (required or not by the consignor).</Description>
				</Value>
				<Value Code="9">
					<Title>Ordinary</Title>
					<Description>Carrier will choose the cheapest tariff in the legally published tariffs for parcels or full load transports (no tariff required by the consignor).</Description>
				</Value>
				<Value Code="10">
					<Title>Port to port</Title>
					<Description>The transport will only be port to port, no inland transport would have to be provided under the contract.</Description>
				</Value>
				<Value Code="11">
					<Title>CMR carnet</Title>
					<Description>Conditions in accordance with the convention of the contract for the international carriage of goods by road.</Description>
				</Value>
				<Value Code="12">
					<Title>Special tariff, parcels transport</Title>
					<Description>Appliance of the legally published "special" tariff in case or parcels transport (tariff requested by the consignor).</Description>
				</Value>
				<Value Code="13">
					<Title>Special tariff, full transport</Title>
					<Description>Appliance of the legally published "special tariff" in case of full load transport (tariff requested by the consignor).</Description>
				</Value>
				<Value Code="14">
					<Title>Through transport</Title>
					<Description>The transport that is contracted not only from port to port, but from one inland location to another inland location.</Description>
				</Value>
				<Value Code="15">
					<Title>Cancel space allocation</Title>
					<Description>Indication that space previously allocated on a flight is to be cancelled.</Description>
				</Value>
				<Value Code="16">
					<Title>Report sale of space</Title>
					<Description>Indication that a sale has been made against a space allocation on a specific flight.</Description>
				</Value>
				<Value Code="17">
					<Title>Alternative space allocation</Title>
					<Description>Indication that space is being requested for a specific flight and that an alternative is acceptable.</Description>
				</Value>
				<Value Code="18">
					<Title>No alternative space allocation</Title>
					<Description>Indication that space is being requested for a specific flight and that an alternative is not acceptable.</Description>
				</Value>
				<Value Code="19">
					<Title>Allotment sale</Title>
					<Description>Indication that space is being sold against a space allocation allotment on a specific flight.</Description>
				</Value>
				<Value Code="20">
					<Title>Confirmation of space</Title>
					<Description>Indication that space requested has been confirmed on a specific flight.</Description>
				</Value>
				<Value Code="21">
					<Title>Unable to confirm</Title>
					<Description>Indication that airline is unable to confirm the space allocation on a specific flight.</Description>
				</Value>
				<Value Code="22">
					<Title>Non-operative flight</Title>
					<Description>Indication that airline is unable to confirm space on a specific flight since the flight does not operate.</Description>
				</Value>
				<Value Code="23">
					<Title>Wait list</Title>
					<Description>Indication that the space allocation request has been assigned to a wait list.</Description>
				</Value>
				<Value Code="24">
					<Title>Prior space allocation request</Title>
					<Description>Indication that a space allocation on a specific flight has already been requested.</Description>
				</Value>
				<Value Code="25">
					<Title>Holding confirmed space allocation</Title>
					<Description>Indication that space is being held as confirmed on a specific flight.</Description>
				</Value>
				<Value Code="26">
					<Title>Holding wait list</Title>
					<Description>Indication that space allocation request on a specific flight has been assigned to a wait list.</Description>
				</Value>
				<Value Code="27">
					<Title>Door-to-door</Title>
					<Description>The carrier is responsible for the intermodal carriage of cargo including both the pre-carriage and the on- carriage.</Description>
				</Value>
				<Value Code="28">
					<Title>Door-to-pier</Title>
					<Description>The carrier is responsible for the intermodal carriage of cargo including the pre-carriage, but excluding the on-carriage.</Description>
				</Value>
				<Value Code="29">
					<Title>Pier-to-door</Title>
					<Description>The carrier is responsible for the intermodal carriage of cargo including the on-carriage, but excluding the pre-carriage.</Description>
				</Value>
				<Value Code="30">
					<Title>Pier-to-pier</Title>
					<Description>The carrier of intermodal cargo is only responsible for the main carriage.</Description>
				</Value>
				<Value Code="31">
					<Title>Space cancellation noted</Title>
					<Description>Indication that space previously allocated on a means of transport has been cancelled.</Description>
				</Value>
				<Value Code="32">
					<Title>Mini landbridge service</Title>
					<Description>Cargo moving from a coastal port for delivery at an inland location or cargo received at an inland location moving to a coastal port for subsequent ocean transportation.</Description>
				</Value>
				<Value Code="34">
					<Title>Speed level - required</Title>
					<Description>Maximum speed required on an itinerary or part of this itinerary to be able to assume some services.</Description>
				</Value>
				<Value Code="35">
					<Title>Speed level - adopted</Title>
					<Description>Real speed used on an itinerary or part of this itinerary (for technical reasons, some limitation can be imposed or some higher speed could be used).</Description>
				</Value>
				<Value Code="36">
					<Title>Normal tariff, less than full load transport</Title>
					<Description>Application of the published legal tariff in case of less than full load transport (required or not by the consignor).</Description>
				</Value>
				<Value Code="37">
					<Title>Re-expedition special tariff</Title>
					<Description>Indication that a special tariff must be used in the case of a re-expedition.</Description>
				</Value>
				<Value Code="38">
					<Title>Transport arrangement by the requester</Title>
					<Description>The service requester has the responsibility of making transport arrangement.</Description>
				</Value>
				<Value Code="39">
					<Title>Transport arrangement by the provider</Title>
					<Description>The service provider has the responsibility of making transport arrangement.</Description>
				</Value>
				<Value Code="40">
					<Title>Transport arrangement by the patient</Title>
					<Description>The patient has the responsibility of making transport arrangement.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4071" Length="3" Type="Alphanumeric">
			<Title>Proviso code qualifier</Title>
