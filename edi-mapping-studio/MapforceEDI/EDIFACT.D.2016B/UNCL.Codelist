				</Value>
				<Value Code="96">
					<Title>Requested method for payment was not used</Title>
					<Description>If the requested method for payment was or could not be used, this code indicates that.</Description>
				</Value>
				<Value Code="97">
					<Title>Clearing between partners</Title>
					<Description>Amounts which two partners owe to each other to be compensated in order to avoid useless payments.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
