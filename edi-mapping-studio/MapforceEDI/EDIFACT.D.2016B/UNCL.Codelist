					<Title>Digital transmission rate</Title>
					<Description>Quantity, per unit time, of binary digits (or pulses representing them) which will pass a given point on a communications line or channel in a continuous stream.</Description>
				</Value>
				<Value Code="240">
					<Title>Sensitivity</Title>
					<Description>The minimum magnitude of input signal required to produce a specified output signal having a specified signal-to-noise ratio.</Description>
				</Value>
				<Value Code="241">
					<Title>Channel frequency spacing</Title>
					<Description>The difference in frequency between successive radio channels.</Description>
				</Value>
				<Value Code="242">
					<Title>Antenna type</Title>
					<Description>The type of apparatus used for sending or receiving electromagnetic waves.</Description>
				</Value>
				<Value Code="243">
					<Title>Antenna gain</Title>
					<Description>A measure of the effectiveness of a directional antenna as compared to a standard nondirectional antenna.</Description>
				</Value>
				<Value Code="244">
					<Title>Antenna frequency range</Title>
					<Description>The range of frequencies which the antenna is capable of receiving or transmitting.</Description>
				</Value>
				<Value Code="245">
					<Title>Maximum power density</Title>
					<Description>The amount of power (time rate of energy transfer) per unit volume.</Description>
				</Value>
				<Value Code="246">
					<Title>Effective radiated power (ERP)</Title>
					<Description>A standardized theoretical measurement of radio frequency (RF) energy using the SI unit watts, and is determined by subtracting system losses and adding system gains.</Description>
				</Value>
				<Value Code="247">
					<Title>Communication channel capacity</Title>
					<Description>The maximum number of bits or other information elements that can be reliably transmitted over a communications channel.</Description>
				</Value>
				<Value Code="248">
					<Title>Antenna polarization</Title>
					<Description>The orientation of the electric field (E-plane) of the radiowave with respect to the Earth's surface.</Description>
				</Value>
				<Value Code="249">
					<Title>Scientific name</Title>
					<Description>The scientific name of a product.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>The item characteristic is mutually agreed by the interchanging parties.</Description>
				</Value>
			</Values>
