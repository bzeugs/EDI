					<Description>Message authorising a message or transaction(s).</Description>
				</Value>
				<Value Code="52">
					<Title>Proposed amendment</Title>
					<Description>A code used to indicate an amendment suggested by the sender.</Description>
				</Value>
				<Value Code="53">
