				<Value Code="10">
					<Title>Bank guarantee</Title>
					<Description>A bank has agreed to stand as guarantor to ensure that payment is made.</Description>
				</Value>
				<Value Code="11">
					<Title>Public authority guarantee</Title>
					<Description>A public authority has agreed to stand as guarantor to ensure that payment is made.</Description>
