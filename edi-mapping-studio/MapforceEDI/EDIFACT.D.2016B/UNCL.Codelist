					<Description>Retention charge not otherwise specified.</Description>
				</Value>
				<Value Code="48">
					<Title>Interest on arrears</Title>
					<Description>Interest for late payment.</Description>
				</Value>
				<Value Code="49">
					<Title>Interest</Title>
					<Description>Cost of using money.</Description>
				</Value>
				<Value Code="50">
					<Title>Charge per credit cover</Title>
					<Description>Unit charge per credit cover established.</Description>
				</Value>
				<Value Code="51">
					<Title>Charge per unused credit cover</Title>
					<Description>Unit charge per unused credit cover.</Description>
				</Value>
				<Value Code="52">
					<Title>Minimum commission</Title>
					<Description>Minimum commission charge.</Description>
				</Value>
				<Value Code="53">
					<Title>Factoring commission</Title>
					<Description>Commission charged for factoring services.</Description>
				</Value>
				<Value Code="54">
