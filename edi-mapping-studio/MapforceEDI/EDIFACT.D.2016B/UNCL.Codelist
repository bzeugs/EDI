		<Field Name="F7075" Length="3" Type="Alphanumeric">
			<Title>Packaging level code</Title>
			<Description>Code specifying a level of packaging.</Description>
			<Values>
				<Value Code="1">
					<Title>Inner</Title>
					<Description>Level of packing, if it exists, that is immediately subordinate to the intermediate packaging level.</Description>
				</Value>
				<Value Code="2">
					<Title>Intermediate</Title>
					<Description>Level of packaging, if it exists, that is immediately subordinate to the outer packaging level.</Description>
				</Value>
				<Value Code="3">
					<Title>Outer</Title>
					<Description>For packed merchandise, outermost level of packaging for a shipment.</Description>
				</Value>
				<Value Code="4">
					<Title>No packaging hierarchy</Title>
					<Description>There is no specifiable level of packaging: packaging is inner and outer level as well.</Description>
				</Value>
				<Value Code="5">
					<Title>Shipment level</Title>
					<Description>The packaging level being described is the shipment level.</Description>
				</Value>
			</Values>
		</Field>
