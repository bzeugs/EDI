				</Value>
				<Value Code="91">
					<Title>Current liabilities to inventory</Title>
					<Description>Ratio of current liabilities to inventory value expressed as a percentage.</Description>
				</Value>
				<Value Code="92">
					<Title>Current ratio</Title>
					<Description>Ratio of current assets to current liabilities expressed as a percentage.</Description>
				</Value>
				<Value Code="93">
					<Title>Fixed assets to net worth</Title>
					<Description>Ratio of fixed assets to net worth expressed as a percentage.</Description>
				</Value>
				<Value Code="94">
					<Title>Inventory turnover</Title>
					<Description>Net annual sales divided by inventory.</Description>
				</Value>
				<Value Code="95">
					<Title>Quick ratio</Title>
					<Description>Ratio of cash and accounts receivable to current liabilities.</Description>
				</Value>
				<Value Code="96">
					<Title>Resources retained for project</Title>
					<Description>The percentage of resources that must be retained for a project.</Description>
				</Value>
				<Value Code="97">
					<Title>Return on assets</Title>
					<Description>Net profit after taxes divided by total assets.</Description>
				</Value>
				<Value Code="98">
					<Title>Return on sales ratio</Title>
					<Description>Net profit after taxes divided by net annual sales.</Description>
				</Value>
				<Value Code="99">
					<Title>Return on capital ratio</Title>
					<Description>Net profit after taxes divided by capital.</Description>
				</Value>
				<Value Code="100">
					<Title>Shareholders' return ratio</Title>
					<Description>Net profit after taxes divided by net worth.</Description>
				</Value>
				<Value Code="101">
					<Title>Contracts obtained by bid</Title>
					<Description>Percentage of contracts obtained by bid.</Description>
				</Value>
				<Value Code="102">
					<Title>Contracts obtained by negotiation</Title>
					<Description>Percentage of contracts obtained by negotiation.</Description>
				</Value>
				<Value Code="103">
					<Title>Cost plus basis</Title>
					<Description>Percentage of business conducted on a cost plus basis.</Description>
				</Value>
				<Value Code="104">
					<Title>Lump sum payments</Title>
					<Description>Percentage of lump sum payments to total payments.</Description>
				</Value>
				<Value Code="105">
					<Title>Purchases on letter of credit</Title>
					<Description>Percentage of purchases on letter of credit to total purchases.</Description>
				</Value>
				<Value Code="106">
					<Title>Purchases on floor plan</Title>
					<Description>Percentage of purchases on floor plan basis to total purchases.</Description>
				</Value>
				<Value Code="107">
					<Title>Change in sales</Title>
					<Description>Percentage change in sales.</Description>
				</Value>
				<Value Code="108">
					<Title>Change in profit</Title>
					<Description>Percentage change in profit.</Description>
				</Value>
				<Value Code="109">
					<Title>Damage</Title>
					<Description>Damage expressed as a percentage.</Description>
				</Value>
				<Value Code="110">
					<Title>Interest on liabilities</Title>
					<Description>Paid finance cost divided by total liabilities.</Description>
				</Value>
				<Value Code="111">
					<Title>Risk margin</Title>
					<Description>Total assets divided by interest on liabilities.</Description>
				</Value>
				<Value Code="112">
					<Title>Liability ratio</Title>
					<Description>Ratio of liability to net worth expressed as a percentage.</Description>
				</Value>
				<Value Code="113">
					<Title>Interest cover</Title>
					<Description>Paid finance cost divided by total income.</Description>
				</Value>
				<Value Code="114">
					<Title>Change</Title>
					<Description>Change expressed as a percentage.</Description>
				</Value>
				<Value Code="115">
					<Title>Expense</Title>
					<Description>Expenses expressed as a percentage.</Description>
				</Value>
				<Value Code="116">
					<Title>Market share</Title>
					<Description>Share of the market business held by an entity.</Description>
				</Value>
				<Value Code="117">
					<Title>Owned by small shareholders</Title>
					<Description>Percentage of an entity that is owned by small shareholders.</Description>
				</Value>
				<Value Code="118">
					<Title>Paid in capital</Title>
					<Description>Percentage of capital paid in by shareholders.</Description>
				</Value>
				<Value Code="119">
					<Title>Previous participation</Title>
					<Description>Previous participation expressed as a percentage.</Description>
				</Value>
				<Value Code="120">
					<Title>Fixed fee</Title>
					<Description>Fixed fee expressed as a percentage.</Description>
				</Value>
				<Value Code="121">
					<Title>Asset turnover</Title>
					<Description>Net annual sales divided by total assets.</Description>
				</Value>
				<Value Code="122">
					<Title>Percentage of total payment</Title>
					<Description>A percentage based on a total payment.</Description>
				</Value>
				<Value Code="123">
					<Title>Territorial trade percent</Title>
					<Description>Territorial trade expressed as a percentage.</Description>
				</Value>
				<Value Code="124">
					<Title>Change in taxable income</Title>
					<Description>Change in the taxable income from one period to another.</Description>
				</Value>
				<Value Code="125">
					<Title>Sales by type of customer</Title>
					<Description>Percentage of sales by type of customer.</Description>
				</Value>
				<Value Code="126">
					<Title>Previous period percent of total</Title>
					<Description>The percent of the total from a preceding period.</Description>
				</Value>
				<Value Code="127">
					<Title>Minority interest return on equity</Title>
					<Description>The return on equity achieved by a minority interest in an entity.</Description>
				</Value>
				<Value Code="128">
					<Title>Change in ordinary income</Title>
					<Description>Change in ordinary income from one period to another.</Description>
				</Value>
				<Value Code="129">
					<Title>Net sales to fixed assets</Title>
					<Description>The ratio of net sales to fixed assets expressed as a percentage.</Description>
				</Value>
				<Value Code="130">
					<Title>Total liabilities to total assets</Title>
					<Description>The ratio of total liabilities to total assets expressed as a percentage.</Description>
				</Value>
				<Value Code="131">
					<Title>Profit percentage</Title>
					<Description>The percentage applied to determine the profit.</Description>
				</Value>
				<Value Code="132">
					<Title>Contractor above cost share</Title>
					<Description>The percentage of the cost over-run incurred by the contractor.</Description>
				</Value>
				<Value Code="133">
					<Title>Contractor below cost share</Title>
					<Description>The percentage of the cost under-run allocated to the contractor.</Description>
				</Value>
				<Value Code="134">
					<Title>Current liabilities to total liabilities</Title>
					<Description>Ratio calculated by dividing current liabilities by total liabilities expressed as a percentage.</Description>
				</Value>
				<Value Code="135">
					<Title>Current assets to total liabilities</Title>
					<Description>Ratio calculated by dividing current assets by total liabilities expressed as a percentage.</Description>
				</Value>
				<Value Code="136">
					<Title>Vessel experience factor</Title>
					<Description>The compilation of the total calculated volume vessel measurements, adjusted for on-board quantity or remaining on-board quantity, compared with the total calculated volume shore measurements expressed as a percentage.</Description>
				</Value>
				<Value Code="137">
					<Title>Vessel load ratio</Title>
					<Description>The total calculated volume by vessel measurement upon sailing, less on-board quantity, divided by the total calculated volume by shore measurement at loading expressed as a percentage.</Description>
				</Value>
				<Value Code="138">
					<Title>Vessel discharge ratio</Title>
					<Description>The total calculated volume by vessel measurement on arrival, less remaining on board, divided by the total calculated volume by shore measurement discharge expressed as a percentage.</Description>
				</Value>
				<Value Code="139">
					<Title>National average percentile</Title>
					<Description>Relative ranking for a corresponding class to the national average.</Description>
				</Value>
				<Value Code="140">
					<Title>Industry average percentile</Title>
					<Description>Relative ranking for a corresponding class to the industry average.</Description>
				</Value>
				<Value Code="141">
					<Title>Non-current assets to net worth</Title>
					<Description>The ratio of non-current assets to net worth expressed as a percentage.</Description>
				</Value>
				<Value Code="142">
					<Title>Non-current assets to total assets</Title>
					<Description>The ratio of non-current assets to total assets expressed as a percentage.</Description>
				</Value>
				<Value Code="143">
					<Title>Sales to current assets</Title>
					<Description>The ratio of sales to current assets expressed as a percentage.</Description>
				</Value>
				<Value Code="144">
					<Title>Working capital to sales</Title>
					<Description>The ratio of working capital to sales expressed as a percentage.</Description>
				</Value>
				<Value Code="145">
					<Title>Creditors to sales costs</Title>
					<Description>The ratio of creditors to sales costs expressed as a percentage.</Description>
				</Value>
				<Value Code="146">
					<Title>Concentration</Title>
					<Description>Concentration expressed as a percentage value.</Description>
				</Value>
				<Value Code="147">
					<Title>Percentage of months before an instalment</Title>
					<Description>The number of months before an instalment is made expressed as a percentage.</Description>
				</Value>
				<Value Code="148">
					<Title>Accounts receivable turnover</Title>
					<Description>Net annual sales divided by accounts receivable.</Description>
				</Value>
				<Value Code="149">
					<Title>Employee costs to value added ratio</Title>
					<Description>Ratio of employee costs to total income minus raw materials and sales costs expressed as a percentage.</Description>
				</Value>
				<Value Code="150">
					<Title>Interest payable to net sales ratio</Title>
					<Description>Ratio of interest payable divided by net sales expressed as a percentage.</Description>
				</Value>
				<Value Code="151">
					<Title>Inventory to cost of goods sold ratio</Title>
					<Description>Ratio of inventory divided by cost of goods sold expressed as a percentage.</Description>
				</Value>
				<Value Code="152">
					<Title>Liquid assets to sales ratio</Title>
					<Description>Ratio of liquid assets divided by net sales expressed as a percentage.</Description>
				</Value>
				<Value Code="153">
					<Title>Return on value added ratio</Title>
					<Description>Ratio of total income minus raw materials and services to net sales expressed as a percentage.</Description>
				</Value>
				<Value Code="154">
					<Title>Daily working capital need</Title>
					<Description>The value of working capital divided by net sales multiplied by 360.</Description>
				</Value>
				<Value Code="155">
					<Title>Financial expenses to net sales ratio</Title>
					<Description>The ratio of financial expenses to net sales expressed as a percentage.</Description>
				</Value>
				<Value Code="156">
					<Title>Inflation</Title>
					<Description>Percentage representing a general increase in prices and fall in the purchasing value of money.</Description>
				</Value>
				<Value Code="157">
					<Title>Probability of financial distress</Title>
					<Description>The probability of financial distress expressed as a percentage.</Description>
				</Value>
				<Value Code="158">
					<Title>Gearing</Title>
					<Description>Ratio of the total short and long term loans divided by shareholder equity expressed as a percentage.</Description>
				</Value>
				<Value Code="159">
					<Title>Nestable percentage</Title>
					<Description>Extent expressed as a percentage to which an item can be nested within an identical item.</Description>
				</Value>
				<Value Code="160">
					<Title>Data reliability percentage</Title>
					<Description>To identify the degree of the reliability of the data.</Description>
				</Value>
				<Value Code="161">
					<Title>Transport weight completed</Title>
					<Description>The percentage of a transport weight that has been completed.</Description>
				</Value>
				<Value Code="162">
					<Title>Transport volume completed</Title>
					<Description>The percentage of a transport volume that has been completed.</Description>
				</Value>
				<Value Code="163">
					<Title>Percentage of order</Title>
					<Description>Percentage of an order.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>As agreed by the trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F5249" Length="3" Type="Alphanumeric">
			<Title>Percentage basis identification code</Title>
			<Description>Code specifying the basis on which a percentage is calculated.</Description>
			<Values>
				<Value Code="1">
					<Title>Per unit</Title>
					<Description>Referenced percentage applies on a single unit basis.</Description>
				</Value>
				<Value Code="2">
					<Title>Per ton</Title>
					<Description>Reduction percentage is applied per transported ton.</Description>
				</Value>
				<Value Code="3">
					<Title>Per equipment unit</Title>
					<Description>Reduction percentage is applied per main equipment unit (for rail purpose, only rail wagons).</Description>
				</Value>
				<Value Code="4">
					<Title>Per unit price</Title>
					<Description>Reduction percentage is applied on the unit price, which is the basis of the charge calculation.</Description>
				</Value>
				<Value Code="5">
					<Title>Per quantity</Title>
					<Description>Reduction percentage applied on the unit price and conceded to a consignor after he reached a specified tonnage of transport.</Description>
				</Value>
				<Value Code="6">
					<Title>Basic charge</Title>
					<Description>Code to indicate that the IATA experimental special charge within Europe is the basis for the percentage reduction or surcharge.</Description>
				</Value>
				<Value Code="7">
					<Title>Rate per kilogram</Title>
					<Description>Code to indicate that the IATA experimental special rate within in Europe is the basis for the percentage reduction or surcharge.</Description>
				</Value>
				<Value Code="8">
					<Title>Minimum charge</Title>
					<Description>Code to indicate that the IATA minimum charge is the basis for the percentage reduction or surcharge.</Description>
				</Value>
				<Value Code="9">
					<Title>Normal rate</Title>
					<Description>Code to indicate that the IATA normal rate is the basis for the percentage reduction or surcharge.</Description>
				</Value>
				<Value Code="10">
					<Title>Quantity rate</Title>
					<Description>Code to indicate that the IATA quantity rate is the basis for the percentage reduction or surcharge.</Description>
				</Value>
				<Value Code="11">
					<Title>Amount of drawing</Title>
					<Description>Referenced percentage applies on the amount of drawing under the documentary credit.</Description>
				</Value>
				<Value Code="12">
					<Title>Documentary credit amount</Title>
					<Description>Referenced percentage applies on documentary credit amount.</Description>
				</Value>
				<Value Code="13">
					<Title>Invoice value</Title>
					<Description>Referenced percentage applies on the invoice value.</Description>
				</Value>
				<Value Code="14">
					<Title>CIF value</Title>
					<Description>Referenced percentage applies on CIF value.</Description>
				</Value>
				<Value Code="15">
					<Title>Contract cost</Title>
					<Description>The percentage applied to the contract cost.</Description>
				</Value>
				<Value Code="16">
					<Title>Labour hours</Title>
					<Description>The percentage applied to the labour hours.</Description>
				</Value>
				<Value Code="17">
					<Title>LIBOR (London Inter-Bank Offered Rate)</Title>
					<Description>The percentage basis is London Inter-Bank Offered Rate (LIBOR).</Description>
				</Value>
				<Value Code="18">
					<Title>FIBOR (Frankfurt Inter-Bank Offered Rate)</Title>
					<Description>The percentage basis is Frankfurt Inter-Bank Offered Rate (FIBOR).</Description>
				</Value>
				<Value Code="19">
					<Title>PIBOR (Paris Inter-Bank Offered Rate)</Title>
					<Description>The percentage basis is Paris Inter-Bank Offered Rate (PIBOR).</Description>
				</Value>
				<Value Code="20">
					<Title>Nationally based percentage basis</Title>
					<Description>The percentage basis is nationally based.</Description>
				</Value>
			</Values>
		</Field>
