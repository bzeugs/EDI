		<Field Name="F3227" Length="3" Type="Alphanumeric">
			<Title>Location function code qualifier</Title>
			<Description>Code identifying the function of a location.</Description>
			<Values>
				<Value Code="1">
					<Title>Place of terms of delivery</Title>
					<Description>(3018) Point or port of departure, shipment or destination, as required under the applicable terms of delivery, e.g. Incoterms.</Description>
				</Value>
				<Value Code="2">
					<Title>Payment location</Title>
					<Description>[3109] To identify the place where the payment has been or should be made.</Description>
				</Value>
				<Value Code="3">
					<Title>Tare check place</Title>
					<Description>Place where equipment tare has been or must be checked for official assessment.</Description>
				</Value>
				<Value Code="4">
					<Title>Goods receipt place</Title>
					<Description>[3160] Place at which the goods have been received.</Description>
				</Value>
				<Value Code="5">
					<Title>Place of departure</Title>
					<Description>(3214) Port, airport or other location from which a means of transport or transport equipment is scheduled to depart or has departed.</Description>
				</Value>
				<Value Code="6">
					<Title>Ward bed</Title>
					<Description>A bed in a ward.</Description>
				</Value>
				<Value Code="7">
					<Title>Place of delivery</Title>
					<Description>(3246) Place to which the goods are to be finally delivered under transport contract terms (operational term).</Description>
				</Value>
				<Value Code="8">
					<Title>Place of destination</Title>
					<Description>(3258) Port, airport or other location to which a means of transport or transport equipment is destined.</Description>
				</Value>
				<Value Code="9">
					<Title>Place of loading</Title>
					<Description>[3334] Seaport, airport, freight terminal, rail station or other place at which the goods (cargo) are loaded on to the means of transport being used for their carriage.</Description>
				</Value>
				<Value Code="10">
					<Title>Place of acceptance</Title>
					<Description>[3348] Place where the goods are taken over by the carrier.</Description>
				</Value>
				<Value Code="11">
					<Title>Place of discharge</Title>
					<Description>[3392] Seaport, airport, freight terminal, rail station or other place at which goods are unloaded from the means of transport having been used for their carriage.</Description>
				</Value>
				<Value Code="12">
					<Title>Port of discharge</Title>
					<Description>Port at which the goods are discharged from the vessel used for their transport.</Description>
				</Value>
				<Value Code="13">
					<Title>Place of transhipment</Title>
					<Description>[3424] Place where goods are to be or have been transferred from one means of transport to another during the course of one transport operation.</Description>
				</Value>
				<Value Code="14">
					<Title>Goods item storage location</Title>
					<Description>[3385] To identify the place where a goods item is located.</Description>
				</Value>
				<Value Code="15">
					<Title>Place of transfer responsibility</Title>
					<Description>Place where the responsibility is transferred.</Description>
				</Value>
				<Value Code="16">
					<Title>Place of transfer of ownership</Title>
					<Description>Place where the ownership of the goods is transferred.</Description>
				</Value>
				<Value Code="17">
					<Title>Border crossing place</Title>
					<Description>Place where goods are transported across a country border.</Description>
				</Value>
				<Value Code="18">
					<Title>Warehouse</Title>
					<Description>[3156] Warehouse where a particular consignment is to be or has been stored.</Description>
				</Value>
				<Value Code="19">
					<Title>Factory/plant</Title>
					<Description>Factory/plant relevant for a particular consignment.</Description>
				</Value>
				<Value Code="20">
					<Title>Place of ultimate destination of goods</Title>
					<Description>Place where goods will ultimately be delivered.</Description>
				</Value>
				<Value Code="21">
					<Title>Terms of sale place</Title>
					<Description>Place of departure, shipment or destination as specified in the terms of sale agreed between the parties.</Description>
				</Value>
				<Value Code="22">
					<Title>Customs clearance location</Title>
					<Description>[3080] Place at which Customs clearance should or has taken place.</Description>
				</Value>
				<Value Code="23">
					<Title>Port of release</Title>
					<Description>Port where goods are released from Customs custody.</Description>
				</Value>
				<Value Code="24">
					<Title>Port of entry</Title>
					<Description>Port where final documentation is filed for Customs Entry processing.</Description>
				</Value>
				<Value Code="25">
					<Title>Country</Title>
					<Description>Country relevant for a particular transaction.</Description>
				</Value>
				<Value Code="26">
					<Title>City</Title>
					<Description>City or town relevant for a particular transaction or consignment.</Description>
				</Value>
				<Value Code="27">
					<Title>Country of origin</Title>
					<Description>[3239] To identify the country in which the goods have been produced or manufactured, according to criteria laid down for the application of the Customs tariff or quantitative restrictions, or any measure related to trade.</Description>
				</Value>
				<Value Code="28">
					<Title>Country of destination of goods</Title>
					<Description>Country to which the goods are to be delivered.</Description>
				</Value>
				<Value Code="29">
					<Title>Railway station</Title>
					<Description>Name or identification of a railway station/yard relevant to a particular consignment.</Description>
				</Value>
				<Value Code="30">
					<Title>Country of source</Title>
					<Description>Country in which raw material or components were originally produced prior to manufacture or assembly in another country.</Description>
				</Value>
				<Value Code="31">
					<Title>Building</Title>
					<Description>A building or part thereof relevant to a particular consignment or transaction.</Description>
				</Value>
				<Value Code="32">
					<Title>Beginning of chargeable section</Title>
					<Description>First rail station in a predefined section of the chargeable voyage. A complete voyage may be divided in sections, even within one country, that are separately chargeable using different tariff rules (split tariffs).</Description>
				</Value>
				<Value Code="33">
					<Title>Baseport of discharge</Title>
					<Description>[3356] Place at which the cargo is discharged or unloaded from a means of transport according to the transport contract. The goods may or may not be discharged from the main means of transport at this place or port.</Description>
				</Value>
				<Value Code="34">
					<Title>Baseport of loading</Title>
					<Description>[3322] Place at which the cargo is loaded on a means of transport according to the transport contract. The goods may or may not be loaded on the main means of transport at this place or port.</Description>
				</Value>
				<Value Code="35">
					<Title>Exportation country</Title>
					<Description>[3220] Country from which the goods were initially exported to the importing country without any commercial transaction taking place in intermediate countries. Synonym: Country whence consigned. Country of despatch: Country from which goods are despatched between countries of a Customs union.</Description>
				</Value>
				<Value Code="36">
					<Title>Country of ultimate destination</Title>
					<Description>(3216) Country known to the consignor or his agent at the time of despatch to be the final country to which the goods are to be delivered.</Description>
				</Value>
				<Value Code="37">
					<Title>Consignment final exportation country</Title>
					<Description>[3331] To identify the country from which goods have been or will be consigned prior to final importation.</Description>
				</Value>
				<Value Code="38">
					<Title>Consignment first destination country</Title>
					<Description>[3219] To identify the country where a consignment is off-loaded from the means of transport used for the original exportation.</Description>
				</Value>
				<Value Code="39">
					<Title>Country of production</Title>
					<Description>Country where item has been or will be produced.</Description>
				</Value>
				<Value Code="40">
					<Title>Country of trading</Title>
					<Description>Country where item has been or will be traded.</Description>
				</Value>
				<Value Code="41">
					<Title>Consignment entry customs office location</Title>
					<Description>[3089] To identify the customs office at which the goods enter the customs territory of destination.</Description>
				</Value>
				<Value Code="42">
					<Title>Consignment exit customs office location</Title>
					<Description>[3097] To identify the customs office at which the goods leave or are intended to leave the customs territory of despatch.</Description>
				</Value>
				<Value Code="43">
					<Title>Place of Customs examination</Title>
					<Description>Place where Customs undertakes a physical inspection of goods to satisfy themselves that the goods' nature, origin, condition, quantity and value are in accordance with the particulars furnished on the goods declaration (CCC).</Description>
				</Value>
				<Value Code="44">
					<Title>Place of authentication of document</Title>
					<Description>(3410) Place where document is signed or otherwise authenticated. Synonym: Place of issue of document.</Description>
				</Value>
				<Value Code="45">
					<Title>Customs office of destination (transit)</Title>
					<Description>(3086) Customs office at which a transit operation is terminated. Synonym: Customs office of transit termination.</Description>
				</Value>
				<Value Code="46">
					<Title>Region of despatch</Title>
					<Description>Region from which goods are despatched between countries of a Customs union.</Description>
				</Value>
				<Value Code="47">
					<Title>Region of destination</Title>
					<Description>Region known to the consignor or his agent at the time of despatch to be the final region to which the goods are to be delivered.</Description>
				</Value>
				<Value Code="48">
					<Title>Region of production</Title>
					<Description>Region where item has been or will be produced.</Description>
				</Value>
				<Value Code="49">
					<Title>Transit country</Title>
					<Description>[3263] Country through which a goods or passengers are routed between the country of original departure and final destination.</Description>
				</Value>
				<Value Code="50">
					<Title>Transit customs office location</Title>
					<Description>[3107] To identify the customs office which is responsible for transit formalities en-route.</Description>
				</Value>
				<Value Code="51">
					<Title>Country of invalid transit guarantee</Title>
					<Description>Country in which the security or guarantee for the movement of goods under a transit procedure is not valid.</Description>
				</Value>
				<Value Code="52">
					<Title>Country of destination (transit)</Title>
					<Description>Country at which a Customs transit operation is terminated. Synonym: Country of transit termination.</Description>
				</Value>
				<Value Code="53">
					<Title>Charge and freight due from</Title>
					<Description>Place or point from which charges and freight are charged.</Description>
				</Value>
				<Value Code="54">
					<Title>Manufacturing department</Title>
					<Description>A department within the manufacturing area (e.g. lacquering, assembly).</Description>
				</Value>
				<Value Code="55">
					<Title>Freight charge payable to location</Title>
					<Description>[3102] Name of a place to which a transport charges tariff applies or where freight and other related charges are to be or have been incurred.</Description>
				</Value>
				<Value Code="56">
					<Title>End of chargeable section</Title>
					<Description>Last rail station in a predefined section of the chargeable voyage. A complete voyage may be divided in sections, even within one country, that are separately chargeable using different tariff rules (split tariffs).</Description>
				</Value>
				<Value Code="57">
					<Title>Place of payment</Title>
					<Description>Name of the location at which freight and charges for main transport are payable.</Description>
				</Value>
				<Value Code="58">
					<Title>Full track loading or unloading</Title>
					<Description>Identification of the station proceeding to the loading or unloading of a rail wagon on a full track site. (Used only when a rail station is obliged to transfer the load on another wagon for technical reasons - e.g. damage).</Description>
				</Value>
				<Value Code="59">
					<Title>Place of loss</Title>
					<Description>To identify the location where the loss occurred.</Description>
				</Value>
				<Value Code="60">
					<Title>Place of arrival</Title>
					<Description>Place at which the transport means arrives.</Description>
				</Value>
				<Value Code="61">
					<Title>Next port of call</Title>
					<Description>(3095) Next port which the vessel is going to call upon.</Description>
				</Value>
				<Value Code="62">
					<Title>On-carriage port</Title>
					<Description>Port of discharge at which the cargo is discharged from the vessel, used for transport after the main transport (transit port).</Description>
				</Value>
				<Value Code="63">
					<Title>Sub-project location</Title>
					<Description>A place at which works occur referring to a sub-project.</Description>
				</Value>
				<Value Code="64">
					<Title>First optional place of discharge</Title>
					<Description>The first optional place or port of discharge as mentioned on the transport document where cargo can be discharged at the option of the shipper.</Description>
				</Value>
				<Value Code="65">
					<Title>Final port or place of discharge</Title>
					<Description>Name of the seaport, airport, freight terminal, rail station or other place at which the goods (cargo) are finally (to be) unloaded from the means of transport used for their carriage according to the transport contract.</Description>
				</Value>
				<Value Code="66">
					<Title>Express railway station</Title>
					<Description>Railway station offering express transportation services.</Description>
				</Value>
				<Value Code="67">
					<Title>Mixed cargo railway station</Title>
					<Description>Railway station offering mixed cargo transportation services .</Description>
				</Value>
				<Value Code="68">
					<Title>Second optional place of discharge</Title>
					<Description>The second optional place or port of discharge as mentioned on the transport document where cargo can be discharged at the option of shipper.</Description>
				</Value>
				<Value Code="69">
					<Title>Next non-discharge port of call</Title>
					<Description>A code to identify the next port of call for a vessel where no cargo will be discharged.</Description>
				</Value>
				<Value Code="70">
					<Title>Third optional place of discharge</Title>
					<Description>The third optional place or port of discharge as mentioned on the transport document where cargo can be discharged at the option of the shipper.</Description>
				</Value>
				<Value Code="71">
					<Title>Reconsolidation point</Title>
					<Description>A place where cargo is reconsolidated.</Description>
				</Value>
				<Value Code="72">
					<Title>Fourth optional place of discharge</Title>
					<Description>The fourth optional place or port of discharge as mentioned on the transport document where cargo can be discharged at the option of the shipper.</Description>
				</Value>
				<Value Code="73">
					<Title>Bill of lading release office</Title>
					<Description>A location where bills of lading are released to customers.</Description>
				</Value>
				<Value Code="74">
					<Title>Transhipment excluding this place</Title>
					<Description>Place/location where a transhipment from a means of transport to another means of transport is not authorised.</Description>
				</Value>
				<Value Code="75">
					<Title>Transhipment limited to this place</Title>
					<Description>Only place/location where a transhipment from a means of transport to another means of transport is authorised.</Description>
				</Value>
				<Value Code="76">
					<Title>Original port of loading</Title>
					<Description>(3099) The port where the goods were first loaded on a vessel.</Description>
				</Value>
				<Value Code="77">
					<Title>First port of call - non-discharging</Title>
					<Description>Port in the country of destination where the conveyance initially arrives from the 'last place/port of call of conveyance' and where a conveyance will not be discharging cargoes.</Description>
				</Value>
				<Value Code="78">
					<Title>First port of call - discharging</Title>
					<Description>Port in the country of destination where the conveyance initially arrives from the 'last place/port of call of conveyance' and where a conveyance will be discharging cargoes.</Description>
				</Value>
				<Value Code="79">
					<Title>Place/port of first entry</Title>
					<Description>Place or port where final documentation is filed for Customs entry processing.</Description>
				</Value>
				<Value Code="80">
					<Title>Place of despatch</Title>
					<Description>Place at which the goods are taken over for carriage (operational term), if different from the transport contract place of acceptance (see: 10). Synonym: Place of origin of carriage.</Description>
				</Value>
				<Value Code="81">
					<Title>Fifth optional place of discharge</Title>
					<Description>The fifth optional place or port of discharge as mentioned on the transport document where cargo can be discharged at the option of the shipper.</Description>
				</Value>
				<Value Code="82">
					<Title>Pre-carriage port</Title>
					<Description>Port of loading at which the cargo is loaded on the pre- carriage vessel used for the transport prior to the main transport.</Description>
				</Value>
				<Value Code="83">
					<Title>Place of delivery (by on carriage)</Title>
					<Description>[3358] Place to which the goods are to be finally delivered.</Description>
				</Value>
				<Value Code="84">
