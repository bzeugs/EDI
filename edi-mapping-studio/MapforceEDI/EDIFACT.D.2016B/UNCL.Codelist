		<Field Name="F2017" Length="3" Type="Alphanumeric">
			<Title>Despatch pattern timing code</Title>
			<Description>Code specifying a set of dates/times within a despatch pattern.</Description>
			<Values>
				<Value Code="A">
					<Title>1st shift (normal working hours)</Title>
					<Description>The first working period as defined by an entity.</Description>
				</Value>
				<Value Code="B">
					<Title>2nd shift</Title>
					<Description>A subsequent working period as defined by an entity, that follows 1st shift.</Description>
				</Value>
				<Value Code="C">
					<Title>3rd shift</Title>
					<Description>A subsequent working period as defined by an entity, that follows 2nd shift.</Description>
				</Value>
				<Value Code="D">
					<Title>A.M.</Title>
					<Description>Ante Meridiem (forenoon).</Description>
				</Value>
				<Value Code="E">
					<Title>P.M.</Title>
					<Description>Post Meridiem (afternoon).</Description>
				</Value>
				<Value Code="F">
					<Title>As directed</Title>
					<Description>Shipment/delivery instruction will be provided in an independent communication session.</Description>
				</Value>
				<Value Code="G">
					<Title>Any shift</Title>
					<Description>The production period that a product will be built such as 1st shift or 3rd shift.</Description>
				</Value>
				<Value Code="H">
					<Title>24 hour clock</Title>
					<Description>Shipment/deliveries will be specified by a continuous time clock .</Description>
				</Value>
				<Value Code="Y">
					<Title>None</Title>
					<Description>Used to cancel or override a previous pattern.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Despatch pattern timing according to agreement.</Description>
				</Value>
			</Values>
		</Field>
