					<Description>The payment terms require the presentation of a letter of credit.</Description>
				</Value>
				<Value Code="66">
					<Title>Secured account</Title>
					<Description>The payment terms call for the use of a secured account.</Description>
				</Value>
				<Value Code="67">
					<Title>Basic commission terms</Title>
					<Description>The payment terms call for the use of basic commission terms.</Description>
				</Value>
				<Value Code="68">
					<Title>Deposit required</Title>
					<Description>The payment terms require a deposit be provided.</Description>
				</Value>
				<Value Code="69">
					<Title>Discount with prompt pay</Title>
					<Description>The payment terms include a discount when payment is made within a time frame designated as prompt pay.</Description>
				</Value>
				<Value Code="70">
					<Title>Discount with advance payment</Title>
					<Description>The payment terms include a discount when payment is made in advance.</Description>
				</Value>
				<Value Code="71">
