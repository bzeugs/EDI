					<Description>The free text contains information for regulatory authority.</Description>
				</Value>
				<Value Code="RET">
					<Title>Return to origin information</Title>
					<Description>Free text information on an IATA Air Waybill to indicate consignment returned because of non delivery.</Description>
				</Value>
				<Value Code="REV">
					<Title>Receivables</Title>
					<Description>The text contains receivables information.</Description>
				</Value>
				<Value Code="RQR">
					<Title>Consignment route</Title>
					<Description>[3050] Description of a route to be used for the transport of goods.</Description>
				</Value>
				<Value Code="SAF">
					<Title>Safety information</Title>
					<Description>The text contains safety information.</Description>
				</Value>
				<Value Code="SIC">
					<Title>Consignment documentary instruction</Title>
					<Description>[4284] Instructions given and declarations made by the sender to the carrier concerning Customs, insurance, and other formalities.</Description>
				</Value>
				<Value Code="SIN">
					<Title>Special instructions</Title>
					<Description>Special instructions like licence no, high value, handle with care, glass.</Description>
				</Value>
				<Value Code="SLR">
					<Title>Ship line requested</Title>
					<Description>Shipping line requested to be used for traffic between European continent and U.K. for Ireland.</Description>
				</Value>
				<Value Code="SPA">
					<Title>Special permission for transport, generally</Title>
					<Description>Statement that a special permission has been obtained for the transport (and/or routing) in general, and reference to such permission.</Description>
				</Value>
				<Value Code="SPG">
					<Title>Special permission concerning the goods to be transported</Title>
					<Description>Statement that a special permission has been obtained for the transport (and/or routing) of the goods specified, and reference to such permission.</Description>
				</Value>
				<Value Code="SPH">
					<Title>Special handling</Title>
					<Description>Note contains special handling information.</Description>
				</Value>
				<Value Code="SPP">
					<Title>Special permission concerning package</Title>
					<Description>Statement that a special permission has been obtained for the packaging, and reference to such permission.</Description>
				</Value>
				<Value Code="SPT">
					<Title>Special permission concerning transport means</Title>
					<Description>Statement that a special permission has been obtained for the use of the means transport, and reference to such permission.</Description>
				</Value>
				<Value Code="SRN">
					<Title>Subsidiary risk number (IATA/DGR)</Title>
					<Description>Number(s) of subsidiary risks, induced by the goods, according to the valid classification.</Description>
				</Value>
				<Value Code="SSR">
					<Title>Special service request</Title>
					<Description>Request for a special service concerning the transport of the goods.</Description>
				</Value>
				<Value Code="SUR">
					<Title>Supplier remarks</Title>
					<Description>Remarks from or for a supplier of goods or services.</Description>
				</Value>
				<Value Code="TCA">
					<Title>Consignment tariff</Title>
					<Description>[5430] Free text specification of tariff applied to a consignment.</Description>
				</Value>
				<Value Code="TDT">
					<Title>Consignment transport</Title>
					<Description>[8012] Transport information for commercial purposes (generic term).</Description>
				</Value>
				<Value Code="TRA">
					<Title>Transportation information</Title>
					<Description>General information regarding the transport of the cargo.</Description>
				</Value>
				<Value Code="TRR">
					<Title>Requested tariff</Title>
					<Description>Stipulation of the tariffs to be applied showing, where applicable, special agreement numbers or references.</Description>
				</Value>
				<Value Code="TXD">
					<Title>Tax declaration</Title>
					<Description>The text contains a statement constituting a tax declaration.</Description>
				</Value>
				<Value Code="WHI">
					<Title>Warehouse instruction/information</Title>
					<Description>Note contains warehouse information.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Note contains information mutually defined by trading partners.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4453" Length="3" Type="Alphanumeric">
			<Title>Free text function code</Title>
			<Description>Code specifying the function of free text.</Description>
			<Values>
				<Value Code="1">
					<Title>Text for subsequent use</Title>
					<Description>The occurrence of this text does not affect message processing.</Description>
				</Value>
				<Value Code="2">
					<Title>Text replacing missing code</Title>
					<Description>Text description of a coded data item for which there is no currently available code.</Description>
				</Value>
				<Value Code="3">
					<Title>Text for immediate use</Title>
					<Description>Text must be read before actioning message.</Description>
				</Value>
				<Value Code="4">
					<Title>No action required</Title>
					<Description>Pass text on to later recipient.</Description>
				</Value>
				<Value Code="5">
					<Title>Header</Title>
					<Description>Indicates that the text is to be taken as a header.</Description>
				</Value>
				<Value Code="6">
					<Title>Numbered paragraph</Title>
					<Description>Indicates that the text starts a new numbered paragraph.</Description>
				</Value>
				<Value Code="7">
					<Title>Paragraph</Title>
					<Description>Indicates that the text is a paragraph.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4455" Length="3" Type="Alphanumeric">
			<Title>Back order arrangement type code</Title>
			<Description>Code specifying a type of back order arrangement.</Description>
			<Values>
				<Value Code="B">
					<Title>Back order only if new item (book industry - not yet</Title>
					<Description>published only) Item on back order due to unpublished status.</Description>
				</Value>
				<Value Code="F">
					<Title>Factory ship</Title>
					<Description>Ship directly from factory to purchaser.</Description>
				</Value>
				<Value Code="N">
					<Title>No back order</Title>
					<Description>Back order is unacceptable.</Description>
				</Value>
				<Value Code="W">
					<Title>Warehouse ship</Title>
					<Description>Ship directly from warehouse.</Description>
				</Value>
				<Value Code="Y">
					<Title>Back order if out of stock</Title>
					<Description>Acceptable to put on back order if out of stock.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4457" Length="3" Type="Alphanumeric">
			<Title>Substitution condition code</Title>
			<Description>Code specifying the conditions under which substitution may take place.</Description>
			<Values>
				<Value Code="1">
					<Title>No substitution allowed</Title>
					<Description>Notice to supplier to fill order exactly as specified.</Description>
				</Value>
				<Value Code="2">
					<Title>Supply any binding if edition ordered not available</Title>
					<Description>Indicates that substitute bindings are acceptable if the edition of a book originally ordered is unavailable.</Description>
				</Value>
				<Value Code="3">
					<Title>Supply paper binding if edition ordered not available</Title>
					<Description>Indicates that a paper back edition of a book is acceptable if the edition ordered is unavailable.</Description>
				</Value>
				<Value Code="4">
					<Title>Supply cloth binding if edition ordered not available</Title>
					<Description>Indicates that the cloth bound edition of a book is acceptable if the edition ordered is unavailable.</Description>
				</Value>
				<Value Code="5">
					<Title>Supply library binding if edition ordered not available</Title>
					<Description>Indicates that a library binding of a book is acceptable if the edition ordered is unavailable.</Description>
				</Value>
				<Value Code="6">
					<Title>Equivalent item substitution</Title>
					<Description>Indicates that an item of the same value and performance may be substituted for the item specified.</Description>
				</Value>
				<Value Code="7">
					<Title>Alternate item substitution allowed</Title>
					<Description>Indicates that an item of equal or greater value and performance may be substituted for the item specified.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code reserved for special trading partner requirements when pre-defined codes do not exist.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4461" Length="3" Type="Alphanumeric">
			<Title>Payment means code</Title>
			<Description>Code identifying a means of payment.</Description>
			<Values>
				<Value Code="1">
					<Title>Instrument not defined</Title>
					<Description>Not defined legally enforceable agreement between two or more parties (expressing a contractual right or a right to the payment of money).</Description>
				</Value>
				<Value Code="2">
					<Title>Automated clearing house credit</Title>
					<Description>A credit transaction made through the automated clearing house system.</Description>
				</Value>
				<Value Code="3">
					<Title>Automated clearing house debit</Title>
					<Description>A debit transaction made through the automated clearing house system.</Description>
				</Value>
				<Value Code="4">
					<Title>ACH demand debit reversal</Title>
					<Description>A request to reverse an ACH debit transaction to a demand deposit account.</Description>
				</Value>
				<Value Code="5">
					<Title>ACH demand credit reversal</Title>
					<Description>A request to reverse a credit transaction to a demand deposit account.</Description>
				</Value>
				<Value Code="6">
					<Title>ACH demand credit</Title>
					<Description>A credit transaction made through the ACH system to a demand deposit account.</Description>
				</Value>
				<Value Code="7">
					<Title>ACH demand debit</Title>
					<Description>A debit transaction made through the ACH system to a demand deposit account.</Description>
				</Value>
				<Value Code="8">
					<Title>Hold</Title>
					<Description>Indicates that the bank should hold the payment for collection by the beneficiary or other instructions.</Description>
				</Value>
				<Value Code="9">
					<Title>National or regional clearing</Title>
					<Description>Indicates that the payment should be made using the national or regional clearing.</Description>
				</Value>
				<Value Code="10">
					<Title>In cash</Title>
					<Description>Payment by currency (including bills and coins) in circulation, including checking account deposits.</Description>
				</Value>
				<Value Code="11">
					<Title>ACH savings credit reversal</Title>
					<Description>A request to reverse an ACH credit transaction to a savings account.</Description>
				</Value>
				<Value Code="12">
					<Title>ACH savings debit reversal</Title>
					<Description>A request to reverse an ACH debit transaction to a savings account.</Description>
				</Value>
				<Value Code="13">
					<Title>ACH savings credit</Title>
					<Description>A credit transaction made through the ACH system to a savings account.</Description>
				</Value>
				<Value Code="14">
					<Title>ACH savings debit</Title>
					<Description>A debit transaction made through the ACH system to a savings account.</Description>
				</Value>
				<Value Code="15">
					<Title>Bookentry credit</Title>
					<Description>A credit entry between two accounts at the same bank branch. Synonym: house credit.</Description>
				</Value>
				<Value Code="16">
					<Title>Bookentry debit</Title>
					<Description>A debit entry between two accounts at the same bank branch. Synonym: house debit.</Description>
				</Value>
				<Value Code="17">
					<Title>ACH demand cash concentration/disbursement (CCD) credit</Title>
					<Description>A credit transaction made through the ACH system to a demand deposit account using the CCD payment format.</Description>
				</Value>
				<Value Code="18">
					<Title>ACH demand cash concentration/disbursement (CCD) debit</Title>
					<Description>A debit transaction made through the ACH system to a demand deposit account using the CCD payment format.</Description>
				</Value>
				<Value Code="19">
					<Title>ACH demand corporate trade payment (CTP) credit</Title>
					<Description>A credit transaction made through the ACH system to a demand deposit account using the CTP payment format.</Description>
				</Value>
				<Value Code="20">
					<Title>Cheque</Title>
					<Description>Payment by a pre-printed form on which instructions are given to an account holder (a bank or building society) to pay a stated sum to a named recipient.</Description>
				</Value>
				<Value Code="21">
					<Title>Banker's draft</Title>
					<Description>Issue of a banker's draft in payment of the funds.</Description>
				</Value>
				<Value Code="22">
					<Title>Certified banker's draft</Title>
					<Description>Cheque drawn by a bank on itself or its agent. A person who owes money to another buys the draft from a bank for cash and hands it to the creditor who need have no fear that it might be dishonoured.</Description>
				</Value>
				<Value Code="23">
					<Title>Bank cheque (issued by a banking or similar establishment)</Title>
					<Description>Payment by a pre-printed form, which has been completed by a financial institution, on which instructions are given to an account holder (a bank or building society) to pay a stated sum to a named recipient.</Description>
				</Value>
				<Value Code="24">
					<Title>Bill of exchange awaiting acceptance</Title>
					<Description>Bill drawn by the creditor on the debtor but not yet accepted by the debtor.</Description>
				</Value>
				<Value Code="25">
					<Title>Certified cheque</Title>
					<Description>Payment by a pre-printed form stamped with the paying bank's certification on which instructions are given to an account holder (a bank or building society) to pay a stated sum to a named recipient .</Description>
				</Value>
				<Value Code="26">
					<Title>Local cheque</Title>
					<Description>Indicates that the cheque is given local to the recipient.</Description>
				</Value>
				<Value Code="27">
					<Title>ACH demand corporate trade payment (CTP) debit</Title>
					<Description>A debit transaction made through the ACH system to a demand deposit account using the CTP payment format.</Description>
				</Value>
				<Value Code="28">
					<Title>ACH demand corporate trade exchange (CTX) credit</Title>
					<Description>A credit transaction made through the ACH system to a demand deposit account using the CTX payment format.</Description>
				</Value>
				<Value Code="29">
					<Title>ACH demand corporate trade exchange (CTX) debit</Title>
					<Description>A debit transaction made through the ACH system to a demand account using the CTX payment format.</Description>
				</Value>
				<Value Code="30">
					<Title>Credit transfer</Title>
					<Description>Payment by credit movement of funds from one account to another.</Description>
				</Value>
				<Value Code="31">
					<Title>Debit transfer</Title>
					<Description>Payment by debit movement of funds from one account to another.</Description>
				</Value>
				<Value Code="32">
