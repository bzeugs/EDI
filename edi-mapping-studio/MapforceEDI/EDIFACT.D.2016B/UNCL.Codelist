				<Value Code="CUS">
					<Title>Declared customs unit value</Title>
					<Description>A clearly known duty on a single item which is imposed by law.</Description>
				</Value>
				<Value Code="DAP">
					<Title>Dealer adjusted price</Title>
					<Description>The necessary or desirable changes that the sales agency makes with respect to the value of the product.</Description>
				</Value>
				<Value Code="DIS">
					<Title>Distributor price</Title>
					<Description>The cost associated with the agency that markets goods.</Description>
				</Value>
				<Value Code="DPR">
					<Title>Discount price</Title>
					<Description>A reduction from the usual list value.</Description>
				</Value>
				<Value Code="DR">
					<Title>Dealer price</Title>
					<Description>Code specifying a dealer price.</Description>
				</Value>
				<Value Code="DSC">
					<Title>Discount amount allowed</Title>
					<Description>A certain price up to which one is able to make reductions from the usual list value.</Description>
				</Value>
				<Value Code="EC">
					<Title>ECSC price</Title>
					<Description>Price registered at European Commission Steel and Carbon office (DG III).</Description>
				</Value>
				<Value Code="ES">
					<Title>Estimated price</Title>
					<Description>Code specifying an estimated price.</Description>
				</Value>
				<Value Code="EUP">
					<Title>Expected unit price</Title>
					<Description>The anticipated value of a single item.</Description>
				</Value>
				<Value Code="FCR">
					<Title>Freight/charge rate</Title>
					<Description>The price that is either a freight rate or a rate on which freight charges are calculated.</Description>
				</Value>
				<Value Code="GRP">
					<Title>Gross unit price</Title>
					<Description>Unit price to which allowances and charges apply.</Description>
				</Value>
				<Value Code="INV">
					<Title>Invoice price</Title>
					<Description>Price per unit of quantity of a product as specified on an invoice.</Description>
				</Value>
				<Value Code="LBL">
					<Title>Labelling price</Title>
					<Description>Retail price of the buyer that should be printed by the producer on the article's label. The labelling price is not necessary the effective retail price.</Description>
				</Value>
				<Value Code="MAX">
					<Title>Maximum order quantity price</Title>
					<Description>The greatest amount of goods or services which one can buy to receive a certain value.</Description>
				</Value>
				<Value Code="MIN">
					<Title>Minimum order quantity price</Title>
					<Description>The least amount of goods or services that one can buy to receive a certain value.</Description>
				</Value>
				<Value Code="MNR">
					<Title>Minimum release quantity price</Title>
					<Description>The least amount of an order one can place in order to receive a certain value.</Description>
				</Value>
				<Value Code="MSR">
					<Title>Manufacturer's suggested retail</Title>
					<Description>Price that reflects "Sales to other manufacturers" or "Sales for resale".</Description>
				</Value>
				<Value Code="MXR">
					<Title>Maximum release quantity price</Title>
					<Description>The greatest amount of an order that one can place in order to receive a certain value.</Description>
				</Value>
				<Value Code="NE">
					<Title>Not-to-exceed price</Title>
					<Description>Code specifying a price that cannot be increased.</Description>
				</Value>
				<Value Code="NQT">
					<Title>No quote</Title>
					<Description>No price available.</Description>
				</Value>
				<Value Code="NTP">
					<Title>Net unit price</Title>
					<Description>Unit price to which no allowances and charges apply.</Description>
				</Value>
				<Value Code="NW">
					<Title>Net weight</Title>
					<Description>Code specifying a net weight price.</Description>
				</Value>
				<Value Code="OFR">
					<Title>Ocean freight rate</Title>
					<Description>The price per pricing unit of ocean transportation services for moving cargo from one location to another.</Description>
				</Value>
				<Value Code="PAQ">
					<Title>Price break quantity(s)</Title>
					<Description>Numerical amounts of goods or services which are associated with different sums of money. As the amount goes up, the price per individual item decreases.</Description>
				</Value>
				<Value Code="PBQ">
					<Title>Unit price beginning quantity</Title>
					<Description>The starting amount at which you can place a value on a single item.</Description>
				</Value>
				<Value Code="PPD">
					<Title>Prepaid freight charges</Title>
					<Description>The cost of shipping is paid before the goods are shipped.</Description>
				</Value>
				<Value Code="PPR">
					<Title>Provisional price</Title>
					<Description>Price per unit of quantity of a product as provisionally agreed.</Description>
				</Value>
				<Value Code="PRO">
					<Title>Producer's price</Title>
					<Description>The value that the maker of a good places on an item.</Description>
				</Value>
				<Value Code="PRP">
					<Title>Promotional price</Title>
					<Description>The value that is placed on an item that is being developed. The idea is to sell this product for less than one normally would, and make up for it by selling a larger quantity.</Description>
				</Value>
				<Value Code="PW">
					<Title>Gross weight</Title>
					<Description>Code specifying a gross weight price.</Description>
				</Value>
				<Value Code="QTE">
					<Title>Quote price</Title>
					<Description>Price per unit of quantity of a product as specified in a quote.</Description>
				</Value>
				<Value Code="RES">
					<Title>Resale price</Title>
					<Description>Price per unit of quantity of a product to be used for resale.</Description>
				</Value>
				<Value Code="RTP">
					<Title>Retail price</Title>
					<Description>Price per unit of quantity of a product to be used for retail.</Description>
				</Value>
				<Value Code="SHD">
					<Title>Ship and debit</Title>
					<Description>To transport goods and be owed money by the customer for the services performed.</Description>
				</Value>
				<Value Code="SRP">
					<Title>Suggested retail price</Title>
					<Description>Price per unit of quantity of a product suggested for retail.</Description>
				</Value>
				<Value Code="SW">
					<Title>Gross weight without wooden pallets</Title>
					<Description>Used in steel industry.</Description>
				</Value>
				<Value Code="TB">
					<Title>To be negotiated</Title>
					<Description>Code specifying that the price has to be negotiated.</Description>
				</Value>
				<Value Code="TRF">
					<Title>Transfer</Title>
					<Description>To carry or remove from one place, situation, or person to another.</Description>
				</Value>
				<Value Code="TU">
					<Title>Traded unit</Title>
					<Description>Code specifying a traded unit price.</Description>
				</Value>
				<Value Code="TW">
					<Title>Theoretical weight</Title>
					<Description>Code specifying a price based on a theoretical weight.</Description>
				</Value>
				<Value Code="WH">
					<Title>Wholesale price</Title>
					<Description>Code specifying a wholesale price.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F5393" Length="3" Type="Alphanumeric">
