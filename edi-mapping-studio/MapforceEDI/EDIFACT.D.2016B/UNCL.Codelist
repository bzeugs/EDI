		<Field Name="F2151" Length="3" Type="Alphanumeric">
			<Title>Period type code</Title>
			<Description>Code specifying the type of period.</Description>
			<Values>
				<Value Code="3M">
					<Title>Quarter</Title>
					<Description>A subdivision of a year into four equal parts.</Description>
				</Value>
				<Value Code="6M">
					<Title>Half-year</Title>
					<Description>A subdivision of a year into two equal parts.</Description>
				</Value>
				<Value Code="AA">
					<Title>Air hour</Title>
					<Description>Flight duration irrespective of time zones.</Description>
				</Value>
				<Value Code="AD">
					<Title>Air day</Title>
					<Description>Flight duration irrespective of time zones.</Description>
				</Value>
				<Value Code="CD">
					<Title>Calendar day (includes weekends and holidays)</Title>
					<Description>Period given as a number of days including weekends and holidays.</Description>
				</Value>
				<Value Code="CW">
					<Title>Calendar week (7day)</Title>
					<Description>Period given as a number of 7day-weeks including holidays.</Description>
				</Value>
				<Value Code="D">
					<Title>Day</Title>
					<Description>The twenty-four hour period during which the earth completes one rotation on its axis.</Description>
				</Value>
				<Value Code="DC">
					<Title>Ten days period</Title>
					<Description>Period of 10 days.</Description>
				</Value>
				<Value Code="F">
					<Title>Period of two weeks</Title>
					<Description>A period of time lasting fourteen days. Synonym: Fortnight.</Description>
				</Value>
				<Value Code="H">
					<Title>Hour</Title>
					<Description>One of the twenty-four sub-divisions of a day.</Description>
				</Value>
				<Value Code="HM">
					<Title>Half month</Title>
					<Description>A subdivision of a month into two equal parts.</Description>
				</Value>
				<Value Code="M">
					<Title>Month</Title>
					<Description>One of twelve divisions of the year as determined by the Gregorian calendar.</Description>
				</Value>
				<Value Code="MN">
					<Title>Minute</Title>
					<Description>A unit of time equal to 1/60 of an hour, or 60 seconds.</Description>
				</Value>
				<Value Code="P">
					<Title>Four month period</Title>
					<Description>A period of time, measured in monthly increments, consisting of four sequential months.</Description>
				</Value>
				<Value Code="S">
					<Title>Second</Title>
					<Description>A unit of time equal to 1/60 of a minute.</Description>
				</Value>
				<Value Code="SD">
					<Title>Surface day</Title>
					<Description>The voyage duration irrespective of time zones.</Description>
				</Value>
				<Value Code="SI">
					<Title>Indefinite</Title>
					<Description>An indefinite period.</Description>
				</Value>
				<Value Code="W">
					<Title>Week</Title>
					<Description>Period of seven days.</Description>
				</Value>
				<Value Code="WD">
					<Title>Workday</Title>
					<Description>Day on which work is usually done.</Description>
				</Value>
				<Value Code="WW">
					<Title>5 day work week</Title>
					<Description>Monday through Friday.</Description>
				</Value>
				<Value Code="Y">
					<Title>Year</Title>
					<Description>The period of time as measured by the Gregorian calendar in which the earth completes a single revolution around the sun.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Period as per agreement.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F2155" Length="3" Type="Alphanumeric">
