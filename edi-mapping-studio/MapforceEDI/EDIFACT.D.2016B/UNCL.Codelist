		<Field Name="F8169" Length="3" Type="Alphanumeric">
			<Title>Full or empty indicator code</Title>
			<Description>Code indicating whether an object is full or empty.</Description>
			<Values>
				<Value Code="1">
					<Title>More than one quarter volume available</Title>
					<Description>Indicates that there is more than a quarter of the volume available.</Description>
				</Value>
				<Value Code="2">
					<Title>More than half volume available</Title>
					<Description>Indicates that there is more than a half of the volume available.</Description>
				</Value>
				<Value Code="3">
					<Title>More than three quarters volume available</Title>
					<Description>Indicates that there is more than three quarters of the volume available.</Description>
				</Value>
				<Value Code="4">
					<Title>Empty</Title>
					<Description>Indicates that the object is empty.</Description>
				</Value>
				<Value Code="5">
					<Title>Full</Title>
					<Description>Indicates that the object is full.</Description>
				</Value>
				<Value Code="6">
					<Title>No volume available</Title>
					<Description>Indicates that there is no space available in the object.</Description>
				</Value>
				<Value Code="7">
					<Title>Full, mixed consignment</Title>
					<Description>Indicates that the equipment is fully loaded, and includes a number LCL (Less Than Container Load) consignments.</Description>
				</Value>
				<Value Code="8">
					<Title>Full, single consignment</Title>
					<Description>Indicates that the container is fully loaded with a single FCL (Full Container Load) consignment.</Description>
				</Value>
				<Value Code="9">
					<Title>Part load</Title>
					<Description>Container represents part of a consignment declared on a single Customs declaration (i.e. the Customs declaration covers more than one container).</Description>
				</Value>
				<Value Code="10">
					<Title>Part load mixed consignments</Title>
					<Description>Container represents part of the consignment declared on a single Customs declaration with the remainder being in other containers. Other goods, related to other declarations, are also in the container.</Description>
				</Value>
				<Value Code="11">
					<Title>Single invoiced load</Title>
					<Description>Merchandise within a container/package covered by a single invoice.</Description>
				</Value>
				<Value Code="12">
					<Title>Multi invoiced load</Title>
					<Description>Merchandise within a container/package covered by more than one invoice.</Description>
				</Value>
				<Value Code="13">
					<Title>Full load, multiple bills</Title>
					<Description>A container representing a consignment of goods for one consignee with multiple bill of lading numbers.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8179" Length="8" Type="Alphanumeric" Incomplete="1">
			<Title>Transport means description code</Title>
			<Description>Code specifying the means of transport.</Description>
			<Note>1 Use UN/ECE recommendation 28.
</Note>
			<Values>
				<Value Code="1">
					<Title>Box tricycle</Title>
					<Description>Tricycle with a basket for delivering goods.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8249" Length="3" Type="Alphanumeric">
			<Title>Equipment status code</Title>
			<Description>Code specifying the status of equipment.</Description>
			<Values>
				<Value Code="1">
					<Title>Continental</Title>
					<Description>The equipment is or will be moving across a continent on an intermodal or multimodal basis.</Description>
				</Value>
				<Value Code="2">
					<Title>Export</Title>
					<Description>Transport equipment to be exported on a marine vessel.</Description>
				</Value>
				<Value Code="3">
					<Title>Import</Title>
					<Description>Transport equipment to be imported on a marine vessel.</Description>
				</Value>
				<Value Code="4">
					<Title>Remain on board</Title>
					<Description>Transport equipment arriving on a marine vessel is to remain on board.</Description>
				</Value>
				<Value Code="5">
					<Title>Shifter</Title>
					<Description>Transport equipment is to be shifted from one stowage location on a marine vessel to another on the same vessel.</Description>
				</Value>
				<Value Code="6">
					<Title>Transhipment</Title>
					<Description>Transport equipment is to be transferred from one marine vessel to another.</Description>
				</Value>
				<Value Code="7">
					<Title>Shortlanded</Title>
					<Description>Transport equipment notified to arrive which did not arrive on the means of transport.</Description>
				</Value>
				<Value Code="8">
					<Title>Overlanded</Title>
					<Description>Transport equipment not notified to arrive but which did arrive on the means of transport.</Description>
				</Value>
				<Value Code="9">
					<Title>Domestic</Title>
					<Description>Transport equipment is used in domestic service.</Description>
				</Value>
				<Value Code="10">
					<Title>Positioning</Title>
					<Description>Equipment is being transported for positioning purposes.</Description>
				</Value>
				<Value Code="11">
					<Title>Delivery</Title>
					<Description>Equipment is being delivered.</Description>
				</Value>
				<Value Code="12">
					<Title>Redelivery</Title>
					<Description>Equipment is being redelivered.</Description>
				</Value>
				<Value Code="13">
					<Title>Repair</Title>
					<Description>The equipment is for repair.</Description>
				</Value>
				<Value Code="14">
					<Title>Reloader</Title>
					<Description>Transport equipment to be discharged and subsequently reloaded on the same means of transport but in a different stowage location.</Description>
				</Value>
				<Value Code="15">
					<Title>Returned</Title>
					<Description>The equipment is returned.</Description>
				</Value>
				<Value Code="16">
					<Title>Dropped off</Title>
					<Description>The equipment is dropped off.</Description>
				</Value>
				<Value Code="17">
					<Title>Cross terminal transshipment</Title>
					<Description>The transport equipment that is unloaded will be loaded in another vessel at another terminal in the same port.</Description>
				</Value>
				<Value Code="18">
					<Title>Booking confirmed</Title>
					<Description>Notification of the confirmation of booking of a transport equipment.</Description>
				</Value>
				<Value Code="19">
					<Title>Inspected at terminal gate</Title>
					<Description>Notification that a transport equipment has undergone a terminal gate inspection.</Description>
				</Value>
				<Value Code="20">
					<Title>Arrived at offloading location</Title>
					<Description>Notification that a transport equipment arrived at the offloading location.</Description>
				</Value>
				<Value Code="21">
					<Title>Departed from loading location.</Title>
					<Description>Notification that a transport equipment departed from the loading location.</Description>
				</Value>
				<Value Code="22">
					<Title>Loaded</Title>
					<Description>Notification that a transport equipment has been loaded.</Description>
				</Value>
				<Value Code="23">
					<Title>Unloaded</Title>
					<Description>Notification that a transport equipment has been unloaded.</Description>
				</Value>
				<Value Code="24">
					<Title>Intra-terminal movement</Title>
					<Description>Notification that a transport equipment has been subject to an intra-terminal movement.</Description>
				</Value>
				<Value Code="25">
					<Title>Stuffing ordered</Title>
					<Description>Notification that a transport equipment has been ordered to be stuffed.</Description>
				</Value>
				<Value Code="26">
					<Title>Stripping ordered</Title>
					<Description>Notification that a transport equipment has been ordered to be stripped.</Description>
				</Value>
				<Value Code="27">
					<Title>Stuffing confirmed</Title>
					<Description>Notification that a transport equipment has been confirmed as stuffed.</Description>
				</Value>
				<Value Code="28">
					<Title>Stripping confirmed</Title>
					<Description>Notification that a transport equipment has been confirmed as stripped.</Description>
				</Value>
				<Value Code="29">
					<Title>Sent for heavy repair</Title>
					<Description>Notification that a transport equipment has been sent for heavy repair.</Description>
				</Value>
				<Value Code="30">
					<Title>Replaced</Title>
					<Description>One piece of transport equipment replaced by another during operations.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8273" Length="3" Type="Alphanumeric">
			<Title>Dangerous goods regulations code</Title>
			<Description>Code specifying a dangerous goods regulation.</Description>
			<Values>
				<Value Code="ADR">
					<Title>European agreement on the international carriage of</Title>
					<Description>dangerous goods on road (ADR) European agreement on the international carriage of dangerous goods on road. ADR is the abbreviation of "Accord europeen relatif au transport international des marchandises dangereuses par route".</Description>
				</Value>
				<Value Code="ADS">
					<Title>NDR European agreement for the transport of dangerous goods</Title>
					<Description>on the river Rhine European agreement giving regulations for the transport of dangerous goods on the river Rhine, officially known as: "Accord europeen relatif au transport international des marchandises dangereuses par navigation sur le Rhin.".</Description>
				</Value>
				<Value Code="ADT">
					<Title>CA, Transport Canada's dangerous goods requirements</Title>
					<Description>Canadian transport of dangerous goods requirements as published by Transport Canada in the Canadian Gazette, Part II.</Description>
				</Value>
				<Value Code="ADU">
					<Title>JP, Japanese maritime safety agency dangerous goods</Title>
					<Description>regulation code Regulation regarding the handling of dangerous goods on vessels issued by Japanese maritime safety agency.</Description>
				</Value>
				<Value Code="ADV">
					<Title>MARPOL 73/78</Title>
					<Description>International Convention for the Prevention of Pollution from Ships, 1973, as modified by the Protocol of 1978 relating.</Description>
				</Value>
				<Value Code="ADW">
					<Title>GHS regulation</Title>
					<Description>The United Nations Globally Harmonized System of Classification and Labelling of Chemicals.</Description>
				</Value>
				<Value Code="AGS">
					<Title>DE, ADR and GGVS combined regulations for combined</Title>
					<Description>transport Combined German and European regulations for the transportation of dangerous goods on German and other European roads. ADR means: Accord Europeen relatif au Transport international des marchandises Dangereuses par Route. GGVS means: Gefahrgutverordnung Strasse.</Description>
				</Value>
				<Value Code="ANR">
					<Title>ADNR, Autorisation de transport de matieres Dangereuses</Title>
					<Description>pour la Navigation sur le Rhin Regulations for dangerous goods transportation on the Rhine.</Description>
				</Value>
				<Value Code="ARD">
					<Title>DE, ARD and RID - Combined regulations for combined</Title>
					<Description>transport Combined European regulations for the combined transportation of dangerous goods on roads and rails. ARD means: Autorisation de transport par Route de matieres dangereuses. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer.</Description>
				</Value>
				<Value Code="CFR">
					<Title>US, 49 Code of federal regulations</Title>
					<Description>United States federal regulations issued by the US Department of transportation covering the domestic transportation of dangerous goods by truck, rail, water and air.</Description>
				</Value>
				<Value Code="COM">
					<Title>DE, ADR, RID, GGVS and GGVE - Combined regulations for</Title>
					<Description>combined transport Combined German and European regulations for the combined transportation of dangerous goods on German and other European roads and rails. ADR means: Accord Europeen relatif au transport international des marchandises Dangereuse par Route. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer. GGVS means: Gefahrgutverordnung Strasse. GGVE means: Gefahrgutverordnung Eisenbahn.</Description>
				</Value>
				<Value Code="GVE">
					<Title>DE, GGVE (Gefahrgutverordnung Eisenbahn)</Title>
					<Description>German regulation for the transportation of dangerous goods on rail.</Description>
				</Value>
				<Value Code="GVS">
					<Title>DE, GGVS (Gefahrgutverordnung Strasse)</Title>
					<Description>German regulation for the transportation of dangerous goods on road.</Description>
				</Value>
				<Value Code="ICA">
					<Title>IATA ICAO</Title>
					<Description>Regulations covering the international transportation of dangerous goods issued by the International Air Transport Association and the International Civil Aviation Organization.</Description>
				</Value>
				<Value Code="IMD">
					<Title>IMO IMDG code</Title>
					<Description>Regulations regarding the transportation of dangerous goods on ocean-going vessels issued by the International Maritime Organization.</Description>
				</Value>
				<Value Code="RGE">
					<Title>DE, RID and GGVE, Combined regulations for combined</Title>
					<Description>transport on rails Combined German and European regulations for the transportation of dangerous goods on German and other European rails. RID means: Reglement International concernant le transport des marchandises Dangereuses par chemin de fer. GGVE means: Gefahrgutverordnung Eisenbahn.</Description>
				</Value>
				<Value Code="RID">
					<Title>Railroad dangerous goods book (RID)</Title>
					<Description>International regulations concerning the international carriage of dangerous goods by rail. RID is the abbreviation of "Reglement International concernant le transport des marchandises Dangereuses par chemin de fer".</Description>
				</Value>
				<Value Code="UI">
					<Title>UK IMO book</Title>
					<Description>The United Kingdom (UK) version of the International Maritime Organisation (IMO) book on dangerous goods.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Additional and/or other information for the transportation of dangerous goods which are mutually defined.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8281" Length="3" Type="Alphanumeric">
			<Title>Transport means ownership indicator code</Title>
			<Description>Code indicating the ownership of a means of transport.</Description>
			<Values>
				<Value Code="1">
					<Title>Transport for the owner's account</Title>
					<Description>The owner of the transported goods is also the owner of the means of transport or rented it for this transport.</Description>
				</Value>
				<Value Code="2">
					<Title>Transport for another account</Title>
					<Description>The owner of the transported goods does not own the means of transport or has not rented it for this transport.</Description>
				</Value>
				<Value Code="3">
					<Title>Private transport</Title>
					<Description>A code indicating privately owned transport.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8323" Length="3" Type="Alphanumeric">
			<Title>Transport movement code</Title>
			<Description>Code specifying the transport movement.</Description>
			<Values>
				<Value Code="1">
					<Title>Export</Title>
					<Description>The transport movement is to export the goods from the country.</Description>
				</Value>
				<Value Code="2">
					<Title>Import</Title>
					<Description>The transport movement is to import the goods into the country.</Description>
				</Value>
				<Value Code="3">
					<Title>Transit</Title>
					<Description>The cargo is moving in transit through a country and will not become part of the commerce of that country.</Description>
				</Value>
				<Value Code="4">
					<Title>Relay</Title>
					<Description>The cargo is being moved by more than one transport means in succession under the responsibility of the same carrier.</Description>
				</Value>
				<Value Code="5">
					<Title>Transshipment</Title>
					<Description>The cargo is being moved by more than one transport means in succession.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8335" Length="3" Type="Alphanumeric">
			<Title>Movement type description code</Title>
			<Description>Code specifying a type of movement.</Description>
			<Values>
				<Value Code="1">
					<Title>Breakbulk</Title>
					<Description>Defines the movement of general cargo not carried in ISO standard containers.</Description>
				</Value>
				<Value Code="2">
					<Title>LCL/LCL</Title>
					<Description>Defines the movement of cargo packed in and unpacked from containers by the carrier on behalf of the shipper/consignee. 'LCL' means Less than Container Load.</Description>
				</Value>
				<Value Code="3">
					<Title>FCL/FCL</Title>
					<Description>Defines the movement of cargo packed by the shipper or shipper's agent and unpacked by the consignee or consignee's agent. 'FCL' means Full Container Load.</Description>
				</Value>
				<Value Code="4">
					<Title>FCL/LCL</Title>
					<Description>Defines the movement of cargo packed by the shipper or shipper's agent and unpacked by the carrier. 'FCL' means Full Container Load. 'LCL' means Less than Container Load.</Description>
				</Value>
				<Value Code="5">
					<Title>LCL/FCL</Title>
					<Description>Defines the movement of cargo packed by the carrier and unpacked by the consignee or consignee's agent. 'LCL' means Less than Container Load. 'FCL' means Full Load.</Description>
				</Value>
				<Value Code="6">
					<Title>Consolidation</Title>
					<Description>A movement of multiple shipments to a single destination.</Description>
				</Value>
				<Value Code="7">
					<Title>Parcel post</Title>
					<Description>A movement of material by parcel post.</Description>
				</Value>
				<Value Code="8">
					<Title>Expedited truck</Title>
					<Description>A movement of material by expedited truck.</Description>
				</Value>
				<Value Code="9">
					<Title>Consignor determined means</Title>
					<Description>A movement of material by the means determined by the consignor.</Description>
				</Value>
				<Value Code="10">
					<Title>Private parcel service</Title>
					<Description>A movement of material by a private parcel service.</Description>
				</Value>
				<Value Code="11">
					<Title>House to house</Title>
					<Description>Cargo packed in a unit by the shipper at point of origin and unpacked by consignee at final destination.</Description>
				</Value>
				<Value Code="12">
					<Title>House to terminal</Title>
					<Description>Cargo packed in a unit by the shipper at point of origin and unpacked at the carrier's inland facility between the ship's point of discharge and the final destination.</Description>
				</Value>
				<Value Code="13">
					<Title>House to pier</Title>
					<Description>Cargo packed in a unit by the shipper at point of origin and unpacked by carrier at ship's point of discharge (pier).</Description>
				</Value>
				<Value Code="14">
					<Title>Air charter</Title>
					<Description>A movement of material by chartered aircraft.</Description>
				</Value>
				<Value Code="15">
					<Title>Air express</Title>
					<Description>A movement of material by air express service.</Description>
				</Value>
				<Value Code="16">
					<Title>Geographic grouped transport</Title>
					<Description>A movement of material from multiple origins to a single destination utilizing a single carrier and a single freight bill.</Description>
				</Value>
				<Value Code="17">
					<Title>Less than truck load</Title>
					<Description>A movement of material on a truck that is not full.</Description>
				</Value>
				<Value Code="18">
					<Title>Pooled piggyback</Title>
					<Description>A movement of material by a trailer on a railcar.</Description>
				</Value>
				<Value Code="19">
					<Title>Consignee transportation provided</Title>
					<Description>A movement of material transported by the consignee.</Description>
				</Value>
				<Value Code="20">
					<Title>Rail</Title>
					<Description>A movement of material to the consignee via rail.</Description>
				</Value>
				<Value Code="21">
					<Title>Terminal to house</Title>
					<Description>Cargo packed in a unit at a carrier's inland facility between point of origin and the ship's point of loading and unpacked by consignee at the final destination.</Description>
				</Value>
				<Value Code="22">
					<Title>Terminal to terminal</Title>
					<Description>Cargo packed in a unit at a carrier's inland facility between point of origin and the ship's point of loading and unpacked at a carrier's inland facility between ship's point of discharge and final destination.</Description>
				</Value>
				<Value Code="23">
					<Title>Terminal to pier</Title>
					<Description>Cargo packed in a unit at a carrier's inland facility between point of origin and ship's point of loading and unpacked by carrier at ship's point of discharge (pier).</Description>
				</Value>
				<Value Code="31">
					<Title>Pier to house</Title>
					<Description>Cargo packed in a unit at ship's point of loading and unpacked by consignee at final destination.</Description>
				</Value>
				<Value Code="32">
					<Title>Pier to terminal</Title>
					<Description>Cargo packed in a unit at ship's point of loading and unpacked at a carrier's inland facility between ship's point of discharge and final destination.</Description>
				</Value>
				<Value Code="33">
					<Title>Pier to pier</Title>
					<Description>Cargo packed in a unit at ship's point of loading and unpacked by carrier at ship's point of discharge (pier).</Description>
				</Value>
				<Value Code="41">
					<Title>Station to station</Title>
					<Description>The consignment is moving from one container freight station to another container freight station.</Description>
				</Value>
				<Value Code="42">
					<Title>House to warehouse</Title>
					<Description>The consignment is moving from the premises of the shipper to a warehouse.</Description>
				</Value>
				<Value Code="43">
					<Title>Warehouse to house</Title>
					<Description>The consignment is moving from a warehouse to the premises of the consignee.</Description>
				</Value>
				<Value Code="44">
					<Title>Station to house</Title>
					<Description>The cargo is moving from a container freight station to the premises of the consignee.</Description>
				</Value>
				<Value Code="45">
					<Title>Geographic grouped transport, multiple origins, multiple</Title>
					<Description>destinations A movement of material from multiple origins to multiple destinations using a single carrier and a single freight bill.</Description>
				</Value>
				<Value Code="46">
					<Title>Geographic grouped transport, multiple origins, single</Title>
					<Description>destination A movement of material from multiple origins to a single destination utilizing a single carrier and a single freight bill.</Description>
				</Value>
				<Value Code="47">
					<Title>Geographic receiving</Title>
					<Description>A collection of shipments that involve a single origin, multiple destinations, and a single trailer, and are paid under a single freight bill.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8339" Length="3" Type="Alphanumeric">
			<Title>Packaging danger level code</Title>
			<Description>Code specifying the level of danger for which the packaging must cater.</Description>
			<Values>
				<Value Code="1">
					<Title>Great danger</Title>
					<Description>Packaging meeting criteria to pack hazardous materials with great danger. Group I according to IATA/IMDG/ADR/RID regulations.</Description>
				</Value>
				<Value Code="2">
					<Title>Medium danger</Title>
					<Description>Packaging meeting criteria to pack hazardous materials with medium danger. Group II according to IATA/IDMG/ADR/RID regulations.</Description>
				</Value>
				<Value Code="3">
					<Title>Minor danger</Title>
					<Description>Packaging meeting criteria to pack hazardous materials with minor danger. Group III according to IATA/IDMG/ADR/RID regulations.</Description>
				</Value>
				<Value Code="4">
					<Title>Not assigned</Title>
					<Description>No packaging danger level has been assigned.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8341" Length="3" Type="Alphanumeric">
			<Title>Haulage arrangements code</Title>
			<Description>Code specifying the arrangement for the haulage of goods.</Description>
			<Values>
				<Value Code="1">
					<Title>Carrier</Title>
					<Description>Haulage arranged by carrier.</Description>
				</Value>
				<Value Code="2">
					<Title>Merchant</Title>
					<Description>Haulage arranged by merchant (shipper, consignee, or their agent).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F8393" Length="3" Type="Alphanumeric">
