					<Description>The payment terms require the use of an irrevocable letter of credit.</Description>
				</Value>
				<Value Code="61">
					<Title>Documents against acceptance</Title>
					<Description>The payment terms require acceptance of liability before document transfer.</Description>
				</Value>
				<Value Code="62">
					<Title>Charge card</Title>
					<Description>The payment terms permit the use of a charge card to effect payment.</Description>
				</Value>
				<Value Code="63">
					<Title>Documents against payment</Title>
					<Description>The payment terms require payment before document transfer.</Description>
				</Value>
				<Value Code="64">
					<Title>Usance bill</Title>
					<Description>The payment terms are based on the time allowed by commercial usage for the payment of foreign bills of exchange.</Description>
				</Value>
				<Value Code="65">
