					<Description>Invoices in currencies other than the currency of the credit cover are expected.</Description>
				</Value>
				<Value Code="2">
					<Title>Request new limit</Title>
					<Description>Seller requests new limit.</Description>
				</Value>
				<Value Code="3">
					<Title>Request increased limit</Title>
					<Description>Seller requests increase of existing limit.</Description>
				</Value>
				<Value Code="4">
