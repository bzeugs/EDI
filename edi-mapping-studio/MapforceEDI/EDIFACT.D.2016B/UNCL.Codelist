				</Value>
				<Value Code="3">
					<Title>Per month</Title>
					<Description>The associated charge applies to each month the service is provided.</Description>
				</Value>
				<Value Code="4">
					<Title>Per rental</Title>
					<Description>The associated charge applies to the entire length of time the service is provided.</Description>
				</Value>
				<Value Code="5">
					<Title>Per hour</Title>
					<Description>The associated charge applies to each hour the service is provided.</Description>
				</Value>
				<Value Code="6">
					<Title>Per minute</Title>
					<Description>The associated charge applies to each minute the service is provided.</Description>
				</Value>
