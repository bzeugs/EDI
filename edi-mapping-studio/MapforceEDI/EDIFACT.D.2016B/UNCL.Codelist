		<Field Name="F8051" Length="3" Type="Alphanumeric">
			<Title>Transport stage code qualifier</Title>
			<Description>Code qualifying a specific stage of transport.</Description>
			<Values>
				<Value Code="1">
					<Title>Inland transport</Title>
					<Description>Transport by which goods are moved from or to the frontier, or between inland points.</Description>
				</Value>
				<Value Code="2">
					<Title>At the statistical territory limit</Title>
					<Description>Point by which the means of transport are presumed to have left the statistical territory of despatch or to have entered the statistical territory of arrival.</Description>
				</Value>
				<Value Code="3">
					<Title>At arrival</Title>
					<Description>Transport by which goods are moved to the place of arrival.</Description>
				</Value>
				<Value Code="4">
					<Title>Means of transport at transit</Title>
					<Description>The means of transport used to carry goods that have come under transit procedures of the customs administration to which a transit declaration is being made.</Description>
				</Value>
				<Value Code="5">
					<Title>Means of transport crossing the regulatory border</Title>
					<Description>The means of transport moving into and out of a regulatory territory.</Description>
				</Value>
				<Value Code="6">
					<Title>Means of transport at first port of arrival into regulatory</Title>
					<Description>territory The means of transport moving into a regulatory territory at the first port of arrival.</Description>
				</Value>
				<Value Code="10">
					<Title>Pre-carriage transport</Title>
					<Description>Transport by which the goods are moved prior to their main carriage transport.</Description>
				</Value>
				<Value Code="11">
					<Title>At border</Title>
					<Description>Transport by which goods are moved to the Customs frontier.</Description>
				</Value>
				<Value Code="12">
					<Title>At departure</Title>
					<Description>Transport by which goods are moved from the place of departure.</Description>
				</Value>
				<Value Code="13">
					<Title>At destination</Title>
					<Description>Transport by which goods are moved at the place of destination.</Description>
				</Value>
				<Value Code="15">
					<Title>Main carriage - fourth carrier</Title>
					<Description>The fourth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="16">
					<Title>Main carriage - fifth carrier</Title>
					<Description>The fifth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="17">
					<Title>Main carriage - sixth carrier</Title>
					<Description>The sixth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="18">
					<Title>Main carriage - seventh carrier</Title>
					<Description>The seventh carrier of the ordered transport.</Description>
				</Value>
				<Value Code="19">
					<Title>Main carriage - eighth carrier</Title>
					<Description>The eighth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="20">
					<Title>Main-carriage transport</Title>
					<Description>The primary stage in the movement of cargo from the point of origin to the intended destination.</Description>
				</Value>
				<Value Code="21">
					<Title>Main carriage - first carrier</Title>
					<Description>The first carrier of the ordered transport when more than one carrier is involved.</Description>
				</Value>
				<Value Code="22">
					<Title>Main carriage - second carrier</Title>
					<Description>The second carrier of the ordered transport when more than one carrier is involved.</Description>
				</Value>
				<Value Code="23">
					<Title>Main carriage - third carrier</Title>
					<Description>The third carrier of the ordered transport when more than one carrier is involved.</Description>
				</Value>
				<Value Code="24">
					<Title>Inland waterway transport</Title>
					<Description>Transport by which goods are moved via an inland body of water.</Description>
				</Value>
				<Value Code="25">
					<Title>Delivery carrier all transport</Title>
					<Description>Carrier responsible from the point of origin to the final delivery destination.</Description>
				</Value>
				<Value Code="26">
					<Title>Second pre-carriage transport</Title>
					<Description>Second transport by which the goods are moved prior to their main carriage transport.</Description>
				</Value>
				<Value Code="27">
					<Title>Pre-acceptance transport</Title>
					<Description>The transport by which the goods are moved to the place of acceptance.</Description>
				</Value>
				<Value Code="28">
					<Title>Second on-carriage transport</Title>
					<Description>Second transport by which the goods are moved after the main carriage transport.</Description>
				</Value>
				<Value Code="29">
					<Title>Main carriage - ninth carrier</Title>
					<Description>The ninth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="30">
					<Title>On-carriage transport</Title>
					<Description>Transport by which the goods are moved after the main carriage transport.</Description>
				</Value>
				<Value Code="31">
					<Title>Main carriage - tenth carrier</Title>
					<Description>The tenth carrier of the ordered transport.</Description>
				</Value>
				<Value Code="32">
					<Title>Main carriage - eleventh carrier</Title>
					<Description>The eleventh carrier of the ordered transport.</Description>
				</Value>
				<Value Code="33">
