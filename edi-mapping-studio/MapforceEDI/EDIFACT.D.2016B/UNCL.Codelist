					<Description>credit A credit transaction made through the ACH system to a demand deposit account using the CCD+ payment format.</Description>
				</Value>
				<Value Code="33">
					<Title>ACH demand cash concentration/disbursement plus (CCD+)</Title>
					<Description>debit A debit transaction made through the ACH system to a demand deposit account using the CCD+ payment format.</Description>
				</Value>
				<Value Code="34">
					<Title>ACH prearranged payment and deposit (PPD)</Title>
