				<Value Code="9">
					<Title>Disposal of waste to be arranged</Title>
					<Description>Request to arrange the disposal of waste.</Description>
				</Value>
				<Value Code="10">
					<Title>Transshipment to be arranged</Title>
					<Description>The consignment has to be transshipped.</Description>
				</Value>
				<Value Code="11">
					<Title>Refrigeration required</Title>
					<Description>Item must be refrigerated for proper handling.</Description>
				</Value>
				<Value Code="12">
					<Title>Refrigeration not required</Title>
					<Description>Item does not need to be refrigerated for proper handling.</Description>
				</Value>
				<Value Code="13">
					<Title>Destroy</Title>
					<Description>The identified goods are to be destroyed according to specified instructions.</Description>
				</Value>
				<Value Code="14">
					<Title>Keep frozen</Title>
					<Description>The identified products is frozen and should be kept frozen.</Description>
				</Value>
				<Value Code="15">
					<Title>Hang garment</Title>
					<Description>The identified product(s) should be handled as a hanging garment.</Description>
				</Value>
				<Value Code="16">
					<Title>Labelling required</Title>
					<Description>The identified product is/are to be labelled.</Description>
				</Value>
				<Value Code="17">
					<Title>Keep in lying position</Title>
					<Description>The identified product(s) should be kept in a lying position.</Description>
				</Value>
				<Value Code="18">
					<Title>Move according to instructions</Title>
					<Description>The identified product is to be moved according to instructions specified.</Description>
				</Value>
				<Value Code="19">
					<Title>Pack according to instructions</Title>
					<Description>The identified product is to be packed according to the instructions provided.</Description>
				</Value>
				<Value Code="20">
					<Title>Prepare for shipment</Title>
					<Description>The identified product(s) is(are) to be prepared for shipment.</Description>
				</Value>
				<Value Code="21">
					<Title>Reserve according to instructions</Title>
					<Description>Reserve identified goods according to specified instructions.</Description>
				</Value>
				<Value Code="22">
					<Title>Light sensitive</Title>
					<Description>The product is sensitive to light.</Description>
				</Value>
				<Value Code="23">
					<Title>Transit or cross docking delivery required</Title>
					<Description>The identified product is to be delivered via a transit or cross docking facility.</Description>
				</Value>
				<Value Code="24">
					<Title>Unpacking required</Title>
					<Description>The identified product is to be unpacked from the identified package.</Description>
				</Value>
				<Value Code="25">
					<Title>Keep in upright/standing position</Title>
					<Description>The identified product should be kept in an upright or standing position.</Description>
				</Value>
			</Values>
		</Field>
