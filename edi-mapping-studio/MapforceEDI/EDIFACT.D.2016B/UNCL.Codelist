					<Description>Message content is definitive.</Description>
				</Value>
				<Value Code="48">
					<Title>Accepted, contents rejected</Title>
					<Description>Message to inform that the previous message is received, but it cannot be processed due to regulations, laws, etc.</Description>
				</Value>
				<Value Code="49">
					<Title>Settled dispute</Title>
					<Description>The reported dispute is settled.</Description>
				</Value>
				<Value Code="50">
					<Title>Withdraw</Title>
					<Description>Message withdrawing a previously approved message.</Description>
				</Value>
				<Value Code="51">
