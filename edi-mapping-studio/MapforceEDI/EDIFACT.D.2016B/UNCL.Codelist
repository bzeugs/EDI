					<Description>The payer has provided possession of, or title in goods, as security against payment.</Description>
				</Value>
				<Value Code="21">
					<Title>Business as security</Title>
					<Description>The payer has provided title in, or a lien over a business whose assets may be sold or sequestered, as security against payment.</Description>
				</Value>
				<Value Code="23">
					<Title>Warrant or similar (warehouse receipts)</Title>
					<Description>The payer has provided a warrant or warehouse receipts for goods or property to be held or used as security against payment.</Description>
				</Value>
				<Value Code="24">
					<Title>Mortgage</Title>
					<Description>The payer has provided a mortgage as security against payment.</Description>
				</Value>
				<Value Code="45">
					<Title>Insurance certificate</Title>
					<Description>A certificate of insurance has been provided as a guarantee of eventual payment.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
				</Value>
			</Values>
		</Field>
