					<Description>There will be no further shipments for this order as it is considered complete.</Description>
				</Value>
				<Value Code="165">
					<Title>Split shipment</Title>
					<Description>Subsequent shipment(s) will arrive for this order as it has been split over more than one shipment.</Description>
				</Value>
				<Value Code="166">
					<Title>Include in continuous replenishment calculation</Title>
					<Description>An indication that a product or group of products are to be included in the continuous replenishment calculation.</Description>
				</Value>
				<Value Code="167">
					<Title>Remove from continuous replenishment calculation</Title>
					<Description>An indication that a product or group of products are to be removed from the continuous replenishment calculation.</Description>
				</Value>
				<Value Code="168">
					<Title>Standard pack shipment</Title>
					<Description>The shipment contains only standard packs.</Description>
				</Value>
				<Value Code="169">
					<Title>Pick pack shipment</Title>
					<Description>The shipment contains only packages resulting from a pick and pack operation.</Description>
				</Value>
				<Value Code="170">
					<Title>Goods for retail outlet shelf</Title>
					<Description>Goods to be placed on a retail outlet shelf.</Description>
				</Value>
				<Value Code="171">
					<Title>Security stock</Title>
					<Description>The goods are required to maintain the security stock.</Description>
				</Value>
				<Value Code="172">
					<Title>Production batch number allocated</Title>
					<Description>A batch number is allocated by the manufacturer to the item.</Description>
				</Value>
				<Value Code="173">
					<Title>Production batch number allocated as required by law</Title>
					<Description>A batch number is allocated by the manufacturer to the item as required by law.</Description>
				</Value>
				<Value Code="174">
					<Title>Product not genetically modified</Title>
					<Description>An indication that a product has not been genetically modified during its production process.</Description>
				</Value>
				<Value Code="175">
					<Title>Suspended</Title>
					<Description>An item whose production or distribution has been suspended.</Description>
				</Value>
				<Value Code="176">
					<Title>No re-ordering</Title>
					<Description>The item will not be re-ordered.</Description>
				</Value>
				<Value Code="177">
					<Title>Product irradiated for preservation</Title>
					<Description>An indication that a product has had radioactive rays directed onto it to preserve it.</Description>
				</Value>
				<Value Code="178">
					<Title>Services taxable at customer location</Title>
					<Description>Services which, for taxation purposes, are considered to be supplied at the customer location, as per the 6th European Council directive of 17 May, 1997 Article 9.2 (e).</Description>
				</Value>
				<Value Code="179">
					<Title>Product gluten-free</Title>
					<Description>An indication that a product does not contain any gluten.</Description>
				</Value>
				<Value Code="180">
					<Title>Product contains gluten</Title>
					<Description>An indication that a product contains gluten.</Description>
				</Value>
				<Value Code="181">
					<Title>Product lactose-free</Title>
					<Description>An indication that a product does not contain any lactose.</Description>
				</Value>
				<Value Code="182">
					<Title>Product contains lactose</Title>
					<Description>An indication that a product contains lactose.</Description>
				</Value>
				<Value Code="183">
					<Title>CH, compliant with Genetically Modified Food law</Title>
					<Description>An indication that a product complies with the Swiss law on genetically modified food.</Description>
				</Value>
				<Value Code="184">
					<Title>CH, non-compliant with Genetically Modified Food law</Title>
					<Description>An indication that a product does not comply with the Swiss law on genetically modified food.</Description>
				</Value>
				<Value Code="185">
					<Title>CH, compliant with General Food law</Title>
					<Description>An indication that a product complies with the Swiss general food law.</Description>
				</Value>
				<Value Code="186">
					<Title>CH, non-compliant with General Food law</Title>
					<Description>An indication that a product does not comply with the Swiss general food law.</Description>
				</Value>
				<Value Code="187">
					<Title>Store may not order</Title>
					<Description>The store is not allowed to order.</Description>
				</Value>
				<Value Code="188">
					<Title>Distribution centre may not order</Title>
					<Description>Distribution centre is not allowed to order.</Description>
				</Value>
				<Value Code="189">
					<Title>Net content declaration indicated</Title>
					<Description>A declaration of a trade item's net content is on the product label.</Description>
				</Value>
				<Value Code="190">
					<Title>Net content declaration not indicated</Title>
					<Description>A declaration of a trade item's net content is not on the product label.</Description>
				</Value>
				<Value Code="191">
					<Title>Not irradiated</Title>
					<Description>Radiation has not been applied.</Description>
				</Value>
				<Value Code="192">
					<Title>Batch or lot number not allocated</Title>
					<Description>The trade item has no batch or lot number.</Description>
				</Value>
				<Value Code="193">
					<Title>Unsold trade item not returnable</Title>
					<Description>A trade item that is not sold cannot be returned.</Description>
				</Value>
				<Value Code="194">
					<Title>Ingredient irradiated</Title>
					<Description>Radiation has been applied to a trade item's ingredient.</Description>
				</Value>
				<Value Code="195">
					<Title>Ingredients not irradiated</Title>
					<Description>Radiation has not been applied to any trade item's ingredient.</Description>
				</Value>
				<Value Code="196">
					<Title>Raw material irradiated</Title>
					<Description>Radiation has been applied to a trade item's raw material.</Description>
				</Value>
				<Value Code="197">
					<Title>Raw material not irradiated</Title>
					<Description>Radiation has not been applied to any trade item's raw material.</Description>
				</Value>
				<Value Code="198">
					<Title>Re-orderable</Title>
					<Description>The item may be re-ordered.</Description>
				</Value>
				<Value Code="199">
					<Title>Receipt advice, fully detailed</Title>
					<Description>Includes qualitative and/or quantitative details regarding everything received (all line items) whether or not there were exceptions between what was received and what was advised as being sent.</Description>
				</Value>
				<Value Code="200">
					<Title>Receipt advice, only exceptions</Title>
					<Description>Includes only qualitative and/or quantitative exceptions between what was received and what was advised as being sent.</Description>
				</Value>
				<Value Code="201">
					<Title>Ingredient is irradiated not applicable</Title>
					<Description>The indication that an ingredient of a trade item is irradiated is not applicable.</Description>
				</Value>
				<Value Code="202">
					<Title>Raw material is irradiated not applicable</Title>
					<Description>The indication that raw material of a trade item is irradiated is not applicable.</Description>
				</Value>
				<Value Code="203">
					<Title>Trade item is genetically modified not applicable</Title>
					<Description>The indication that a product has not been genetically modified is not applicable.</Description>
				</Value>
				<Value Code="204">
					<Title>Trade item is irradiated not applicable</Title>
					<Description>The indication that a trade item is irradiated is not applicable.</Description>
				</Value>
				<Value Code="205">
					<Title>Size dependent pricing</Title>
					<Description>An item price may be different depending on the size.</Description>
				</Value>
				<Value Code="206">
					<Title>Size independent pricing</Title>
					<Description>An item price is independent of the size.</Description>
				</Value>
				<Value Code="207">
					<Title>Only accepted products</Title>
					<Description>Includes only details regarding accepted products.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>Special condition mutually agreed between interchanging parties.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4215" Length="3" Type="Alphanumeric">
			<Title>Transport charges payment method code</Title>
			<Description>Code specifying the payment method for transport charges.</Description>
			<Values>
				<Value Code="A">
					<Title>Account</Title>
					<Description>The charges are to be charged to an account.</Description>
				</Value>
				<Value Code="AA">
					<Title>Cash on delivery service charge paid by consignor</Title>
					<Description>An indication that the consignor is responsible for the payment of the cash on delivery service charge.</Description>
				</Value>
				<Value Code="AB">
					<Title>Cash on delivery service charge paid by consignee</Title>
					<Description>An indication that the consignee is responsible for the payment of the cash on delivery service charge.</Description>
				</Value>
				<Value Code="AC">
					<Title>Insurance costs paid by consignor</Title>
					<Description>An indication that the consignor is responsible for the payment of the insurance costs.</Description>
				</Value>
				<Value Code="AD">
					<Title>Insurance costs paid by consignee</Title>
					<Description>An indication that the consignee is responsible for the payment of the insurance costs.</Description>
				</Value>
				<Value Code="AE">
					<Title>Goods collected from store</Title>
					<Description>Customer collects goods from the store.</Description>
				</Value>
				<Value Code="CA">
					<Title>Advance collect</Title>
					<Description>The amount of freight or other charge on a shipment advanced by one transportation line to another or to the shipper, to be collected from consignee.</Description>
				</Value>
				<Value Code="CC">
					<Title>Collect</Title>
					<Description>A shipment on which freight charges will be paid by consignee.</Description>
				</Value>
				<Value Code="CF">
					<Title>Collect, freight credited to payment customer</Title>
					<Description>The freight is collect but has been paid by the shipper and will be credited to that party.</Description>
				</Value>
				<Value Code="DF">
					<Title>Defined by buyer and seller</Title>
					<Description>The payment method for transport charges have been defined by the buyer and seller.</Description>
				</Value>
				<Value Code="FO">
					<Title>FOB port of call</Title>
					<Description>Title and control of goods pass to the buyer at port of call. Responsibility for export taxes and cost of documents for overseas shipments have not been specified.</Description>
				</Value>
				<Value Code="IC">
					<Title>Information copy, no payment due</Title>
					<Description>Transaction set has been provided for information only.</Description>
				</Value>
				<Value Code="MX">
					<Title>Mixed</Title>
					<Description>The consignment is partially collect and partially prepaid.</Description>
				</Value>
				<Value Code="NC">
					<Title>Service freight, no charge</Title>
					<Description>The consignment is shipped on a service basis and there is no freight charge.</Description>
				</Value>
				<Value Code="NS">
					<Title>Not specified</Title>
					<Description>The payment method for transport charges have not been specified.</Description>
				</Value>
				<Value Code="PA">
					<Title>Advance prepaid</Title>
					<Description>Costs have been paid in advance.</Description>
				</Value>
				<Value Code="PB">
					<Title>Customer pick-up/backhaul</Title>
					<Description>Buyer's private carriage picks up the goods as a return load to the buyer's facility.</Description>
				</Value>
				<Value Code="PC">
					<Title>Prepaid but charged to customer</Title>
					<Description>shipping charges have been paid in advance of shipment but are charged back to consignee usually as line item on invoice for the purchased goods.</Description>
				</Value>
				<Value Code="PE">
					<Title>Payable elsewhere</Title>
					<Description>Place of payment not known at the begin of conveyance.</Description>
				</Value>
				<Value Code="PO">
					<Title>Prepaid only</Title>
					<Description>Payment in advance of freight and/or other charges prior to delivery of shipment at destination, usually by shipper at point of origin.</Description>
				</Value>
				<Value Code="PP">
					<Title>Prepaid (by seller)</Title>
					<Description>Seller of goods makes payment to carrier for freight charges prior to shipment.</Description>
				</Value>
				<Value Code="PU">
					<Title>Pickup</Title>
					<Description>Customer is responsible for payment of pickup charges at shipping point.</Description>
				</Value>
				<Value Code="RC">
					<Title>Return container freight paid by customer</Title>
					<Description>The freight for returning the container is paid by the customer.</Description>
				</Value>
				<Value Code="RF">
					<Title>Return container freight free</Title>
					<Description>There is no freight charge for returning the container.</Description>
				</Value>
				<Value Code="RS">
					<Title>Return container freight paid by supplier</Title>
					<Description>The freight charge for returning the container is paid by the supplier.</Description>
				</Value>
				<Value Code="TP">
					<Title>Third party pay</Title>
					<Description>A third party, someone other than buyer or seller, is identified as responsible for payment of shipping charges.</Description>
				</Value>
				<Value Code="WC">
					<Title>Weight condition</Title>
					<Description>The payment method for transport charges are due to the weight.</Description>
				</Value>
				<Value Code="WD">
					<Title>Paid by supplier</Title>
					<Description>Transport charges will be paid by the supplier.</Description>
				</Value>
				<Value Code="WE">
					<Title>Paid by buyer</Title>
					<Description>Transport charges will be paid by the buyer.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4219" Length="3" Type="Alphanumeric">
			<Title>Transport service priority code</Title>
			<Description>Code specifying the priority of a transport service.</Description>
			<Values>
				<Value Code="1">
					<Title>Express</Title>
					<Description>Express treatment (if by rail, legal express regime for parcels transport).</Description>
				</Value>
				<Value Code="2">
					<Title>High speed</Title>
					<Description>Transport under legal international rail convention (CIM) concluded between rail organizations and based on fast routing and specified timetables.</Description>
				</Value>
				<Value Code="3">
					<Title>Normal speed</Title>
					<Description>Transport under legal international rail convention (CIM) concluded between rail organizations.</Description>
				</Value>
				<Value Code="4">
					<Title>Post service</Title>
					<Description>Transport under conditions specified by UPU (Universal Postal Union) and Rail organizations (parcels transport only).</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4221" Length="3" Type="Alphanumeric">
			<Title>Discrepancy nature identification code</Title>
			<Description>Code specifying the identification used to define the nature of a discrepancy.</Description>
			<Values>
				<Value Code="AA">
					<Title>Item discontinued by wholesaler</Title>
					<Description>The wholesaler no longer offers the ordered product.</Description>
				</Value>
				<Value Code="AB">
					<Title>Item no longer produced</Title>
					<Description>The item ordered has been discontinued and is no longer in production.</Description>
				</Value>
				<Value Code="AC">
					<Title>Over-shipped</Title>
					<Description>Code indicating that there was an excess quantity of goods in a shipment relative to the order.</Description>
				</Value>
				<Value Code="AD">
					<Title>Item out of stock at manufacturer</Title>
					<Description>The item is out of stock at manufacturer.</Description>
				</Value>
				<Value Code="AE">
					<Title>Delivered but not advised</Title>
					<Description>Shipment or goods have been delivered without any advance notification of delivery.</Description>
				</Value>
				<Value Code="AF">
					<Title>Goods delivered damaged</Title>
					<Description>Part or all of the goods in a shipment were delivered damaged.</Description>
				</Value>
				<Value Code="AG">
					<Title>Delivered too late</Title>
					<Description>Delivered but at a later date than the delivery date under the agreed conditions or stipulated in the order.</Description>
				</Value>
				<Value Code="AH">
					<Title>Next higher packaging quantity</Title>
					<Description>The ordered item has been, or is to be, packed to the next higher packaging quantity.</Description>
				</Value>
				<Value Code="AN">
					<Title>Available now - no shipping schedule</Title>
					<Description>The material is available for shipment but there is no authorization for movement known.</Description>
				</Value>
				<Value Code="AS">
					<Title>Available now - scheduled to ship (date)</Title>
					<Description>The material is available for shipment and is committed for shipment/delivery at a future date.</Description>
				</Value>
				<Value Code="BK">
					<Title>Back ordered from previous order</Title>
					<Description>An order is being held as no material is available to fulfil the requirement.</Description>
				</Value>
				<Value Code="BP">
					<Title>Shipment partial - back order to follow</Title>
					<Description>A portion of the previous order is being held as open, as enough material was not available to fulfil the requirement.</Description>
				</Value>
				<Value Code="CA">
					<Title>Customer inquiry - all items</Title>
					<Description>The response includes information concerning all of the issues included in the prior inquiry.</Description>
				</Value>
				<Value Code="CC">
					<Title>Shipment complete</Title>
					<Description>The quantity dispatched fulfilled the order quantity.</Description>
				</Value>
				<Value Code="CE">
					<Title>Shipment includes extra items to meet price break</Title>
					<Description>The quantity dispatched exceeds the order quantity to accommodate a quantity of scale price model opportunity.</Description>
				</Value>
				<Value Code="CI">
					<Title>Customer inquiry - shipped items only</Title>
					<Description>The response includes information addressing only of the items dispatched that were included in the prior inquiry.</Description>
				</Value>
				<Value Code="CK">
					<Title>Cancelled from previous order</Title>
					<Description>Amount deleted from the earlier schedule.</Description>
				</Value>
				<Value Code="CM">
					<Title>Shipment complete with additional quantity</Title>
					<Description>The quantity dispatched exceeds the ordered quantity.</Description>
				</Value>
				<Value Code="CO">
					<Title>Customer inquiry - unshipped items only</Title>
					<Description>The response includes information addressing only the items that have not been dispatched, that were included in the prior inquiry.</Description>
				</Value>
				<Value Code="CP">
					<Title>Shipment partial - considered complete, no backorder</Title>
					<Description>The quantity shipped is less than the amount authorized and there is no plan to ship the remaining amount.</Description>
				</Value>
				<Value Code="CS">
					<Title>Shipment complete with substitution</Title>
					<Description>The quantity and product shipped, though not exactly matching the original order, is compliant with and fulfils the expectation.</Description>
				</Value>
				<Value Code="IC">
					<Title>Item cancelled</Title>
					<Description>The material previously ordered is no longer needed.</Description>
				</Value>
				<Value Code="IS">
					<Title>Item represents substitution from original order</Title>
					<Description>The quantity and product shipped is compliant with the expectation.</Description>
				</Value>
				<Value Code="LS">
					<Title>Last shipment (date)</Title>
					<Description>The date that the most recent material dispatch was made.</Description>
				</Value>
				<Value Code="NF">
					<Title>Not yet published</Title>
					<Description>The product requested is not publicly available at this time.</Description>
				</Value>
				<Value Code="NN">
					<Title>Not in process - no shipping schedule</Title>
					<Description>The product requested is neither available nor in process, as there is not an authorization to manufacture product.</Description>
				</Value>
				<Value Code="NS">
					<Title>Not in process - schedule to ship (date)</Title>
					<Description>The product requested is neither available nor in process. A planned dispatch date has been provided.</Description>
				</Value>
				<Value Code="OF">
					<Title>Order sent to factory for production (date)</Title>
					<Description>The product requested is not available. The schedule has been forwarded to manufacturing for inclusion on this date.</Description>
				</Value>
				<Value Code="OM">
					<Title>Item sent to factory for production (date)</Title>
					<Description>The product has been moved to the manufacturing area and scheduled for completion on the following date.</Description>
				</Value>
				<Value Code="OP">
					<Title>Out of print</Title>
					<Description>Item is no longer available.</Description>
				</Value>
				<Value Code="OS">
					<Title>Item out of stock because of strike or force majeure</Title>
					<Description>Item is not available due to strike or an unforeseeable event.</Description>
				</Value>
				<Value Code="OW">
					<Title>Item out of stock at wholesaler</Title>
					<Description>Item is not available at the distribution point.</Description>
				</Value>
				<Value Code="PA">
					<Title>Purchase order inquiry - all items</Title>
					<Description>The response includes information concerning all of the articles included in the prior inquiry that had been requested by the contact initiator.</Description>
				</Value>
				<Value Code="PD">
					<Title>Purchase order complete</Title>
					<Description>The amount fulfilling the requirements of the contract.</Description>
				</Value>
				<Value Code="PI">
					<Title>Purchase order inquiry - shipped items only</Title>
					<Description>The response includes information concerning all of the articles that were dispatched and included in the prior inquiry that had been requested by the contact initiator.</Description>
				</Value>
				<Value Code="PK">
					<Title>Packed-to-date (date)</Title>
					<Description>Quantity represents the amount processed and ready for shipment at this date.</Description>
				</Value>
				<Value Code="PN">
					<Title>In process - no shipping schedule</Title>
					<Description>This amount is being manufactured in anticipation for a possible authorization for shipment.</Description>
				</Value>
				<Value Code="PO">
					<Title>Purchase order inquiry - unshipped items only</Title>
					<Description>The response includes information concerning all of the articles that were not dispatched and included in the prior inquiry that had been requested by the contact initiator.</Description>
				</Value>
				<Value Code="PP">
					<Title>Purchase order inquiry - specific items</Title>
					<Description>The response includes information concerning a unique sub-set of the total list of articles that the contract initiator had requested information on.</Description>
				</Value>
				<Value Code="PS">
					<Title>In process - scheduled to ship (date)</Title>
					<Description>This amount is being manufactured in anticipation for a possible authorization for shipment.</Description>
				</Value>
				<Value Code="RA">
					<Title>Item rationed</Title>
					<Description>Product is restricted because of limited availability.</Description>
				</Value>
				<Value Code="SL">
					<Title>Shipped-to-date (date)</Title>
					<Description>Cumulative amount shipped through this date.</Description>
				</Value>
				<Value Code="SP">
					<Title>Scheduled for production at factory</Title>
					<Description>Product is anticipated for manufacture on this date.</Description>
				</Value>
				<Value Code="SS">
					<Title>Split shipment</Title>
					<Description>Shipment is only part of the ordered quantity.</Description>
				</Value>
				<Value Code="TW">
					<Title>Item temporary discontinued by wholesaler</Title>
					<Description>Product is, for the time being, not available from the distribution point.</Description>
				</Value>
				<Value Code="UR">
					<Title>Unsolicited report</Title>
					<Description>The product information was provided voluntarily.</Description>
				</Value>
				<Value Code="US">
					<Title>Pack to closest complete logistic packaging quantity</Title>
					<Description>Pack to the closest complete logistic packaging quantity.</Description>
				</Value>
				<Value Code="UT">
					<Title>Pack to next lower complete logistic quantity</Title>
					<Description>Pack to the next lower complete logistic packaging quantity.</Description>
				</Value>
				<Value Code="ZZZ">
					<Title>Mutually defined</Title>
					<Description>A code assigned within a code list to be used on an interim basis and as defined among trading partners until a precise code can be assigned to the code list.</Description>
				</Value>
			</Values>
		</Field>
		<Field Name="F4233" Length="3" Type="Alphanumeric">
			<Title>Marking instructions code</Title>
			<Description>Code specifying instructions for marking.</Description>
			<Values>
				<Value Code="1">
					<Title>Do not mark suppliers company name</Title>
					<Description>Packaging should not be marked with supplier's company name.</Description>
				</Value>
				<Value Code="2">
					<Title>Mark customers company name</Title>
					<Description>Packaging should be marked with customer's company name.</Description>
				</Value>
				<Value Code="3">
					<Title>Mark customers references</Title>
					<Description>Packaging should be marked with customer's references.</Description>
				</Value>
				<Value Code="4">
					<Title>Mark additionally customers article description</Title>
					<Description>Packaging should also be marked with customer's article description.</Description>
				</Value>
				<Value Code="5">
					<Title>Mark exclusively customers article description</Title>
					<Description>Packaging should be marked with customer's article description only.</Description>
				</Value>
				<Value Code="6">
					<Title>Mark packages dimensions</Title>
					<Description>Packaging should be marked with package's dimensions.</Description>
				</Value>
				<Value Code="7">
					<Title>Mark net weight</Title>
					<Description>Packaging should be marked with net weight.</Description>
				</Value>
				<Value Code="8">
					<Title>Mark gross weight</Title>
					<Description>Packaging should be marked with gross weight.</Description>
				</Value>
				<Value Code="9">
					<Title>Mark tare weight</Title>
					<Description>Packaging should be marked with tare weight.</Description>
				</Value>
				<Value Code="10">
					<Title>Mark batch number</Title>
					<Description>Packaging should be marked with batch number.</Description>
				</Value>
				<Value Code="11">
					<Title>Mark article number customer</Title>
					<Description>Packaging should be marked with customer's article number.</Description>
				</Value>
				<Value Code="12">
					<Title>Mark running number of packages</Title>
					<Description>Packaging should be marked with the running number of packages.</Description>
				</Value>
				<Value Code="13">
					<Title>Mark date of production</Title>
					<Description>Packaging should be marked with the date of production.</Description>
				</Value>
