				</Value>
				<Value Code="5">
					<Title>Request for new account only</Title>
					<Description>Request for opening new account only.</Description>
				</Value>
				<Value Code="6">
					<Title>Cancellation</Title>
					<Description>Request to cancel an existing credit cover.</Description>
				</Value>
				<Value Code="7">
					<Title>Reduction</Title>
					<Description>Request to reduce an existing credit cover.</Description>
				</Value>
				<Value Code="8">
					<Title>Prolongation of credit cover</Title>
					<Description>Request to prolong an existing credit cover.</Description>
				</Value>
