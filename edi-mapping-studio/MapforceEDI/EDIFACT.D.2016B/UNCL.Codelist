					<Description>Charges for repatriation.</Description>
				</Value>
				<Value Code="57">
					<Title>Miscellaneous charges</Title>
					<Description>Not specifically defined charges.</Description>
				</Value>
				<Value Code="58">
					<Title>Foreign exchange charges</Title>
					<Description>Charges for foreign exchange.</Description>
				</Value>
				<Value Code="59">
					<Title>Agreed debit interest charge</Title>
					<Description>Charge for agreed debit interest</Description>
				</Value>
				<Value Code="60">
					<Title>Manufacturer's consumer discount</Title>
					<Description>A discount given by the manufacturer which should be passed on to the consumer.</Description>
				</Value>
				<Value Code="61">
